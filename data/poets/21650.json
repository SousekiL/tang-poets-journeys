:"五言夜宴咏灯联句","date":"773年","excerpt":"桂酒牵诗兴，兰釭照客情。讵惭珠乘朗，不让月轮明。"},{"id":51045,"title":"五言月夜啜茶联句","date":"773年","excerpt":"泛花邀坐客，代饮引情言。醒酒宜华席，留僧想独园。"},{"id":1366780,"title":"文殊帖","date":"773年","excerpt":""}],"notes":["真卿","刘全白"]},{"place":{"zh":"平望","modern":"平望","ancient":"","spot":"","en":"Pingwang","enModern":"Pingwang","enAncient":"","enSpot":""},"lat":30.9797,"lng":120.6466,"region":"CN320509104","label":"777年","y0":777,"y1":777,"age":"69","works":0,"events":["本年出平望。"],"poems":[],"notes":[]},{"place":{"zh":"苏州","modern":"苏州","ancient":"","spot":"","en":"Suzhou","enModern":"Suzhou","enAncient":"","enSpot":""},"lat":31.3046,"lng":120.5896,"region":"CN3205","label":"777年","y0":777,"y1":777,"age":"69","works":0,"events":["经苏州。"],"poems":[],"notes":[]},{"place":{"zh":"常州","modern":"常州","ancient":"","spot":"","en":"Changzhou","enModern":"Changzhou","enAncient":"","enSpot":""},"lat":31.8168,"lng":119.9801,"region":"CN3204","label":"777年","y0":777,"y1":777,"age":"69","works":0,"events":["入毗陵。"],"poems":[],"notes":[]},{"place":{"zh":"丹阳","modern":"丹阳","ancient":"","spot":"","en":"Danyang","enModern":"Danyang","enAncient":"","enSpot":""},"lat":32.0154,"lng":119.6134,"region":"CN321181","label":"777年","y0":777,"y1":777,"age":"69","works":0,"events":["转丹阳。"],"poems":[],"notes":[]},{"place":{"zh":"南京","modern":"南京","ancient":"","spot":"","en":"Nanjing","enModern":"Nanjing","enAncient":"","enSpot":""},"lat":32.0647,"lng":118.8029,"region":"CN3201","label":"777年","y0":777,"y1":777,"age":"69","works":0,"events":["历建业，溯江西下。"],"poems":[],"notes":[]},{"place":{"zh":"九江","modern":"九江","ancient":"","spot":"","en":"Jiujiang","enModern":"Jiujiang","enAncient":"","enSpot":""},"lat":29.7113,"lng":116.008,"region":"CN3604","label":"777年","y0":777,"y1":777,"age":"69","works":0,"events":["至江州，立《祖碑》于将军庙前。"],"poems":[],"notes":[]},{"place":{"zh":"洛阳","modern":"洛阳","ancient":"","spot":"","en":"Luoyang","enModern":"Luoyang","enAncient":"","enSpot":""},"lat":34.6244,"lng":112.46,"region":"CN4103","label":"777年","y0":777,"y1":777,"age":"69","works":0,"events":["次洛阳，追立伯母殷履直夫人颜真定碑碣于万安山王宝原。"],"poems":[],"notes":[]},{"place":{"zh":"西安","modern":"西安","ancient":"","spot":"","en":"Xian","enModern":"Xian","enAncient":"","enSpot":""},"lat":34.3474,"lng":108.9463,"region":"CN6101","label":"777年八月二十五日 - 783年一月十七日","y0":777,"y1":783,"age":"69-75","works":10,"events":["此日，除刑部尚书。","本月，代宗神主将祔，上《论元皇帝祧迁状》，请迁元皇帝于西夹室，以准礼合祔。从之，作品：《论元皇帝祧迁状》。","赠和州刺史张敬因碑，立于许州墓左，作品：《晋侍中右光禄大夫本州大中正西平靖侯颜公大宗碑》。"],"poems":[],"notes":[]},{"place":{"zh":"洛阳","modern":"洛阳","ancient":"","spot":"","en":"Luoyang","enModern":"Luoyang","enAncient":"","enSpot":""},"lat":34.6244,"lng":112.46,"region":"CN4103","label":"783年","y0":783,"y1":783,"age":"75","works":0,"events":["至洛阳，东都留守兼河南尹郑叔则劝留，未允，毅然赴许州。"],"poems":[],"notes":[]},{"place":{"zh":"许昌","modern":"许昌","ancient":"","spot":"","en":"Xuchang","enModern":"Xuchang","enAncient":"","enSpot":""},"lat":34.0417,"lng":113.8588,"region":"CN411","label":"783年","y0":783,"y1":783,"age":"75","works":0,"events":["既至许州，李希烈先胁后礼，揖送于馆舍。请上表昭雪，见不从，乃诈以其名，数遣其侄颜岘与从吏表奏，以请汴州。德宗知而寝之。嗣后，大陈宴会，欲送归朝，会原汝州别驾李元平在座，颜真卿斥责之，元平惭而潜通，遂改初衷，拘之于官舍。其与诸子书，仅言严奉家庙，恤诸孤而已。"],"poems":[],"notes":[]},{"place":{"zh":"汝州","modern":"汝州","ancient":"","spot":"","en":"Ruzhou","enModern":"Ruzhou","enAncient":"","enSpot":""},"lat":34.1729,"lng":112.8509,"region":"CN410482","label":"783年三月二十日 - 784年一月","y0":783,"y1":784,"age":"75-76","works":0,"events":["此日，荆南节度使张伯仪与淮宁兵战于安州，大败之，李希烈以其旌节及所获将士首级夸示于前。愤绝良久，醒后不复与人言。"],"poems":[],"notes":[]},{"place":{"zh":"驻马店","modern":"驻马店","ancient":"","spot":"","en":"Zhumadian","enModern":"Zhumadian","enAncient":"","enSpot":""},"lat":33.0175,"lng":114.0295,"region":"CN4117","label":"785年一月五日 - 785年八月二十四日","y0":785,"y1":785,"age":"77","works":1,"events":["此日，颜真卿自汝州移囚蔡州。","此日，遇害于蔡州龙兴寺。"],"poems":[{"id":1366774,"title":"移蔡帖","date":"785年一月十九日","excerpt":""}],"notes":[]}],"stages":[{"from":1,"to":5,"title":{"zh":"苏州、西安、礼泉等地","en":"Suzhou, Xian, Liquan"},"main":"西安","y0":721,"y1":747,"events":["是年七月九日，舅氏殷践猷卒于曹州司法参军、丽正殿直学士任上。颜真卿随母殷氏南下寄居于苏州吴县令外祖殷子敬官舍。","是年颜真卿举进士第。试《梓材赋》、《武库诗》，登甲科。","本月依资授京兆醴泉县尉。","四月间，颜真卿以清白为关内道黜陟使王鉷荐举，授通直郎，陟长安县尉。","此日，奉旨送敕至东京，偕崔寓、张万顷处置洛阳令杨慎名，有恕声。"]},{"from":6,"to":7,"title":{"zh":"定边、西安","en":"Dingbian, Xian"},"main":"定边","y0":747,"y1":752,"events":["至五原郡理冤狱。","返京，奏劾金吾将军李延业曾召蕃客内宴引驾仗不报事，从而出之。"]},{"from":8,"to":9,"title":{"zh":"平原、河北","en":"Pingyuan, Hebei"},"main":"平原","y0":753,"y1":756,"events":["本年春，有诏补尚书省郎官十余人出守州牧，颜真卿为平原郡太守。六月赴任，岑参有诗为壮行。","此日，颜真卿因守城拜户部侍郎，兼本郡防御使，即以景城长史李晖为副使，李铣、贾载、沈震为判官。"]},{"from":10,"to":19,"title":{"zh":"襄阳、南阳、十堰等地","en":"Xiangyang, Nanyang, Shiyan"},"main":"宝鸡","y0":757,"y1":758,"events":["是年颜真卿由荆襄北趋行在，次襄阳，会肃宗使中官曹日昇来宣慰。因南阳为贼所围已数月，路绝不得入。颜真卿偕中官冯廷瓌为之劝说太守魏仲犀派骑护送入城，以致宣命，且返襄阳取粮，南阳因是遂久守不陷。","经邓州内乡县，草书二嫂允南夫人陈氏碑。","行次武当，授宪部尚书，有让表。","四月至凤翔。","代韦陟为御史大夫，有让表。","颜真卿扈从还京，未几忤旨，出贬同州，有谢表。"]},{"from":20,"to":22,"title":{"zh":"瑞昌、鄱阳、南京","en":"Ruichang, Poyang, Nanjing"},"main":"瑞昌","y0":759,"y1":759,"events":["元结自湖北大冶猗玗洞迁至江州瀼溪，颜真卿与元结游预，且规其苟戏。","饶州任上，游览鄱阳县荐福山，见有欧阳询所书《荐福寺碑》，乃建亭护之。","此日除升州刺史，充浙江西道节度使，兼江宁军使，辟荆南戎昱入幕。"]},{"from":23,"to":30,"title":{"zh":"武汉江夏、洛阳、西安等地","en":"Wuhanjiangxia, Luoyang, Xian"},"main":"西安","y0":760,"y1":766,"events":["道出江夏，叔丈南陵令冰寻访之，当有晤。","本年返京途经洛阳，为洛阳令李构撰文。","此日，因改元晋爵县公。","途经新政县遇故旧成都兵曹鲜于昱，因邀撰《鲜于氏离堆记》颂述其父鲜于仲通。","正书王屿铭于玄宗《登逍遥楼诗碑》后。","此月，召拜为利州刺史。因羌贼围城，不得至任，乃追赴上都。"]},{"from":31,"to":50,"title":{"zh":"荆州、九江、抚州等地","en":"Jingzhou, Jiujiang, Fuzhou"},"main":"抚州","y0":766,"y1":772,"events":["六月，至荆州，经古烈士左伯桃墓，节概交感，即题诗一首以祭之。","月初，历江州，上庐山拜晤同愔、熙怡二大师，恵彦、正义和法真诸律师，并题名于东林、西林两寺。","本月，除抚州刺史。","颜真卿因受邀游赏新修观宇，撰书颂述之，作品：《晋紫虚元君领上真司命南岳夫人魏夫人仙坛碑铭》。","抚州刺史任上，因殿中侍御史徐縯之请，为其父徐秀撰神道碑志述之，作品：《朝议大夫赠梁州都督上柱国徐府君神道碑铭》。","本月，在抚州，有南城县麻姑山仙坛记，作品：《抚州南城县麻姑山仙坛记》。"]},{"from":51,"to":57,"title":{"zh":"湖州、平望、苏州等地","en":"Huzhou, Pingwang, Suzhou"},"main":"湖州","y0":773,"y1":777,"events":["正月，至任湖州，先后以杭州富阳丞李萼为本州防御副使，前校书郎权器、前大理司直杨昱为判官，委以州事。","四月，应旧僚御史中丞崔祐甫请托，为其父撰述《崔孝公宅陋室铭》，作品：《通议大夫守太子宾客东都副留守云骑尉赠尚书左仆射博陵崔孝公宅陋室铭记》。","本年出平望。","经苏州。","入毗陵。","转丹阳。"]},{"from":58,"to":63,"title":{"zh":"洛阳、西安、许昌等地","en":"Luoyang, Xian, Xuchang"},"main":"洛阳","y0":777,"y1":785,"events":["次洛阳，追立伯母殷履直夫人颜真定碑碣于万安山王宝原。","此日，除刑部尚书。","本月，代宗神主将祔，上《论元皇帝祧迁状》，请迁元皇帝于西夹室，以准礼合祔。从之，作品：《论元皇帝祧迁状》。","赠和州刺史张敬因碑，立于许州墓左，作品：《晋侍中右光禄大夫本州大中正西平靖侯颜公大宗碑》。","至洛阳，东都留守兼河南尹郑叔则劝留，未允，毅然赴许州。","既至许州，李希烈先胁后礼，揖送于馆舍。请上表昭雪，见不从，乃诈以其名，数遣其侄颜岘与从吏表奏，以请汴州。德宗知而寝之。嗣后，大陈宴会，欲送归朝，会原汝州别驾李元平在座，颜真卿斥责之，元平惭而潜通，遂改初衷，拘之于官舍。其与诸子书，仅言严奉家庙，恤诸孤而已。"]}],"curated":false}
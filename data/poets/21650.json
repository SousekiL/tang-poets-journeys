in","enModern":"Huayin","enAncient":"","enSpot":""},"lat":34.5717,"lng":110.0987,"region":"CN610582","label":"758年十月十二日","y0":758,"y1":758,"age":"50","works":1,"events":["此日，道出华阴，携王延昌、穆宁、张澹、刘暠、郑镇同谒华岳金天王神祠。有题名。"],"poems":[{"id":1366811,"title":"华岳庙题名","date":"758年十月十二日","excerpt":""}],"notes":[]},{"place":{"zh":"洛阳","modern":"洛阳","ancient":"","spot":"","en":"Luoyang","enModern":"Luoyang","enAncient":"","enSpot":""},"lat":34.6244,"lng":112.46,"region":"CN4103","label":"758年十月二十一日","y0":758,"y1":758,"age":"50","works":1,"events":["此日，赴饶州途中，道出东京，有文祭告于伯父颜元孙墓前。"],"poems":[{"id":1366849,"title":"祭伯父豪州刺史文","date":"758年十月二十一日","excerpt":""}],"notes":[]},{"place":{"zh":"瑞昌","modern":"瑞昌","ancient":"","spot":"","en":"Ruichang","enModern":"Ruichang","enAncient":"","enSpot":""},"lat":29.6829,"lng":115.6875,"region":"CN360481","label":"759年","y0":759,"y1":759,"age":"51","works":0,"events":["元结自湖北大冶猗玗洞迁至江州瀼溪，颜真卿与元结游预，且规其苟戏。"],"poems":[],"notes":[]},{"place":{"zh":"鄱阳","modern":"鄱阳","ancient":"","spot":"","en":"Poyang","enModern":"Poyang","enAncient":"","enSpot":""},"lat":29.0113,"lng":116.71,"region":"CN361128","label":"759年","y0":759,"y1":759,"age":"51","works":0,"events":["饶州任上，游览鄱阳县荐福山，见有欧阳询所书《荐福寺碑》，乃建亭护之。"],"poems":[],"notes":[]},{"place":{"zh":"南京","modern":"南京","ancient":"","spot":"","en":"Nanjing","enModern":"Nanjing","enAncient":"","enSpot":""},"lat":32.0647,"lng":118.8029,"region":"CN3201","label":"759年六月九日 - 759年","y0":759,"y1":759,"age":"51","works":2,"events":["此日除升州刺史，充浙江西道节度使，兼江宁军使，辟荆南戎昱入幕。"],"poems":[{"id":1366746,"title":"谢浙西节度使表","date":"759年","excerpt":""},{"id":1366815,"title":"天下放生池碑铭","date":"759年","excerpt":""}],"notes":[]},{"place":{"zh":"武汉江夏","modern":"武汉江夏","ancient":"","spot":"","en":"Wuhanjiangxia","enModern":"Wuhanjiangxia","enAncient":"","enSpot":""},"lat":30.5984,"lng":114.3118,"region":"CN4201","label":"760年","y0":760,"y1":760,"age":"52","works":0,"events":["道出江夏，叔丈南陵令冰寻访之，当有晤。"],"poems":[],"notes":[]},{"place":{"zh":"洛阳","modern":"洛阳","ancient":"",
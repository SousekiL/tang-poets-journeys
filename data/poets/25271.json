。小夷犹、尊罍杖屦，踏开花事。"},{"id":103157,"title":"声声慢 和吴梦窗赋梅","date":"1238年","excerpt":"挨晴拶暖，载酒呼朋，夷犹东圃西园。绿萼枝头，两三初破轻寒。"},{"id":103315,"title":"蝶恋花 其一 吴中赵园","date":"1238年","excerpt":"野树梅花香似扑。小径穿幽，乐意天然足。"},{"id":103232,"title":"浪淘沙令 其一 和吴梦窗席上赠别","date":"1238年","excerpt":"家在敬亭东。老桧苍枫。"}],"notes":["宋·吴潜《履斋遗稿》卷二。"]},{"place":{"zh":"宣城","modern":"宣城","ancient":"","spot":"","en":"Xuancheng","enModern":"Xuancheng","enAncient":"","enSpot":""},"lat":30.9466,"lng":118.7652,"region":"CN3418","label":"1238年","y0":1238,"y1":1238,"age":"44","works":1,"events":["初夏在宣城，有词寿吴泳兄弟。"],"poems":[{"id":103102,"title":"八声甘州 其二 寿吴叔永文昌、季永侍郎","date":"1238年","excerpt":"记高冈、两凤揽朝晖，翩翻万里来。向槐厅深处，松厅紧里，却立徘徊。"}],"notes":["宋·吴潜《履斋遗稿》卷二。"]},{"place":{"zh":"镇江","modern":"镇江","ancient":"","spot":"","en":"Zhenjiang","enModern":"Zhenjiang","enAncient":"","enSpot":""},"lat":32.1957,"lng":119.4315,"region":"CN3211","label":"1238年 - 1239年","y0":1238,"y1":1239,"age":"44-45","works":12,"events":["试户部侍郎，淮东总领财赋兼知镇江府，言边储防御等十五事。"],"poems":[{"id":1309846,"title":"奏论江防五利","date":"1238年","excerpt":""},{"id":1309845,"title":"奏乞选兵救合肥","date":"嘉熙二年","excerpt":""},{"id":1309847,"title":"奏乞重濠梁招信戍守","date":"1238年","excerpt":""},{"id":1309848,"title":"奏已差军剿逐鞑贼","date":"1238年","excerpt":""},{"id":1309849,"title":"奏论仪真存亡关系江面","date":"1238年","excerpt":""},{"id":1309850,"title":"奏论本所团到流民丁壮攻劫鞑寨屡捷置制司忌嫉兴谤等","date":"1238年","excerpt":""},{"id":1309851,"title":"奏乞赏功以兴起人心","date":"1238年","excerpt":""},{"id":1309852,"title":"奏乞令东阃兼领总司以足兵食","date":"1238年","excerpt":""}],"notes":["宋·吴潜《许国公奏议》卷二。","宋·吴潜《履斋遗稿》卷二。"]},{"place":{"zh":"扬州","modern":"扬州","ancient":"","spot":"","en":"Yangzhou","enModern":"Yangzhou","enAncient":"","enSpot":""},"lat":32.3999,"lng":119.4191,"region":"CN321","label":"1239年","y0":1239,"y1":1239,"age":"45","works":1,"events":["春日，渡江与赵葵踏青于瓜洲，有词记事。"],"poems":[{"id":103313,"title":"酹江月/念奴娇 其一 瓜洲会赵南仲端明","date":"1239年","excerpt":"红尘飞骑，报元戎小队，踏青南陌。雪浪堆边呼小渡，吴楚半江分坼。"}],"notes":["宋·吴潜《履斋遗稿》卷二。"]},{"place":{"zh":"镇江","modern":"镇江","ancient":"","
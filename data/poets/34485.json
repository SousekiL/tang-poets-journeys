":"1137年九月","y0":1137,"y1":1137,"age":"49","works":0,"events":["张俊与韩世忠同造行朝。"],"poems":[],"notes":[]},{"place":{"zh":"淮安","modern":"淮安","ancient":"","spot":"","en":"Huaian","enModern":"Huaian","enAncient":"","enSpot":""},"lat":33.6163,"lng":119.0224,"region":"CN3208","label":"1137年十月 - 1137年十二月","y0":1137,"y1":1137,"age":"49","works":0,"events":["韩世忠图上淮阳形势，且欲遣偏师破伪兵，不允。"],"poems":[],"notes":[]},{"place":{"zh":"南京","modern":"南京","ancient":"","spot":"","en":"Nanjing","enModern":"Nanjing","enAncient":"","enSpot":""},"lat":32.0647,"lng":118.8029,"region":"CN3201","label":"1138年二月 - 1138年四月","y0":1138,"y1":1138,"age":"50","works":0,"events":["高宗在建康，韩世忠与岳飞同往朝。"],"poems":[],"notes":[]},{"place":{"zh":"淮安","modern":"淮安","ancient":"","spot":"","en":"Huaian","enModern":"Huaian","enAncient":"","enSpot":""},"lat":33.6163,"lng":119.0224,"region":"CN3208","label":"1138年四月","y0":1138,"y1":1138,"age":"50","works":0,"events":["与枢密副使王庶论应举兵伐金。"],"poems":[],"notes":[]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1138年九月","y0":1138,"y1":1138,"age":"50","works":0,"events":["韩世忠复入朝。"],"poems":[],"notes":[]},{"place":{"zh":"淮安","modern":"淮安","ancient":"","spot":"","en":"Huaian","enModern":"Huaian","enAncient":"","enSpot":""},"lat":33.6163,"lng":119.0224,"region":"CN3208","label":"1138年十月 - 1139年一月","y0":1138,"y1":1139,"age":"50-51","works":0,"events":["金使来计事，韩世忠闻之四上书极论其事，并乞赴行在奏事，不允。"],"poems":[],"notes":[]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1139年四月","y0":1139,"y1":1139,"age":"51","works":0,"events":["诏赐宴临安府治，并以建康永丰圩田千顷赐韩世忠，韩世忠辞不受。"],"poems":[],"notes":[]},{"place":{"zh":"淮安","modern":"淮安","ancient":"","spot":"","en":"Huaian","enModern":"Huaian","enAncient":"","enSpot":""},"lat":33.6163,"lng":119.0224,"region":"CN3208","label":"1139年五月 - 1140年二月","y0":1139,"y1":1140,"age":"51-52","works":0,"events":["韩世忠请倚阁俸给之半以助军用，不许。"],"poems":[],"notes":[]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1140年三月","y0":1140,"y1":1140,"age":"52","works":0,"events":["入朝临安，赐宴。"],"poems":[],"notes":[]},{"place":{"zh":"淮安","modern":"淮安","ancient":"","spot":"","en":"Huaian","enModern":"Huaian","enAncient":"","enSpot":""},"lat":33.6163,"lng":119.0224,"region":"CN3208","label":"1140年六月一日 - 1140年六月","y0":1140,"y1":1140,"age":"52","works":0,"events":["进太保，封英国公。"],"poems":[],"notes":[]},{"place":{"zh":"徐州","modern":"徐州","ancient":"","spot":"","en":"Xuzhou","enModern":"Xuzhou","enAncient":"","enSpot":""},"lat":34.2101,"lng":117.2923,"region":"CN3203","label":"1140年八月 - 1140年八月九日","y0":1140,"y1":1140,"age":"52","works":0,"events":["韩世忠围金人于淮阳军。"],"poems":[],"notes":[]},{"place":{"zh":"淮安","modern":"淮安","ancient":"","spot":"","en":"Huaian","enModern":"Huaian","enAncient":"","enSpot":""},"lat":33.6163,"lng":119.0224,"region":"CN3208","label":"1140年十月 - 1140年十二月二十三日","y0":1140,"y1":1140,"age":"52","works":0,"events":["李宝率众归于韩世忠。"],"poems":[],"notes":[]},{"place":{"zh":"凤阳","modern":"凤阳","ancient":"","spot":"","en":"Fengyang","enModern":"Fengyang","enAncient":"","enSpot":""},"lat":32.8718,"lng":117.5678,"region":"CN341126","label":"1141年三月七日 - 1141年三月","y0":1141,"y1":1141,"age":"53","works":0,"events":["韩世忠败金人于闻贤驿。"],"poems":[],"notes":[]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1141年四月 - 1151年八月五日","y0":1141,"y1":1151,"age":"53-63","works":2,"events":["秦桧密奏于高宗，以柘皋之捷，召韩世忠、张俊、岳飞并赴行在，论功行赏。遂罢三人兵权，韩世忠除枢密使。","作《临江仙》赠苏符，当在本年前后，姑系于此，作品：《临江仙》。","作《南乡子》赠苏符，当在本年前后，姑系于此，作品：《南乡子》。","八月五日拜太师致仕。是日薨于临安府之赐第，年六十三。"],"poems":[{"id":243650,"title":"临江仙","date":"1142年","excerpt":"冬看山林萧疏净，春来地润花浓。少年衰老与山同。"},{"id":243651,"title":"南乡子","date":"1142年","excerpt":"人有几何般。富贵荣华总是闲。"}],"notes":[]}],"stages":[{"from":1,"to":2,"title":{"zh":"银川、延安","en":"Yinchuan, Yanan"},"main":"银川","y0":1105,"y1":1118,"events":["应募为敢勇，从讨西夏于银州，有功，补一资。威名震西边。","事迹不详，活动地点姑系于延安。"]},{"from":3,"to":4,"title":{"zh":"淳安、杭州","en":"Chunan, Hangzhou"},"main":"淳安","y0":1120,"y1":1121,"events":["方腊反，韩世忠从王禀往讨。","随王禀军至杭州，与别将王渊相遇，说以智胜之术，并以所部破贼于杭州北，遂与王渊定交。"]},{"from":5,"to":11,"title":{"zh":"大名、浚县、商丘等地","en":"Daming, Junxian, Shangqiu"},"main":"商丘","y0":1125,"y1":1128,"events":["从王渊、梁方平讨捕山东河北盗贼。","从梁方平屯浚州，金人压境，方平遁，正月初二浚州破，韩世忠突围还京师。封武节大夫。","任嘉州防御使，前军统制。金人犯南京应天府，领所部击破之。","秋七月，受诏讨单州鱼台贼，平之。","以平贼功，转三官，升定国军承宣使。","御营后军中途为乱，坐降观察使。"]},{"from":12,"to":15,"title":{"zh":"嘉兴、扬州、徐州等地","en":"Jiaxing, Yangzhou, Xuzhou"},"main":"嘉兴","y0":1128,"y1":1129,"events":["六月，张俊引兵入秀州，杀前秀州守赵叔近，取露台娼周氏，御营都统制王渊以遗韩世忠。","九月，丁进叛，韩世忠军中有丁进余党百余人，尽斩于扬州竹西亭。","金人渡河，诏差韩世忠与张俊诸人分道拒战。","韩世忠与金人战，溃于沭阳，部将张遇死之。"]},{"from":16,"to":21,"title":{"zh":"杭州、苏州、嘉兴等地","en":"Hangzhou, Suzhou, Jiaxing"},"main":"杭州","y0":1129,"y1":1129,"events":["金人犯淮阳，高宗幸镇江府，从王渊请，复幸杭州，韩世忠率所部由海道赴行在。","张浚于平江决策讨乱，韩世忠领所部至平江相会。","抵秀州，称疾不行，造云梯，治器械。","韩世忠与苗翊、马柔吉战，大败之。傅等率众遁去。韩世忠等人先后入见高宗于行宫。","与苗、刘战于渔梁驿，败之，并擒刘正彦。","班师过富沙，福建提刑林杞生擒苗傅来献。遂槛苗傅赴行在。"]},{"from":22,"to":27,"title":{"zh":"南京、江阴、上海等地","en":"Nanjing, Jiangyin, Shanghai"},"main":"南京","y0":1129,"y1":1131,"events":["还至建康，斩苗、刘诸人于市。","金人渡江南下，韩世忠装所储于海舟，引之江阴。","韩世忠大治战舰于通惠镇，欲伺金人之归邀击之。","于秀州张灯高会，遂引兵趋镇江。","三月至四月，与敌相持于黄天荡凡四十八日，屡破之。","诏韩世忠以所部赴行在。"]},{"from":28,"to":29,"title":{"zh":"建瓯、福州","en":"Jianou, Fuzhou"},"main":"建瓯","y0":1132,"y1":1132,"events":["正月初四，韩世忠抵建州城下，围之。","过福州别李纲，李纲以旧赐战袍为赠。"]},{"from":30,"to":32,"title":{"zh":"宜春、南昌、长沙","en":"Yichun, Nanchang, Changsha"},"main":"宜春","y0":1132,"y1":1132,"events":["韩世忠移兵西南，讨湖南贼曹成、李宏、刘忠等。","受曹成之降于豫章江滨。","李宏闻韩世忠将至长沙，遂袭杀马友，引兵入据潭州。"]},{"from":33,"to":34,"title":{"zh":"南京、岳阳","en":"Nanjing, Yueyang"},"main":"南京","y0":1132,"y1":1132,"events":["以平闵湘盗功，迁太尉。移屯建康府，并诏以亲兵赴行在。","讨花面兽刘忠，大破之。"]},{"from":35,"to":67,"title":{"zh":"南京、杭州、镇江等地","en":"Nanjing, Hangzhou, Zhenjiang"},"main":"淮安","y0":1132,"y1":1151,"events":["高宗赐札褒奖，并诏枢密院以功状颁示内外诸将。","赴临安，奏对，论用兵事。","诏韩世忠措置江东屯田事。","诏赴行在奏事。","进开府仪同三司，充淮南东西路宣抚使，泗州置司。","与刘光世更戍，移屯镇江府。"]}],"curated":false}
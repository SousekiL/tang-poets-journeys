于杏溪愒清虚庵宿太平宫 其一","date":"1236年四月七日","excerpt":"旌旗阴里盛传呼，春梦才醒一事无。草草山肴话朋友，依然白鹤故时吾。"},{"id":252801,"title":"丙申携客自康王观东北行十里观谷帘泉 其一","date":"1236年四月十日","excerpt":"正喜昔闻今见之，泉称第一更何疑。此心好乐先为主，但见忠谋皆我欺⑴。"},{"id":253042,"title":"题归宗寺","date":"1236年四月十日","excerpt":"愦愦深源与会稽，识时惟有一羲之。千年误作能书看，谩说鹅池与墨池。"}],"notes":["二月十六日","二月四日"]},{"place":{"zh":"南京（江宁）","modern":"南京","ancient":"江宁","spot":"","en":"Jiangning (Nanjing)","enModern":"Nanjing","enAncient":"Jiangning","enSpot":""},"lat":32.0647,"lng":118.8029,"region":"CN3201","label":"1236年","y0":1236,"y1":1236,"age":"59","works":3,"events":["前往建康，于同产兄高定子处假馆暂憩。"],"poems":[],"notes":["六月"]},{"place":{"zh":"常熟","modern":"常熟","ancient":"","spot":"","en":"Changshu","enModern":"Changshu","enAncient":"","enSpot":""},"lat":31.6598,"lng":120.7589,"region":"CN320581","label":"1236年八月","y0":1236,"y1":1236,"age":"59","works":1,"events":["常熟县重修县学落成，为撰学记。"],"poems":[{"id":1297922,"title":"常熟县重修学记","date":"1236年八月","excerpt":""}],"notes":[]},{"place":{"zh":"芜湖","modern":"芜湖","ancient":"","spot":"","en":"Wuhu","enModern":"Wuhu","enAncient":"","enSpot":""},"lat":31.3588,"lng":118.4396,"region":"CN3402","label":"1236年 - 1236年十一月","y0":1236,"y1":1236,"age":"59","works":2,"events":["芜湖舟中，与门人税与权等论学，讲《礼记》一节。"],"poems":[{"id":1298115,"title":"故知辰州大夫张君墓志铭","date":"1236年十月","excerpt":""},{"id":1298118,"title":"蒋恭人墓志铭","date":"端平三年十月","excerpt":""}],"notes":[]},{"place":{"zh":"常州（武进）","modern":"常州","ancient":"武进","spot":"","en":"Wujin (Changzhou)","enModern":"Changzhou","enAncient":"Wujin","enSpot":""},"lat":31.8168,"lng":119.9801,"region":"CN3204","label":"1237年一月十一日","y0":1237,"y1":1237,"age":"60","works":1,"events":["行至毗陵，得知福州之旨，遂上书请辞。"],"poems":[{"id":1297262,"title":"辞免知福州福建路安抚使奏状","date":"1237年一月十一日","excerpt":""}],"notes":["正月"]},{"place":{"zh":"苏州（长洲）","modern":"苏州","ancient":"长洲","spot":"","en":"Zhangzhou (Suzhou)","enModern":"Suzhou","enAncient":"Zhangzhou","enSpot":""},"lat":31.3046,"lng":120.5896,"region":"CN3205","label":"1237年二月十五日 - 1237年三月十八日","y0":1237,"y1":1237,"age":"60","works":2,"events":["到达姑苏，再上书请辞知福州事。","拱手而逝。"],"poems":[{"id":1297263,"title":"再辞免知福州劄子","date":"1237年二月十五日","excerpt":""},{"id":1297264,"title":"乞致仕劄子","date":"1237年二月","excerpt":""}],"notes":["二月十五日"]}],"stages":[{"from":1,"to":8,"title":{"zh":"杭州、成都、眉山等地","en":"Hangzhou, Chengdu, Meishan"},"main":"成都","y0":1199,"y1":1203,"events":["与韩甲、乐新同赴京应进士试；路遇章相士，称其可中高第。","以佥书剑南西川节度判官试西川幕府，到成都就任。","到眉山校士，得程掌、史守道等人。","成都人钱安国葬其亲，来请挽诔。","与杨熹之女成婚，亲迎于资州；期间登醮坛山，题诗星斗阁。","夏，召为国子正，未及行，女璧海生，妻杨氏产后感疾卒，遂解职，携女护杨氏之丧回蒲江。"]},{"from":9,"to":11,"title":{"zh":"合肥、杭州、南京","en":"Hefei, Hangzhou, Nanjing"},"main":"合肥","y0":1203,"y1":1206,"events":["过淮西，识邓友龙。","冬，以国子正造朝，获接四方之士。","过建康，拜谒叶适，以斋铭相请，叶氏为撰《师立斋铭》。"]},{"from":12,"to":13,"title":{"zh":"荆州、奉节","en":"Jingzhou, Fengjie"},"main":"荆州","y0":1207,"y1":1207,"events":["过江陵，至吴猎幕府，受邀分视守备，滞留数日；其时，得妻舅赵昱手书。","行至蜀口，闻吴曦叛，欲返回荆州，适逢赵景鲁东归，相约同行。景鲁子岩叟以二苏真迹相示，为作跋语。"]},{"from":14,"to":16,"title":{"zh":"武陵、荆州、奉节","en":"Wuling, Jingzhou, Fengjie"},"main":"武陵","y0":1207,"y1":1207,"events":["友人章燮奉诏赴知绍兴任，为之饯行，作诗相送。","召赴行在。","临近瞿塘，得岳父杨熹手书，知友人赵昱已卒，为文哭之。"]},{"from":17,"to":52,"title":{"zh":"广安、蒲江、成都等地","en":"Guangan, Pujiang, Chengdu"},"main":"蒲江","y0":1207,"y1":1222,"events":["与广安守阎某唱和。","回到蒲江老家。","岳父杜益卒。次日闻讯，遂携妻杜氏至成都奔丧。","冬，友人宋德之寄赠《乙丑送行诗》墨本，题其后。","春，过丹棱，史伯学之子史之椅、史之樟携文造访。","春，友人王表民造访，以其母黎氏墓志铭为请。"]},{"from":53,"to":54,"title":{"zh":"万州、奉节","en":"Wanzhou, Fengjie"},"main":"万州","y0":1222,"y1":1222,"events":["过万州，与潘叔豹游，登鲁池，观荷花、荔枝。","过夔州，友人丁黼、王观之等置酒饯行，即席唱和，赋诗言谢。"]},{"from":55,"to":56,"title":{"zh":"沙市、武汉","en":"Shashi, Wuhan"},"main":"沙市","y0":1222,"y1":1222,"events":["在江陵，得虞刚简书，知刘光祖病，旋卒，撰文哭之。","见李埴，时李埴作吞云楼成，索诗，遂和韵答之。"]},{"from":57,"to":58,"title":{"zh":"九江、贵池","en":"Jiujiang, Guichi"},"main":"九江","y0":1222,"y1":1222,"events":["至九江，舟次琵琶亭，张元龙以诗求见，次韵和之。","行至池州，逢友人杨约生日，赋诗三首庆贺。"]},{"from":59,"to":66,"title":{"zh":"杭州、绍兴、湖州等地","en":"Hangzhou, Shaoxing, Huzhou"},"main":"杭州","y0":1222,"y1":1225,"events":["抵京。于友人杜安石处见杜才叔所作《和归去来辞》，为作跋。","被命赴会稽朝陵，事毕，太守邀宴；作诗记所历。","回临安复命。","过湖州，与友人杨泰之相遇。","过锡山，至蒋重珍家，为蒋母墓志铭及家传作跋。","过武进，为友人卫湜所著《礼记集说》作序。"]},{"from":67,"to":73,"title":{"zh":"九江、长沙、衡山等地","en":"Jiujiang, Changsha, Hengshan"},"main":"九江","y0":1226,"y1":1231,"events":["春，行至九江。","春，过潭州，安癸仲之子安显孙亲迎，寓城中数日，为长女办聘。之后，携长子魏近思、友人李肩吾赴靖。","渡湘水，至衡山，与友人张忠恕相见，相与论学于岳麓精舍，并止宿道林僧舍。","过绥宁，见戴令翿、戴立本父子。","夏，抵靖州界，值友人李肩吾生日，作诗寿之。","秋，离靖返乡，过五溪，张献子派人以张忠恕墓志铭相请，仅为撰圹志。"]},{"from":74,"to":78,"title":{"zh":"荆州、宜昌、屈原等地","en":"Jingzhou, Yichang, Quyuan"},"main":"荆州","y0":1231,"y1":1231,"events":["过沙市，胡嚞以其父胡挺墓志铭相请，因旅途匆匆，未果作。","过峡州，题诗三游洞。","友人李□出示魏了翁跋其岳父杨熹诗，次韵。","过归州，谒屈原庙，有诗。","临近夔州，友人施霆享赋诗相迎，魏了翁有诗唱和。"]},{"from":79,"to":90,"title":{"zh":"绵阳、成都、蒲江等地","en":"Mianyang, Chengdu, Pujiang"},"main":"蒲江","y0":1232,"y1":1235,"events":["至绵州，与同产兄高定子、高稼相见。高定子筑棣萼堂，三兄弟饮酒赋诗其中，一时传为美谈。","过成都，至岳父家，吊唁岳母及妻弟媳，居留数日。","还至蒲江家中。","过汉嘉，友人李骏置酒迎送。","过叙州，会友人冯邦佐，适逢叙州诸葛武侯忠灵庙落成，冯氏以祠记相托；并应冯氏之请，为撰《致堂胡先生斐然集序》。","于南定楼宴请同官，有诗。"]},{"from":91,"to":100,"title":{"zh":"杭州、浙江、嘉兴等地","en":"Hangzhou, Zhejiang, Jiaxing"},"main":"杭州","y0":1235,"y1":1236,"events":["抵京，除授礼部尚书，连上五疏论国事。","率兵出临安，宰执送行。吴泳等有词。","兵马抵嘉兴。","1235年十二月二十二日，抵平江府。其时得孟珙申状，知蒙军十一月攻襄之事。","1235年十二月二十四日，在无锡，见尤焴与其弟家信，知德安叛卒之事。","1235年十二月二十八日，至镇江，赵葵自扬州过江来相见，魏了翁设宴，并约吴渊同席。"]},{"from":101,"to":103,"title":{"zh":"南京、常熟、芜湖","en":"Nanjing, Changshu, Wuhu"},"main":"南京","y0":1236,"y1":1236,"events":["前往建康，于同产兄高定子处假馆暂憩。","常熟县重修县学落成，为撰学记。","芜湖舟中，与门人税与权等论学，讲《礼记》一节。"]},{"from":104,"to":105,"title":{"zh":"常州、苏州","en":"Changzhou, Suzhou"},"main":"常州","y0":1237,"y1":1237,"events":["行至毗陵，得知福州之旨，遂上书请辞。","到达姑苏，再上书请辞知福州事。","拱手而逝。"]}],"curated":false}
186年","excerpt":"方见繁红绣小园，已随流水泛前村。人于醽醁真无分，雨共鞦韆似有冤。"}],"notes":[]},{"place":{"zh":"德安","modern":"德安","ancient":"","spot":"","en":"Dean","enModern":"Dean","enAncient":"","enSpot":""},"lat":29.3192,"lng":115.7626,"region":"CN360426","label":"1187年","y0":1187,"y1":1187,"age":"48","works":0,"events":["在家闲居。"],"poems":[],"notes":[]},{"place":{"zh":"定海","modern":"定海","ancient":"","spot":"","en":"Dinghai","enModern":"Dinghai","enAncient":"","enSpot":""},"lat":30.0255,"lng":122.1134,"region":"CN330902","label":"1188年 - 1190年","y0":1188,"y1":1190,"age":"49-51","works":10,"events":["知昌国县到任。"],"poems":[{"id":71463,"title":"劝农题吉祥寺一首","date":"1189年","excerpt":"傍石寻幽径，穷原得梵城。潮声四面合，山色一团清。"},{"id":71528,"title":"宿祖印寺一首","date":"1189年","excerpt":"下马杉松石径幽，暗泉一带抱山流。长廊隐隐丹青古，香雾濛濛日夜浮。"},{"id":71504,"title":"昌国偶成一首","date":"1189年","excerpt":"诸邑皆山可夜驰，海中昌国力难施。风潮阻渡由天地，期会申严限日时。"},{"id":71535,"title":"普陀山观音岩祈雨一首","date":"1189年","excerpt":"南风不为雨，躬即宝陀求。地势到此尽，天河相接流。"},{"id":71431,"title":"留别昌国五首 其一","date":"1190年","excerpt":"妄意弦歌学子游，迄无三异比中牟。丁宁今夜东风雨，添起潮头急去休。"},{"id":71572,"title":"昌国秩满次陈纠祖行韵一首","date":"1190年","excerpt":"昔之督邮逐彭泽，今之督邮眷昌国。不令自赋归去来，更以新诗祖行色。"}],"notes":["自注：出《十洲记》"]},{"place":{"zh":"奉化雪窦山","modern":"奉化雪窦山","ancient":"","spot":"","en":"Fenghuaxuedoushan","enModern":"Fenghuaxuedoushan","enAncient":"","enSpot":""},"lat":29.661,"lng":121.4134,"region":"CN330283","label":"1190年","y0":1190,"y1":1190,"age":"51","works":1,"events":["游四明雪窦山瀑布，有诗纪之。"],"poems":[{"id":71532,"title":"雪窦瀑布一首","date":"1190年","excerpt":"碧空无雨忽潺潺，此水何人激在山。塔现玉光依石侧，柱因冰冻沥檐间。"}],"notes":[]},{"place":{"zh":"苏州","modern":"苏州","ancient":"","spot":"","en":"Suzhou","enModern":"Suzhou","enAncient":"","enSpot":""},"lat":31.3046,"lng":120.5896,"region":"CN3205","label":"1191年","y0":1191,"y1":1191,"age":"52","works":17,"events":["秋，北上返乡途中游太湖洞庭山。"],"poems":[{"id":71508,"title":"洞庭题咏十一首 其四 宿灵佑观谢沈君","date":"1191年","excerpt":"凤翅出沧溟⑴，扁舟过洞庭。银河万顷白，螺髻两山青。"},{"id":71409,"title":"洞庭留别","date":"1191年","excerpt":"岭松岁古欲无根，水石秋深未有痕。无限好山将不去，又依帆影过前村。"},{"id":71436,"title":"寄范石湖五首 其一","date":"1191年","excerpt":"殊庭诏禄佚忠勤，秘殿升班宠旧勋。试向午桥诸第问，有谁别墅得奎文。"}],"notes":["并引","坛有朝真松"]},{"place":{"zh":"德安","modern":"德安","ancient":"","spot":"","en":"Dean","enModern":"Dean","enAncient":"","enSpot":""},"lat":29.3192,"lng":115.7626,"region":"CN360426","label":"1192年 - 1195年","y0":1192,"y1":1195,"age":"53-56","works":0,"events":["任职不详，或在家闲居。"],"poems":[],"notes":[]},{"place":{"zh":"吉安","modern":"吉安","ancient":"","spot":"","en":"Jian","enModern":"Jian","enAncient":"","enSpot":""},"lat":27.1198,"lng":115.0003,"region":"CN3608","label":"1196年十一月","y0":1196,"y1":1196,"age":"57","works":3,"events":["冬，因公干过庐陵，拜见周必大，有诗。"],"poems":[{"id":71498,"title":"投周益公三首 其一","date":"1196年十一月","excerpt":"洛中九老后，林下一人闲。藓篆易钟鼎，泉声先佩环。"}],"notes":["并引"]},{"place":{"zh":"万安黄公滩","modern":"万安黄公滩","ancient":"","spot":"","en":"Wananhuanggongtan","enModern":"Wananhuanggongtan","enAncient":"","enSpot":""},"lat":26.4639,"lng":114.7927,"region":"CN360828","label":"1196年十一月十四日","y0":1196,"y1":1196,"age":"57","works":1,"events":["过赣江，经黄公滩，有诗纪之。"],"poems":[{"id":71580,"title":"黄公滩一首","date":"1196年十一月十四日","excerpt":"水溯安流舟不难，人心自畏石头顽。黄公误听作惶恐，玉局先生盖谓滩。"}],"notes":[]},{"place":{"zh":"凤阳","modern":"凤阳","ancient":"","spot":"","en":"Fengyang","enModern":"Fengyang","enAncient":"","enSpot":""},"lat":32.8718,"lng":117.5678,"region":"CN341126","label":"1197年 - 1199年","y0":1197,"y1":1199,"age":"58-60","works":3,"events":["赴任濠州知州。"],"poems":[{"id":71582,"title":"瑞麦谣一首","date":"1198年四月","excerpt":"稗草化稻疑谈空，我有异麦真年丰。三歧鼎足如争雄，两歧对秀攒眉峰。"},{"id":71562,"title":"江上一首","date":"1198年","excerpt":"虏马秋来健，吴侬水底藏。荻花江面冷，草色岸头荒。"},{"id":71529,"title":"宿淮南岸一首","date":"1198年","excerpt":"一昔淮南岸，两旬扬子江。山川总极目，天地偶为邦。"}],"notes":[]},{"place":{"zh":"抚州","modern":"抚州","ancient":"","spot":"","en":"Fuzhou","enModern":"Fuzhou","enAncient":"","enSpot":""},"lat":27.9536,"lng":116.3646,"region":"CN361","label":"1199年 - 1204年","y0":1199,"y1":1204,"age":"60-65","works":0,"events":["到知抚州任上。"],"poems":[],"notes":[]},{"place":{"zh":"九江庐山
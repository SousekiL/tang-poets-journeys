85,"title":"见梅有感一首","date":"1172年十月","excerpt":"十月潇湘尽放梅，南枝仍避北枝开。客愁无奈春消息，肠断江南驿使来。"}],"notes":[]},{"place":{"zh":"祁阳","modern":"祁阳","ancient":"","spot":"","en":"Qiyang","enModern":"Qiyang","enAncient":"","enSpot":""},"lat":26.5865,"lng":111.8466,"region":"CN431121","label":"1173年二月","y0":1173,"y1":1173,"age":"34","works":2,"events":["在永州祁阳与范成大相会。"],"poems":[{"id":71520,"title":"读浯溪碑一首","date":"1173年二月","excerpt":"鲁恶吴同姓，唐嫌肃抚军。仲尼讳不语，元结谤于文。"},{"id":71446,"title":"题淡岩一首","date":"1173年二月","excerpt":"浯溪已借元碑显，愚谷还因柳序称。独有淡岩人未识，故烦山谷到零陵。"}],"notes":[]},{"place":{"zh":"永州","modern":"永州","ancient":"","spot":"","en":"Yongzhou","enModern":"Yongzhou","enAncient":"","enSpot":""},"lat":26.4266,"lng":111.6187,"region":"CN4311","label":"1173年","y0":1173,"y1":1173,"age":"34","works":6,"events":["在永州任上，代提举湖南常平胡仰作诗。"],"poems":[{"id":71554,"title":"代胡仓进圣德惠民诗一首","date":"1173年","excerpt":"平楚皆膏壤，成汤忽旱年。人知圣虑切，恩遣使臣宣。"},{"id":71393,"title":"竹斋二首 其一","date":"1173年","excerpt":"一围寒绿锁城闉，中有茅檐更绝尘。千户封侯千亩是，可怜燕颔虎头人。"},{"id":71460,"title":"广中南华寺一首","date":"1173年","excerpt":"一水透南粤，高人忆老卢。如何拈不起，只为本来无。"},{"id":71459,"title":"广中二首 其一","date":"1173年","excerpt":"黑金不肯化青金，奉命来催胆水淋。山骨旧疑天凿透，沟流唯待雨来深。"}],"notes":["自注：常平。","自注：分路招籴，广米自灵渠出。"]},{"place":{"zh":"德安","modern":"德安","ancient":"","spot":"","en":"Dean","enModern":"Dean","enAncient":"","enSpot":""},"lat":29.3192,"lng":115.7626,"region":"CN360426","label":"1174年 - 1178年","y0":1174,"y1":1178,"age":"35-39","works":0,"events":["任何职不详，或在乡闲居。"],"poems":[],"notes":[]},{"place":{"zh":"宜丰","modern":"宜丰","ancient":"","spot":"","en":"Yifeng","enModern":"Yifeng","enAncient":"","enSpot":""},"lat":28.3997,"lng":114.8102,"region":"CN360924","label":"1179年 - 1180年六月","y0":1179,"y1":1180,"age":"40-41","works":2,"events":["以宣教郎知新昌县。"],"poems":[{"id":71581,"title":"新昌书座右屏一首","date":"1179年","excerpt":"私罪不可有，公罪不可无。退作陶渊明，进学何易于。"},{"id":71548,"title":"题靖节先生祠一首","date":"1180年六月","excerpt":"先生新布政，谁遣小儿来。尔面何须识，其心端可猜。"}],"notes":[]},{"place":{"zh":"星子落星寺","modern":"星子落星寺","ancient":"","spot":"
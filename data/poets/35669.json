冲佑观。重修《仪礼经传》续卷，置局于寓舍之书室及城东张氏南园，四方生徒会聚讲学。"],"poems":[],"notes":[]},{"place":{"zh":"闽侯","modern":"闽侯","ancient":"","spot":"","en":"Minhou","enModern":"Minhou","enAncient":"","enSpot":""},"lat":26.1562,"lng":119.1379,"region":"CN350121","label":"1219年五月 - 1219年十二月","y0":1219,"y1":1219,"age":"68","works":0,"events":["新作书楼法云寓居之右，牓曰云谷，以示毋忘文公之训。"],"poems":[],"notes":[]},{"place":{"zh":"福州","modern":"福州","ancient":"","spot":"","en":"Fuzhou","enModern":"Fuzhou","enAncient":"","enSpot":""},"lat":26.0804,"lng":119.3029,"region":"CN3501","label":"1220年","y0":1220,"y1":1220,"age":"69","works":0,"events":["黄榦躬相丘宅于北山匏犠原，结庐其旁，牓曰高峰书院。诸生从学于山间。"],"poems":[],"notes":[]},{"place":{"zh":"闽侯","modern":"闽侯","ancient":"","spot":"","en":"Minhou","enModern":"Minhou","enAncient":"","enSpot":""},"lat":26.1562,"lng":119.1379,"region":"CN350121","label":"1220年三月 - 1220年","y0":1220,"y1":1220,"age":"69","works":0,"events":["门人陈仍以古冠礼冠其长子，请于黄榦。为之正其仪法，且莅其事。"],"poems":[],"notes":[]},{"place":{"zh":"福州补山","modern":"福州补山","ancient":"","spot":"","en":"Fuzhoubushan","enModern":"Fuzhoubushan","enAncient":"","enSpot":""},"lat":26.0804,"lng":119.3029,"region":"CN3501","label":"1220年五月","y0":1220,"y1":1220,"age":"69","works":0,"events":["门人赵师恕率乡党朋友习乡饮酒仪于补山，黄榦以上僎临之。"],"poems":[],"notes":[]},{"place":{"zh":"闽侯","modern":"闽侯","ancient":"","spot":"","en":"Minhou","enModern":"Minhou","enAncient":"","enSpot":""},"lat":26.1562,"lng":119.1379,"region":"CN350121","label":"1220年八月 - 1221年三月","y0":1220,"y1":1221,"age":"69-70","works":1,"events":["转奉议郎。","终于所居之正寝。"],"poems":[],"notes":[]}],"stages":[{"from":1,"to":2,"title":{"zh":"永春、闽侯","en":"Yongchun, Minhou"},"main":"永春","y0":1157,"y1":1173,"events":["御史公（父黄瑀）为永春宰，黄榦从行。","御史府君既葬，遂从学于乡先生淡斋李公深卿。"]},{"from":3,"to":8,"title":{"zh":"桃源、吉安、建瓯等地","en":"Taoyuan, Jian, Jianou"},"main":"建瓯","y0":1174,"y1":1178,"events":["于桃源侍母，应湖北漕举。","仲兄官于吉州，黄榦从行，因识清江刘公子澄，刘公一见奇之，以书进于朱文公之门。","以岁除之名，登舟如建安。","见朱文公于五夫，馆于屏山潭溪之侧，文公有传授付畀之意。","是岁自建安如金华，从学于东莱吕先生，逾年始归。","不详。"]},{"from":9,"to":10,"title":{"zh":"九江庐山白鹿洞、闽侯","en":"Jiujianglushanbailudong, Minhou"},"main":"九江庐山白鹿洞","y0":1179,"y1":1180,"events":["文公守南康，黄榦从行，因游白鹿，历观庐阜之阳。","伯兄检法府君卒，黄榦奔丧还家。"]},{"from":11,"to":25,"title":{"zh":"九江庐山、建瓯、杭州等地","en":"Jiujianglushan, Jianou, Hangzhou"},"main":"建瓯","y0":1181,"y1":1191,"events":["文公代归，黄榦从行，同游庐阜之阴。","朋友各散，黄榦侍文公南归。","文公被召至京，黄榦从行。","文公以仲女归于黄榦，馆于紫阳书堂。","黄榦留建安，侍文公左右。始识包君定于武夷山下。","仲兄奉太夫人官于沙邑，黄榦自建安往来省侍。"]},{"from":26,"to":30,"title":{"zh":"常州、武夷山、闽侯等地","en":"Changzhou, Wuyishan, Minhou"},"main":"闽侯","y0":1191,"y1":1193,"events":["是年中间尝如清潭。","黄榦从文公至武夷。","寻复归乡。","自三山如建安。","自建安归三山所居。钟山赵氏馆黄榦以为诸子师。"]},{"from":31,"to":35,"title":{"zh":"新余九龙山；象山、建瓯、闽侯等地","en":"Xinyujiulongshan；xiangshan, Jianou, Minhou"},"main":"建瓯","y0":1193,"y1":1194,"events":["泛舟九龙山，哭故人之丧。因访郑文遹成叔于象山下。","如建安。","归三山。","黄榦将如三衢省母，道建安。","文公为湖南帅，黄榦从行。"]},{"from":36,"to":52,"title":{"zh":"杭州、衢江、建瓯等地","en":"Hangzhou, Qujiang, Jianou"},"main":"闽侯","y0":1194,"y1":1202,"events":["时赵忠定公为丞相，召文公为侍讲，黄榦从至京师。","韩侂胄用事，忠定公及文公俱罢。黄榦从行出京，留于三衢。","授迪功郎、监台州户部瞻军酒库。在行都与吕公子约、赵公子钦交游，因以《礼书图证》相与讲明之。","赵丞相谪永州，文公奉祠居家。黄榦自京师还，留文公之侧。","自建安归三山，诸生从学于城南。从文公编辑《礼书》。","自三山复如文公之侧。"]},{"from":53,"to":56,"title":{"zh":"闽侯、衢州、建阳等地","en":"Minhou, Quzhou, Jianyang"},"main":"闽侯","y0":1202,"y1":1206,"events":["得监嘉兴府崇德县石门酒库，待次于家。","丧乐安君于桃枝山。遂会朋友于城南乌石山寺，续后修《仪礼》，以成文公之志。","遂归考亭。子範生。","赴石门酒库，十二月到任。始至石门，有通漕使及幕属、知州、县官启，《申漕司公事状》三通。"]},{"from":57,"to":59,"title":{"zh":"荆州、湖北","en":"Jingzhou, Hubei"},"main":"荆州","y0":1206,"y1":1206,"events":["到任。","檄措置极边关隘总领、宣抚二司，就委提点八关，经历光、黄、德安、信阳四郡之间。","虏攻枣阳，破随州。帅司檄黄榦归，在途绝粮成疾。未几，吴公改除京西湖北宣抚，黄榦随司解罢。"]},{"from":60,"to":67,"title":{"zh":"建瓯、抚州、南昌等地","en":"Jianou, Fuzhou, Nanchang"},"main":"抚州","y0":1207,"y1":1213,"events":["宇文公绍节代吴公为帅，再辟黄榦入幕。复授湖北帅属，力辞。别与干官差遣，又辞。丐祠未报，径归建安。","到任。","帅檄禀议，自临川如豫章。","时溪峒盗起，调发益急。黄榦为郡治酒政，为×司招官兵，皆赖其用。","自江右如行都。","循从政郎，授南剑州剑浦县令，待次考亭。"]},{"from":68,"to":71,"title":{"zh":"安丰、和县、南京","en":"Anfeng, Hexian, Nanjing"},"main":"安丰","y0":1213,"y1":1214,"events":["到任。未几为郡将诬陷，黄榦引疾请归，不许。","自安丰如历阳鞠狱。","特添差通判建康府事，仍釐务。谏官为辨安丰之谤，郡将坐黜。正言倪公千里论之。自安丰巡历淮垠守御要害。道经仪真，与李公道传胥会。","到任，制使檄权太平州，未几还任。"]},{"from":72,"to":75,"title":{"zh":"武汉、九江庐山、建阳等地","en":"Wuhan, Jiujianglushan, Jianyang"},"main":"武汉","y0":1214,"y1":1217,"events":["到任，增兵积粟，为城筑计。","自汉阳道庐山之下以归。","至考亭所居，诸生从学于文公竹林精舍，始草文公行状。","自考亭还三山旧居。"]},{"from":76,"to":91,"title":{"zh":"安庆、潢川、南京等地","en":"Anqing, Huangchuan, Nanjing"},"main":"闽侯","y0":1217,"y1":1221,"events":["到任。会虏攻破光州，沿边多警，漕司欲发安庆民连粮，黄榦拒之而止。于是竭力经营安庆城池，大为战守之备。","虏犯黄州、砂窝诸关。诏以黄榦提督五关守御，督战光州，节制江、池三州戍兵，光、黄、蕲、安庆四州民兵。","时王师败绩泗水，制帅请令黄榦赴司禀议。自龙舒来金陵，从制帅劳军维杨，寻以所议不合引归。朝命知和州，仍赴司议事，黄榦辞免和州，遵禀议事。","依旧知安庆府，兼制置司参议官。","召赴行在奏事，屡辞不就。","由池阳如江州。"]}],"curated":false}
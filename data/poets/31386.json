"49","works":1,"events":["是秋，起知衢州，有《谢知衢州表》。"],"poems":[{"id":1281808,"title":"谢知衢州表","date":"1188年","excerpt":""}],"notes":[]},{"place":{"zh":"绍兴（会稽）秦望山、大禹陵","modern":"绍兴","ancient":"会稽","spot":"秦望山、大禹陵","en":"Shaoxing (Huiji)"},"lat":30.0365,"lng":120.5867,"region":"CN3306","label":"1189年","y0":1189,"y1":1189,"age":"50","works":0,"events":["正月十八日以朝请大夫到任；是春，登秦望，探禹穴。"],"poems":[],"notes":[]},{"place":{"zh":"苏州（吴县）","modern":"苏州","ancient":"吴县","spot":"","en":"Suzhou (Wuxian)"},"lat":31.3046,"lng":120.5896,"region":"CN3205","label":"1189年","y0":1189,"y1":1189,"age":"50","works":0,"events":["七月十三日改任浙西提刑，二十八日到任。"],"poems":[{"id":200864,"title":"喜雪","date":"1189年","excerpt":"玉龙方急战寒声，满阵江风雪作茵。准拟丰年须造物，编排佳境付诗人。"},{"id":200882,"title":"腊雪二首 其一","date":"1189年","excerpt":"岁事无多腊近残，谢渠飞屑破天悭。褥祠空愧兼旬力，造物惟消一夜间。"},{"id":200668,"title":"立春日雪","date":"1189年","excerpt":"料理风光兴未残，老无诗手一何悭。新传䌽胜排枝上，趁得冰花落鬓间。"}],"notes":["以上《东塘集》卷四","自注：去声。"]},{"place":{"zh":"镇江（丹徒）金山、焦山","modern":"镇江","ancient":"丹徒","spot":"金山、焦山","en":"Zhenjiang (Dantu)"},"lat":32.1957,"lng":119.4315,"region":"CN3211","label":"1189年","y0":1189,"y1":1189,"age":"50","works":1,"events":["赴镇江游金山、焦山，有诗。"],"poems":[{"id":200875,"title":"游金焦二山至汲江亭用前韵","date":"1189年","excerpt":"江山万里忆徐州，十月迎风度小舟。极目不知天外景，乱云遥接水中丘。"}],"notes":[]},{"place":{"zh":"苏州（吴县）","modern":"苏州","ancient":"吴县","spot":"","en":"Suzhou (Wuxian)"},"lat":31.3046,"lng":120.5896,"region":"CN3205","label":"1189年 - 1190年","y0":1189,"y1":1190,"age":"50-51","works":14,"events":["是冬，与范成大唱和有诗。"],"poems":[{"id":200760,"title":"和赵成子提干喜雨韵 其一","date":"1190年","excerpt":"一天膏泽下民区，此意拳拳敢自居。欲写吴歌誇岁好，苦无杰语愧才虚。"},{"id":200757,"title":"和施德远双莲韵二首 其一","date":"1190年","excerpt":"老向尘埃度岁华，不堪才拙负州家。天公著意成丰岁，地产无心出异葩。"},{"id":200725,"title":"麦秀三岐","date":"1190年","excerpt":"用过其才愧弗宜，但于牧养要张施。未应拙政才兼月，森出来牟过两岐。"},{"id":200497,"title":"和范石湖咏双莲三首 其一","date":"1190年","excerpt":"江妃瑟里恨沈沈，万点红边意转深。拥出三千歌舞罢，翠绡萦得两同心。"},{"id":200606,"title":"题尤提举惠双莲二首 其一","date":"1190年","excerpt":"十年踪迹落修门，剩忆西湖菡萏风。今日江城秋浦上，舞绡依约旧相逢。"},{"id":201018,"title":"被旨许浦阅舟归","date":"1190年","excerpt":"皇家百万兵，一一拱行阙。肦恩劳军士，有诏涓良月。"},{"id":200800,"title":"诚斋指檐头雪为诗材二首 其一","date":"1190年","excerpt":"春风著意向春宵，巧作冰澌细细飘。正好千门竞灯火，故添万瓦灿琼瑶。"}],"notes":["以上《东塘集》卷四","自注：去声。"]},{"place":{"zh":"常熟","modern":"常熟","ancient":"","spot":"","en":"Changshu"},"lat":31.6598,"lng":120.7589,"region":"CN320581","label":"1190年","y0":1190,"y1":1190,"age":"51","works":6,"events":["是冬，被旨往许浦阅兵，有诗。"],"poems":[{"id":200566,"title":"常熟敲冰行舟三首 其一","date":"1190年","excerpt":"岸头猛作敲冰势，船下俄闻戛玉声。寸进未应容退尺，要于此地卜平生。"},{"id":200561,"title":"被旨许浦蒐兵道中冻合舍舟行陆二首 其一","date":"1190年","excerpt":"已办轻舟著脚登，笑渠河伯故阴凝。征车政欲周阡陌，赢得天教一夜冰。"},{"id":200687,"title":"自常熟敲冰行舟半日一夜仅十里","date":"1190年","excerpt":"到晓才通十里冰，颇怜黄帽叹征行。半篙不下风霜夜，一日之间水陆程。"},{"id":200848,"title":"被旨往许浦阅兵风雨中舟过梅里","date":"1190年","excerpt":"浓云障日卧前山，已觉林深寸步难。风雨于人本无意，筋骸如我不禁寒。"}],"notes":[]},{"place":{"zh":"苏州（吴县）","modern":"苏州","ancient":"吴县","spot":"","en":"Suzhou (Wuxian)"},"lat":31.3046,"lng":120.5896,"region":"CN3205","label":"1190年","y0":1190,"y1":1190,"age":"51","works":3,"events":["是冬，许浦阅兵归，有诗。"],"poems":[],"notes":["以上《东塘集》卷四","自注：去声。"]},{"place":{"zh":"杭州（钱塘）","modern":"杭州","ancient":"钱塘","spot":"","en":"Hangzhou (Qiantang)"},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1191年","y0":1191,"y1":1191,"age":"52","works":3,"events":["召为侍左郎中兼右司郎官，作《王恭父出守洋州二首》。"],"poems":[{"id":200942,"title":"王恭父出守洋州二首 其一","date":"1191年","excerpt":"胸中万卷书，足下四方志。士任重道远，渠以中外异。"},{"id":200797,"title":"肃客借重金紫绶","date":"1191年","excerpt":"平生青紫滥于身，更冒金章肃使宾。何以假为诚岂敢，乌知非有笑无因。"}],"notes":[]},{"place":{"zh":"苏州（吴县）寿栎堂","modern":"苏州","ancient":"吴县","spot":"寿栎堂","en":"Suzhou (Wuxian)"},"lat":31.3046,"lng":120.5896,"region":"CN3205","label":"1191年","y0":1191,"y1":1191,"age":"52","works":0,"events":["充接送伴金国贺生辰使，道姑苏，访范成大。"],"poems":[],"notes":[]},{"place":{"zh":"杭州（钱塘）","modern":"杭州","ancient":"钱塘","spot":"","en":"Hangzhou (Qiantang)"},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1192年 - 1196年","y0":1192,"y1":1196,"age":"53-57","works":8,"events
，七十归来尚六年。顾我久惭迷利禄，与师同约老林泉。"},{"id":496855,"title":"送十二弟太博扬倅潭州","date":"1072年","excerpt":"我忆初筵湖外日，于今三十八年间。无缘再得游潭府，有梦还应到岳山。"},{"id":496862,"title":"入蜀先寄青城张遨先生","date":"1072年七月","excerpt":"踰年青社得徘徊，一日皇华下诏催。蜀道五千驰驿去，秦关百二拂云开。"}],"notes":["自注：吕公馀庆。","自注：张公乖崖"]},{"place":{"zh":"盱眙","modern":"盱眙","ancient":"","spot":"","en":"Xuyi","enModern":"Xuyi","enAncient":"","enSpot":""},"lat":33.0171,"lng":118.5514,"region":"CN320830","label":"1072年八月","y0":1072,"y1":1072,"age":"65","works":0,"events":["过泗州，有诗。"],"poems":[],"notes":[]},{"place":{"zh":"略阳（长举）","modern":"略阳","ancient":"长举","spot":"","en":"Zhangju (Lveyang)","enModern":"Lveyang","enAncient":"Zhangju","enSpot":""},"lat":33.3331,"lng":106.1631,"region":"CN610727","label":"1072年十月","y0":1072,"y1":1072,"age":"65","works":1,"events":["过青泥岭，有诗。"],"poems":[{"id":497024,"title":"过青泥岭","date":"1072年十月","excerpt":"老杜休誇蜀道难，我闻天险不同山。青泥岭上青云路，二十年来七往还。"}],"notes":[]},{"place":{"zh":"成都","modern":"成都","ancient":"","spot":"","en":"Chengdu","enModern":"Chengdu","enAncient":"","enSpot":""},"lat":30.5763,"lng":104.0712,"region":"CN5101","label":"1072年十二月","y0":1072,"y1":1072,"age":"65","works":0,"events":["至蜀，与青城山道是张遨游数日。"],"poems":[],"notes":[]},{"place":{"zh":"雅安（雅州）","modern":"雅安","ancient":"雅州","spot":"","en":"Yazhou (Yaan)","enModern":"Yaan","enAncient":"Yazhou","enSpot":""},"lat":30.0213,"lng":103.0464,"region":"CN5118","label":"1072年十二月","y0":1072,"y1":1072,"age":"65","works":0,"events":["访隐士王潜于雅州。"],"poems":[],"notes":[]},{"place":{"zh":"成都","modern":"成都","ancient":"","spot":"","en":"Chengdu","enModern":"Chengdu","enAncient":"","enSpot":""},"lat":30.5763,"lng":104.0712,"region":"CN5101","label":"1073年 - 1074年七月","y0":1073,"y1":1074,"age":"66-67","works":2,"events":["在成都任。仲子㞦登进士第。","正月三日，钤兵李左藏厅赏梅，有诗纪之，作品：《钤兵李左藏厅赏梅》。"],"poems":[{"id":496877,"title":"钤兵李左藏厅赏梅","date":"1074年一月三日","excerpt":"岁晏珍林发素葩，樽前奇赏著诗誇。惊逢腊去已三日，喜见春初第一花。"},{"id":496879,"title":"钤兵王閤使素芳亭赏梅花","date":"1074年","excerpt":"素萼清香并酒卮，主人勤意嘱留诗。为逢蜀国新开日，却忆江南旧赏时。"}],"notes":[]},{"place":{"zh":"西安（长安）","modern":"西安","ancient":"长安","spot":"","en":"Changan (Xian)","enModern":"Xian","enAncient":"Changan","enSpot":""},"lat":34.3474,"lng":108.9463,"region":"CN6101","label":"1074年十一月","y0":1074,"y1":1074,"age":"67","works":0,"events":["十月出蜀。十一月二十二日道经京兆，与吴中复等题名于慈恩塔。"],"poems":[],"notes":[]},{"place":{"zh":"绍兴（山阴）","modern":"绍兴","ancient":"山阴","spot":"","en":"Shanyin (Shaoxing)","enModern":"Shaoxing","enAncient":"Shanyin","enSpot":""},"lat":30.0365,"lng":120.5867,"region":"CN3306","label":"1075年四月 - 1077年","y0":1075,"y1":1077,"age":"68-70","works":0,"events":["四月，到越州任。"],"poems":[],"notes":[]},{"place":{"zh":"杭州（钱塘）","modern":"杭州","ancient":"钱塘","spot":"","en":"Qiantang (Hangzhou)","enModern":"Hangzhou","enAncient":"Qiantang","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1077年五月 - 1079年二月二十三日","y0":1077,"y1":1079,"age":"70-72","works":23,"events":["五月，复知杭州。","上元观灯，赋诗纪之，作品：《杭州上元观灯 其一》。","郡斋成，有诗寄程师孟，作品：《杭州八咏 其八 介亭》。","六月，与赵少师同游西湖，作品：《陪前人游西湖兼简坐客》。"],"poems":[{"id":496904,"title":"武林即事寄前人二首 其一","date":"1077年九月","excerpt":"乞得钱塘下九天，徙从青社复三川。坤维十往万馀里，吴分重来七八年。"},{"id":496912,"title":"次韵楼头闻角","date":"1077年十一月","excerpt":"龙蛰穷冬万否开，蛩吟清晓在蓬莱。五更枕上惊残梦，一曲楼头动小梅。"},{"id":496913,"title":"次韵岁暮有感","date":"1077年十二月","excerpt":"岁月如流不用嗟，盛衰前定岂曾差。自怜览照头浑雪，犹喜观书目未花。"},{"id":496916,"title":"戊午元日偶成","date":"1078年一月一日","excerpt":"驱驰光景急如轮，复见元丰岁始春。七十一年欣入手，三千奏牍欲归身。"},{"id":496917,"title":"清风阁即事","date":"1078年一月","excerpt":"庭有松萝砌有苔，退公聊此远尘埃。湖音隐隐海门至，泉势潺潺石缝来。"},{"id":496940,"title":"武林言怀寄程给事","date":"1078年一月","excerpt":"岁丰公暇两安舒，吴越诗筒不使疏。世契琼瑶风谊厚，秋光怀袖气凉初。"},{"id":496945,"title":"次韵许遵少卿见寄","date":"1078年一月","excerpt":"头上有霜添白发，囊中无药驻朱颜。堪惊积岁加衰老，未省何时得退閒。"},{"id":496918,"title":"杭州上元观灯 其一","date":"1078年一月十五日","excerpt":"元夕观灯把酒杯，宾朋不倦醉中陪。一轮丹桂当天满，千顷红莲匝地开。"}],"notes":["自注：平岚，亭名。","前人即赵少师概。"]},{"place":{"zh":"衢州（西安）","modern":"衢州","ancient":"西安","spot":"","en":"Xian (Quzhou)","enModern":"Quzhou","enAncient":"Xian","enSpot":""},"lat":28.9417,"lng":118.8808,"region":"CN3308","label":"1079年三月 - 1080年七月","y0":1079,"y1":1080,"age":"72-73","works":16,"events":["三月，退居于衢州故里，有诗。","三月，退居于衢州故里，赋十咏诗，作品：《退居十咏 其五 竹轩》《退居十咏 其八 濯缨亭》。","重登唐台山，有诗，作品：《己未岁十月七日登唐台山偶成》。","做寿茔，自为之颂，作品：《寿茔颂》。"],"poems":[],"notes":[]},{"place":{"zh":"天台天台山","modern":"天台天台山","ancient":"","spot":"","en":"Tiantaitiantaishan","enModern":"Tiantaitiantaishan","enAncient":"","enSpot":""},"lat":29.1488,"lng":121.0138,"region":"CN331023","label":"1080年","y0":1080,"y1":1080,"age":"73","works":2,"events":["过台州，㞦侍游天台山，有诗纪游，作品：《初入天台示男㞦》。"],"poems":[{"id":497211,"title":"初入天台示男㞦","date":"1080年","excerpt":"景入天台日日新，安车千里去寻真。路逢白发老翁问，父子同游有几人。"},{"id":497217,"title":"与男㞦游天台石桥览先祖诗因成","date":"1080年","excerpt":"石桥吾祖昔留诗，句有天寒树著衣。山下老僧能叹咏，诸孙三岁与光辉⑴。"}],"notes":[]},{"place":{"zh":"乐清雁荡山","modern":"乐清雁荡山","ancient":"","spot":"","en":"Yueqingyandangshan","enModern":"Yueqingyandangshan","enAncient":"","enSpot":""},"lat":28.119,"lng":120.9899,"region":"CN330382","label":"1080年","y0":1080,"y1":1080,"age":"73","works":1,"events":["入乐清，㞦侍游游雁荡山。"],"poems":[{"id":497224,"title":"出雁荡回望常云峰","date":"1080年","excerpt":"游遍名山未肯休，征车已发尚回眸。高峰亦似多情思，百里依然一探头。"}],"notes":[]},{"place":{"zh":"温州（永嘉）","modern":"温州","ancient":"永嘉","spot":"","en":"Yongjia (Wenzhou)","enModern":"Wenzhou","enAncient":"Yongjia","enSpot":""},"lat":28.0011,"lng":120.7059,"region":"CN3303","label":"1080年","y0":1080,"y1":1080,"age":"73","works":2,"events":["将抵温，寄诗郡守石牧之。","抵温，与郡守石郎中牧之唱和，作品：《十八男屼温㞦迎于雁荡温守石牧之以诗见寄次韵》。"],"poems":[{"id":496983,"title":"游雁荡将抵温州寄太守石牧之","date":"1080年","excerpt":"霜风双鬓雪鬖鬖，物外寻真顿离凡。子舍若非叨别乘，我车安得到灵岩。"},{"id":496980,"title":"十八男屼温㞦迎于雁荡温守石牧之以诗见寄次韵","date":"1080年","excerpt":"自谙趋拜力惟艰，柯岭归休远帝寰。抱瓮不能师老圃，驱车犹足访名山。"}],"notes":[]},{"place":{"zh":"衢州（西安）","modern":"衢州","ancient":"西安","spot":"","en":"Xian (Quzhou)","enModern":"Quzhou","enAncient":"Xian","enSpot":""},"lat":28.9417,"lng":118.8808,"region":"CN3308","label":"1080年 - 1082年","y0":1080,"y1":1082,"age":"73-75","works":5,"events":["子㞦随侍还乡将回温州，作诗送行。"],"poems":[],"notes":[]},{"place":{"zh":"杭州（钱塘）","modern":"杭州","ancient":"钱塘","spot":"","en":"Qiantang (Hangzhou)","enModern":"Hangzhou","enAncient":"Qiantang","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1083年八月 - 1084年八月","y0":1083,"y1":1084,"age":"76-77","works":1,"events":["仲子㞦温倅代还，为监察御史，公年高，乞免，从之，提举两浙常平，以便其养。"],"poems":[{"id":497176,"title":"观潮因寄五弟拊生日","date":"1083年","excerpt":"祝弟生辰不惮遥，元丰六稔庆三朝。源源祺寿来无尽，一似钱江两信潮。"}],"notes":[]},{"place":{"zh":"衢州（西安）","modern":"衢州","ancient":"西安","spot":"","en":"Xian (Quzhou)","enModern":"Quzhou","enAncient":"Xian","enSpot":""},"lat":28.9417,"lng":118.8808,"region":"CN3308","label":"1084年八月二十六日 - 1084年十二月","y0":1084,"y1":1084,"age":"77","works":0,"events":["是月，以疾还衢，二十六日晨起如平时，遍辞亲友，少顷跌坐而化。赠太子少师，谥清献。","十二月乙酉，葬郡城东北莲花山。"],"poems":[],"notes":[]}],"stages":[{"from":1,"to":6,"title":{"zh":"开化、衢州、开封等地","en":"Kaihua, Quzhou, Kaifeng"},"main":"开化","y0":1028,"y1":1042,"events":["读书于开化县东开原乡招福院之萃清阁。","馆于乡之户家陈氏。","秋，赴京应试。","为武安军节度推官。","以著作佐郎知建州崇安县。","以秘书丞通判宜州。"]},{"from":7,"to":14,"title":{"zh":"衢州、泰州、如皋等地","en":"Quzhou, Taizhou, Rugao"},"main":"衢州","y0":1043,"y1":1050,"events":["丁越国忧，扶柩归葬于盈州乡。","以承奉郎守秘书丞，起知海陵县。","知如皋县。","冬，以太常博士移知江原县。水路入蜀，弟抗、扬同行，过鄂州鹦鹉洲，有诗。","1049年十二月二十四日，舟中逢立春，有诗。","1049年十二月二十九日，除夜泊忠州临江县，有诗。"]},{"from":15,"to":20,"title":{"zh":"盱眙、开封、凤阳等地","en":"Xuyi, Kaifeng, Fengyang"},"main":"盱眙","y0":1051,"y1":1058,"events":["以屯田员外郎通判泗州。","擢守殿中侍御史，举屯田员外郎方任自代。奏罢杨察、刘沆。","过濠州，有诗。","过家，上冢。","正月，到睦州任，有诗。","移充梓州路转运使。寄家甬上，单行入蜀。"]},{"from":21,"to":28,"title":{"zh":"三台、开封、衢州等地","en":"Santai, Kaifeng, Quzhou"},"main":"开封","y0":1058,"y1":1064,"events":["七月十七日到梓州任。","召为右司谏，举尚书度支员外郎苏寀自代。","过家上冢，有诗言怀。","到虔州任。入学听讲，与知县钱著作顗唱和。","将至太和，有诗。","以礼部员外郎兼侍御史知杂事，十二弟扬任临真县。"]},{"from":29,"to":34,"title":{"zh":"剑阁、成都、开封等地","en":"Jiange, Chengdu, Kaifeng"},"main":"剑阁","y0":1065,"y1":1072,"events":["春，加龙图阁直学士，以吏部员外郎知成都。过剑门关有诗。","四月到成都任。","入朝，奏陈十事、论五废。","八月，到杭州任。重惩无赖子。","夏，到青州任。夏末，有诗。","过泗州，有诗。"]},{"from":35,"to":39,"title":{"zh":"略阳、成都、雅安等地","en":"Lveyang, Chengdu, Yaan"},"main":"成都","y0":1072,"y1":1074,"eve
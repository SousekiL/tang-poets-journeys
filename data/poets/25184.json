abel":"1184年 - 1185年","y0":1184,"y1":1185,"age":"35-36","works":4,"events":["仍在平江任原职。是年三女媛生。初，叶适有二女，连岁皆失。"],"poems":[{"id":80106,"title":"还华贤良九经说贤良进卷语林等","date":"1184年六月","excerpt":"华君官五世，人物朴而重。穷经不辞难，著论何其勇。"},{"id":80108,"title":"陈同甫抱膝斋二首 其一","date":"1185年","excerpt":"昔人但抱膝，将军拥和銮。徒知许国易，未信藏身难。"},{"id":1286294,"title":"包颙叟墓记","date":"1185年八月丙辰","excerpt":""}],"notes":[]},{"place":{"zh":"杭州（临安）","modern":"杭州","ancient":"临安","spot":"","en":"Linan (Hangzhou)","enModern":"Hangzhou","enAncient":"Linan","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1186年 - 1189年五月","y0":1186,"y1":1189,"age":"37-40","works":19,"events":["是年，改宣教郎，任太学正，与俞君烈、刘愚为僚友。"],"poems":[{"id":1286173,"title":"宋故孟夫人墓志铭","date":"1186年","excerpt":""},{"id":1286174,"title":"宋故宣教郎通判平江府姚君墓志铭","date":"1186年","excerpt":""},{"id":1286175,"title":"将仕郎嵇君墓记","date":"1186年","excerpt":""},{"id":1286322,"title":"祭赵知宗文","date":"1187年七月三十日","excerpt":""},{"id":80022,"title":"高宗皇帝挽词二首 其一","date":"1187年十月八日","excerpt":"何止超前代，功隆道更尊。几同造区夏，还复外乾坤。"},{"id":1286182,"title":"厉君墓志铭","date":"1187年","excerpt":""},{"id":80222,"title":"赠讷相","date":"1187年","excerpt":"柯山讷相丑形模，以相获妍如子都。每将气色较官簿，初若搏影终探符。"},{"id":1286065,"title":"进故事","date":"1187年","excerpt":""}],"notes":["人名参看《水心集》卷十三。","人名参看《水心集》卷二十六。"]},{"place":{"zh":"永康","modern":"永康","ancient":"","spot":"","en":"Yongkang","enModern":"Yongkang","enAncient":"","enSpot":""},"lat":28.8942,"lng":120.0539,"region":"CN330784","label":"1189年五月","y0":1189,"y1":1189,"age":"40","works":0,"events":["五月，回乡探亲，途径永康，访陈亮。"],"poems":[],"notes":[]},{"place":{"zh":"温州（永嘉）","modern":"温州","ancient":"永嘉","spot":"","en":"Yongjia (Wenzhou)","enModern":"Wenzhou","enAncient":"Yongjia","enSpot":""},"lat":28.0011,"lng":120.7059,"region":"CN3303","label":"1189年六月","y0":1189,"y1":1189,"age":"40","works":1,"events":["六月，离乡赴湖北江陵任所，门人陈志崇相送，乞为其兄陈岩作墓志铭。"],"poems":[{"id":1286178,"title":"陈君墓志铭","date":"1189年六月","excerpt":""}],"notes":[]},{"place":{"zh":"金华","modern":"金华","ancient":"","spot":"","en":
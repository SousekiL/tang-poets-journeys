与戴表元、刘庄荪、王达善、胡三省唱和。其间曾与戴表元同避兵台之硖石。"],"poems":[{"id":223502,"title":"过字韵诗辱诸友联和方营度枯鄙以酬厚意偶报北兵自瓯闽回驱男女牛羊万计入蛟湖深畯出独山屯尚义由童公岭以北三日夜不休闻之惊心遂成阁笔是月十四夜对月感涕遂即前韵以纪时事奉呈诸友","date":"1276年","excerpt":"麦倒桑折枝，山外花门过。牛亡主不归，妇去蚕未卧。"},{"id":223337,"title":"登小山谷","date":"1276年","excerpt":"亭榭随人事，江山换劫灰。邹裾前日盛，谢屐几时来。"},{"id":1317365,"title":"跋王达善烧痕稿","date":"1276年","excerpt":""},{"id":223439,"title":"丙子兵祸自有宇宙宁海所未见也予家二百指甔石将罄避地入剡贷粟而食解衣偿之不敢以渊明之主人望于人也因读渊明乞食诗和韵书怀呈达善亦见达善烧痕藁中有陶公乞食颜公乞米二帖跋尾也","date":"1276年","excerpt":"渊明不可及，适意惟所之。无食不免乞，折腰乃竟辞。"},{"id":223353,"title":"新历未颁遗民感怆二首贻王达善曹季辩胡山甫戴帅初诸君皆避地客也 其一","date":"1276年","excerpt":"故国山河成断绝，孤臣江海自飘零。窗间取月离离白，树下窥天碎碎青。"},{"id":223108,"title":"再和前韵答达善季辩 其一","date":"1276年","excerpt":"屝屦送人征影远，布裘知我涕痕零。初愁冻雪无狐白，忽喜晴霄现卵青。"},{"id":223404,"title":"十月初五日重赋菊","date":"1276年十月五日","excerpt":"昔人十月菊，已恨光景衰。今兹十月菊，瘦蕊未觉迟。"},{"id":223525,"title":"往时予有湖湘之游同年黄东发提举以清江楮衾赠别藏之四年矣山房夜寒覆之甚佳乱后不知东发避地何处作此拟寄","date":"1276年","excerpt":"我昔向湘潭，故人贻我别。珍于锦鲸赠，未数绨袍脱。"}],"notes":["自注：荆公诗：紫磨月轮升塞外。"]},{"place":{"zh":"天台马岙","modern":"天台马岙","ancient":"","spot":"","en":"Tiantaimaao","enModern":"Tiantaimaao","enAncient":"","enSpot":""},"lat":29.1488,"lng":121.0138,"region":"CN331023","label":"1276年十二月三日","y0":1276,"y1":1276,"age":"58","works":2,"events":["爱马岙深幽，乃有结茅之意。"],"poems":[],"notes":[]},{"place":{"zh":"嵊州（嵊县）雪溪","modern":"嵊州","ancient":"嵊县","spot":"雪溪","en":"Shengxian (Shengzhou) Xuexi","enModern":"Shengzhou","enAncient":"Shengxian","enSpot":"Xuexi"},"lat":29.5947,"lng":120.8281,"region":"CN330683","label":"1276年","y0":1276,"y1":1276,"age":"58","works":0,"events":["避兵居剡之雪溪，有董生景愈从学。"],"poems":[],"notes":[]},{"place":{"zh":"天台陈村","modern":"天台陈村","ancient":"","spot":"","en":"Tiantaichencun","enModern":"Tiantaichencun","enAncient":"","enSpot":""},"lat":29.1488,"lng":121.0138,"region":"CN331023","label":"1276年九月","y0":1276,"y1":1276,"age":"58","works":3,"events":["避地陈村。"],"poems":[],"notes":[]},{"place":{"zh":"台州","modern":"台州","ancient":"","spot":"","en":"Taizhou","enModern":"Taizhou","enAncient":"","enSpot":""},"lat":28.6623,"lng":121.427,"region":"CN331","label":"1276年十月 - 1276年","y0":1276,"y1":1276,"age":"58","works":11,"events":["元军入台州宁海，旋入尚义里，屯兵岳祥宅。岳祥行迹不明。"],"poems":[],"notes":[]},{"place":{"zh":"宁海（台州）","modern":"宁海","ancient":"台州","spot":"","en":"Taizhou (Ninghai)","enModern":"Ninghai","enAncient":"Taizhou","enSpot":""},"lat":29.2944,"lng":121.436,"region":"CN330226","label":"1277年 - 1278年","y0":1277,"y1":1278,"age":"59-60","works":57,"events":["春晚还致庵，即所谓龙舒旧隐，痛惜藏书尽毁于兵火。丧乱之余，转盼明年安泰。"],"poems":[],"notes":[]},{"place":{"zh":"宁波","modern":"宁波","ancient":"","spot":"","en":"Ningbo","enModern":"Ningbo","enAncient":"","enSpot":""},"lat":29.8802,"lng":121.5567,"region":"CN3302","label":"1278年","y0":1278,"y1":1278,"age":"60","works":0,"events":["避兵期间，曾寄居袁洪家。"],"poems":[],"notes":[]},{"place":{"zh":"宁海（台州）","modern":"宁海","ancient":"台州","spot":"","en":"Taizhou (Ninghai)","enModern":"Ninghai","enAncient":"Taizhou","enSpot":""},"lat":29.2944,"lng":121.436,"region":"CN330226","label":"1279年一月 - 1288年","y0":1279,"y1":1288,"age":"61-70","works":73,"events":["作七古，借物写志，时在崖山陷落前一月。"],"poems":[],"notes":[]},{"place":{"zh":"浙江","modern":"浙江","ancient":"","spot":"","en":"Zhejiang","enModern":"Zhejiang","enAncient":"","enSpot":""},"lat":30.2715,"lng":120.1601,"region":"CN33","label":"1289年 - 1289年四月十日","y0":1289,"y1":1289,"age":"71","works":1,"events":["春，岳祥家及家祠毁于兵火，其为夫人王氏所写墓志铭亦毁于兵火。因浙东各地陆续发生农民暴动而流徙浙东。"],"poems":[{"id":223567,"title":"寇攘之馀谷五斗才易一鸡衰老多病资血味以为养求之弗可得畜二母鸡自春抱育至夏百翼不减子美生理喜而有作","date":"1289年四月十日","excerpt":"昔有尸乡翁，养鸡盖阡陌。累财千馀万，积微利自博。"}],"notes":["四月初十日"]},{"place":{"zh":"新昌雪溪","modern":"新昌雪溪","ancient":"","spot":"","en":"Xinchangxuexi","enModern":"Xinchangxuexi","enAncient":"","enSpot":""},"lat":29.5055,"lng":120.9104,"region":"CN330624","label":"1289年","y0":1289,"y1":1289,"age":"71","works":0,"events":["因家毁于兵火，身外无余物，乃避居新昌雪溪。"],"poems":[{"id":222961,"title":"雪村闻鹃","date":"1289年","excerpt":"故国亡来身已非，千年犹诉不如归。参天古木魂迷路，谁与黎侯赋式微。"}],"notes":[]},{"place":{"zh":"奉化棠奥","modern":"奉化棠奥","ancient":"","spot":"","en":"Fenghuatangao","enModern":"Fenghuatangao","enAncient":"","enSpot":""},"lat":29.661,"lng":121.4134,"region":"CN330283","label":"1289年","y0":1289,"y1":1289,"age":"71","works":0,"events":["又避居奉化棠奥（即棠溪）。"],"poems":[],"notes":[]},{"place":{"zh":"新昌","modern":"新昌","ancient":"","spot":"","en":"Xinchang","enModern":"Xinchang","enAncient":"","enSpot":""},"lat":29.5055,"lng":120.9104,"region":"CN330624","label":"1289年","y0":1289,"y1":1289,"age":"71","works":1,"events":["在新昌雪溪为董伯和寿康精舍作记。"],"poems":[],"notes":[]},{"place":{"zh":"奉化","modern":"奉化","ancient":"","spot":"","en":"Fenghua","enModern":"Fenghua","enAncient":"","enSpot":""},"lat":29.661,"lng":121.4134,"region":"CN330283","label":"1289年六月十六日 - 1290年","y0":1289,"y1":1290,"age":"71-72","works":5,"events":["在棠溪，袁仲素、季厚兄弟为辟堂下榻，岳祥家三百指，其至如归。岳祥有感于庄周梦蝶之说，名所寓曰“蝶轩”。岳祥居蝶轩，有诗文多篇，于是集己丑后诗文若干篇，目为《蝶轩稿》。"],"poems":[{"id":223130,"title":"次和杉棚","date":"1289年","excerpt":"上伏清凉散，家僮手自成。日斜蛟弄影，风过鼠行声。"},{"id":223470,"title":"次达善送赵君理韵因寄畬斋陈贵白","date":"1289年","excerpt":"杉棚已绝笔，复得云锦书。况当既望后，一镜悬空虚。"},{"id":223310,"title":"寄赵敏求","date":"1289年","excerpt":"赵子贫愈好，吟诗送此生。焚巢同旅鸟，泛宅老书檠。"},{"id":223366,"title":"蝶轩读易几","date":"1289年","excerpt":"负薪收芋栗，扪虱曝荆扉。落日乌行乱，清霜杏叶飞。"},{"id":223083,"title":"正仲访余棠溪帅初来会正仲时余欲归阆风未能决书呈三友","date":"1290年","excerpt":"晴云高举雪云低，日日占天候不齐。菘白僵成茭白笋，麦黄淹作韭黄齑。"}],"notes":["自注：先人遗文。"]},{"place":{"zh":"宁海（台州）棠溪","modern":"宁海","ancient":"台州","spot":"棠溪","en":"Taizhou (Ninghai) Tangxi","enModern":"Ninghai","enAncient":"Taizhou","enSpot":"Tangxi"},"lat":29.2944,"lng":121.436,"region":"CN330226","label":"1290年","y0":1290,"y1":1290,"age":"72","works":1,"events":["春，由棠溪归故园。"],"poems":[],"notes":[]},{"place":{"zh":"奉化蝶轩","modern":"奉化蝶轩","ancient":"","spot":"","en":"Fenghuadiexuan","enModern":"Fenghuadiexuan","enAncient":"","enSpot":""},"lat":29.661,"lng":121.4134,"region":"CN330283","label":"1290年","y0":1290,"y1":1290,"age":"72","works":0,"events":["旋复返蝶轩。诗文集《蝶轩稿》成。"],"poems":[],"notes":[]},{"place":{"zh":"宁海（台州）","modern":"宁海","ancient":"台州","spot":"","en":"Taizhou (Ninghai)","enModern":"Ninghai","enAncient":"Taizhou","enSpot":""},"lat":29.2944,"lng":121.436,"region":"CN330226","label":"1290年三月二十一日 - 1298年六月十九日","y0":1290,"y1":1298,"age":"72-80","works":29,"events":["归凤栖茇舍看牡丹，作诗。","卒。卒前二日赋诗三章，卒后门人私谥文清先生。"],"poems":[],"notes":[]}],"stages":[{"from":1,"to":5,"title":{"zh":"天台霞城、宁海、杭州等地","en":"Tiantaixiacheng, Ninghai, Hangzhou"},"main":"宁海","y0":1243,"y1":1253,"events":["游霞城，以文谒吴子良。","居乡。","就省试，不中而返。妻王氏勉之再进。","偕妻王氏赴湖湘，依湖南转运副使吴子良。吴试以吏事，深许之。"]},{"from":6,"to":15,"title":{"zh":"宁海、杭州、奉化等地","en":"Ninghai, Hangzhou, Fenghua"},"main":"宁海","y0":1254,"y1":1264,"events":["由湖南返里。","登文天祥榜进士。","授奉化尉。","是年起，于宅西营建“篆畦”，积岁而成，以其行径纡余贯穿若篆文，故名。篆畦，岳家大花园。","在奉化县尉任。","在奉化县尉任，旋摄定海令。与王达善相识，此后二人笃厚友谊直至达善终年。"]},{"from":16,"to":17,"title":{"zh":"苏州、宁海","en":"Suzhou, Ninghai"},"main":"苏州","y0":1265,"y1":1266,"events":["弟斗祥卒于长洲，岳祥往哭之。","居乡丁母忧。"]},{"from":18,"to":20,"title":{"zh":"南京、宁波、杭州","en":"Nanjing, Ningbo, Hangzhou"},"main":"南京","y0":1267,"y1":1274,"events":["丁母忧，服阕，入淮东总领陈蒙幕。","入沿海制阃鲍度幕约在本年，鲍度幕府似在鄞县。","两浙镇抚大使谢堂邀岳祥留都共订诸儒所评论司马光《通鉴》，拟成一家之作，奏入经筵备讲读。"]},{"from":21,"to":22,"title":{"zh":"南京、镇江","en":"Nanjing, Zhenjiang"},"main":"南京","y0":1274,"y1":1274,"events":["在临安期间，曾北游金陵。","在临安期间，曾北游京口。"]},{"from":23,"to":40,"title":{"zh":"杭州、宁海、台州马岙；硖石等地","en":"Hangzhou, Ninghai, Taizhoumaao；xiashi"},"main":"宁海","y0":1274,"y1":1298,"events":["在临安期间，观十年前所书《老椿》屏。","归耕后，亲见贫苦农民的艰辛生活，而于诗中寄予同情，以《十妇词》为代表。","避兵天台马岙，与戴表元、刘庄荪、王达善、胡三省唱和。其间曾与戴表元同避兵台之硖石。","爱马岙深幽，乃有结茅之意。","避兵居剡之雪溪，有董生景愈从学。","避地陈村。"]}],"curated":false}
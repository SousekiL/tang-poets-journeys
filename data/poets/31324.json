寄若拙弟托觅颜渊之五十亩韵","date":"1120年三月","excerpt":"下田弥望股清流，谋食谁言必本州。且复种粳资口腹，早知籍稻载春秋。"},{"id":523691,"title":"蒙若拙见和复次韵","date":"1120年三月","excerpt":"逸气轩轩盖搢绅，后来之秀子其人。文如范晔无空设，学似扬雄已大醇。"}],"notes":["中谢。","轩"]},{"place":{"zh":"湖州","modern":"湖州","ancient":"","spot":"","en":"Huzhou","enModern":"Huzhou","enAncient":"","enSpot":""},"lat":30.899,"lng":120.0946,"region":"CN3305","label":"1122年 - 1124年九月","y0":1122,"y1":1124,"age":"51-53","works":24,"events":["离湖州前通判饯行，作品：《瑞鹧鸪 和通判送别》。"],"poems":[{"id":1214344,"title":"答颜教授书","date":"1122年","excerpt":""},{"id":1214343,"title":"与制置发运书","date":"1123年一月","excerpt":""},{"id":224469,"title":"临江仙 与叶少蕴梦得上 其三 巳游法华山九曲池流杯","date":"1123年三月三日","excerpt":"小样洪河分九曲，飞泉环绕粼粼。青莲往事已成尘。"},{"id":224472,"title":"临江仙 其一 燕诸部使者","date":"1123年三月三日","excerpt":"自古吴兴称冷僻，菰城水浸粼粼。回星难望使车尘。"},{"id":224474,"title":"临江仙","date":"1123年三月三日","excerpt":"千古乌程新酿美，玉觞风过粼粼。歌声未办起梁尘。"},{"id":1214539,"title":"妻硕人张氏墓志铭","date":"1123年四月","excerpt":""},{"id":1214287,"title":"贺收复燕山府表","date":"1123年五月","excerpt":""},{"id":1214293,"title":"谢收复燕云进马赐诏书表","date":"1123年五月","excerpt":""}],"notes":["中谢。","中贺。"]},{"place":{"zh":"邓州","modern":"邓州","ancient":"","spot":"","en":"Dengzhou","enModern":"Dengzhou","enAncient":"","enSpot":""},"lat":32.6941,"lng":112.0938,"region":"CN411381","label":"1124年九月六日 - 1125年三月","y0":1124,"y1":1125,"age":"53-54","works":8,"events":["移知邓州。"],"poems":[{"id":1214305,"title":"邓州谢上表","date":"1124年","excerpt":""},{"id":1214400,"title":"邓州到任谢执政启","date":"1124年","excerpt":""},{"id":1214401,"title":"邓州谢范左丞启","date":"1124年","excerpt":""},{"id":1214403,"title":"再与范左丞启","date":"1124年","excerpt":""},{"id":523405,"title":"至南阳却寄吴兴诸僚","date":"1124年","excerpt":"震州推不去，游食岁月久。尺一从天来，换作秦头守。"},{"id":523704,"title":"友乡寄谢并月波酒和其韵","date":"1124年","excerpt":"长须剥啄叩柴扃，令弟官清远寄声。擿句已欣资艺圃，漱醪兼赖破愁城。"},{"id":224507,"title":"蓦山溪 天穿节 其一 和朱刑掾二首","date":"1125年一月","excerpt":"望云门外。油壁如流水。"},{"id":224496,"title":"浪淘沙令 将去南阳作","date":"1125年三月","excerpt":"步屧对东风。细探春工。"}],"notes":["中谢。"]},{"place":{"zh":"襄阳","modern"
{"id":13917,"name":"唐彦谦","en":"Tang Yanqian","birth":848,"death":907,"period":"晚唐","period_en":"Late Tang","dynasty":"tang","refs":"罗敏中《唐彦谦年谱》；傅璇琮《唐才子传校笺》；陶敏所考，见《唐才子传校笺》；《唐才子传校笺》","compilers":"李定广","km":8574,"places":19,"works":57,"stops":[{"place":{"zh":"太原","modern":"太原","ancient":"","spot":"","en":"Taiyuan","enModern":"Taiyuan","enAncient":"","enSpot":""},"lat":37.8769,"lng":112.5571,"region":"CN1401","label":"848年 - 868年","y0":848,"y1":868,"age":"1-21","works":0,"events":["是年唐彦谦生于山西晋原。"],"poems":[],"notes":[]},{"place":{"zh":"洛阳金谷园","modern":"洛阳金谷园","ancient":"","spot":"","en":"Luoyangjinguyuan","enModern":"Luoyangjinguyuan","enAncient":"","enSpot":""},"lat":34.6244,"lng":112.46,"region":"CN4103","label":"869年","y0":869,"y1":869,"age":"22","works":1,"events":["春，游河南洛阳，有诗。"],"poems":[{"id":42283,"title":"洛神","date":"869年","excerpt":"人世仙家本自殊，何须相见向中途。惊鸿瞥过游龙去，漫恼陈王一事无。"}],"notes":[]},{"place":{"zh":"驻马店","modern":"驻马店","ancient":"","spot":"","en":"Zhumadian","enModern":"Zhumadian","enAncient":"","enSpot":""},"lat":33.0175,"lng":114.0295,"region":"CN4117","label":"869年","y0":869,"y1":869,"age":"22","works":1,"events":["秋，至棠溪，有诗。"],"poems":[{"id":42383,"title":"咸通中始闻褚河南归葬阳翟是岁上平徐方大肆庆赏又诏八品锡其裔孙追叙风概因成二十韵","date":"869年","excerpt":"册府藏馀烈，皇纲正本朝。不听还笏谏，几覆缀旒祧。"}],"notes":["据王兆鹏先生所考，《闻应德茂先离棠溪》为元人戴表元之作。见其《唐彦谦四十首赝诗证伪》，《中华文史论丛》52辑(1993.12"]},{"place":{"zh":"鄂州","modern":"鄂州","ancient":"","spot":"","en":"Ezhou","enModern":"Ezhou","enAncient":"","enSpot":""},"lat":30.3965,"lng":114.9016,"region":"CN42070","label":"869年","y0":869,"y1":869,"age":"22","works":1,"events":["暮冬，至江夏，有诗。"],"poems":[{"id":42419,"title":"梅","date":"869年","excerpt":"玉人下瑶台，香风动轻素。画角弄江城，鸣珰月中堕。"}],"notes":[]},{"place":{"zh":"巫山巫峡","modern":"巫山巫峡","ancient":"","spot":"","en":"Wushanwuxia","enModern":"Wushanwuxia","enAncient":"","enSpot":""},"lat":31.0804,"lng":109.8853,"region":"CN500237","label":"870年","y0":870,"y1":870,"age":"23","works":10,"events":["春，游巫峡，有诗，作品：《无题十首 其一》《无题十首 其三》《无题十首 其五》《无题十首 其六》《无题十首 其十》。"],"poems":[{"id":42242,"title":"无题十首 其一","date":"870年","excerpt":"细草铺茵绿满堤，燕飞晴日正迟迟。寻芳陌上花如锦，折得东风第一枝。"}],"notes":[]},{"place":{"zh":"襄阳","modern":"襄阳","ancient":"","spot":"","en":"Xiangyang","enModern":"Xiangyang","enAncient":"","enSpot":""},"lat":32.0148,"lng":112.1291,"region":"CN4206","label":"870年","y0":870,"y1":870,"age":"23","works":1,"events":["至襄阳，祭悼孟浩然墓，有诗。"],"poems":[],"notes":["据王兆鹏先生所考，《过浩然先生墓》为元人戴表元之作。见其《唐彦谦四十首赝诗证伪》，《中华文史论丛》52辑(1993.12"]},{"place":{"zh":"洛阳金谷园","modern":"洛阳金谷园","ancient":"","spot":"","en":"Luoyangjinguyuan","enModern":"Luoyangjinguyuan","enAncient":"","enSpot":""},"lat":34.6244,"lng":112.46,"region":"CN4103","label":"870年","y0":870,"y1":870,"age":"23","works":2,"events":["秋，又至洛阳，有诗《咏葡萄》。"],"poems":[{"id":42423,"title":"葡萄","date":"870年","excerpt":"金谷风露凉，绿珠醉初醒。珠帐夜不收，月明堕清影。"},{"id":42405,"title":"咏葡萄","date":"870年","excerpt":"西园晚霁浮嫩凉，开尊漫摘葡萄尝。满架高撑紫络索，一枝斜亸金琅珰。"}],"notes":[]},{"place":{"zh":"西安","modern":"西安","ancient":"","spot":"","en":"Xian","enModern":"Xian","enAncient":"","enSpot":""},"lat":34.3474,"lng":108.9463,"region":"CN6101","label":"872年 - 881年","y0":872,"y1":881,"age":"25-34","works":9,"events":["首次参加进士考试。","四应进士试，不第，有诗，作品：《红叶》。"],"poems":[{"id":42314,"title":"东韦曲野思","date":"875年","excerpt":"淡雾轻云匝四垂，绿塘秋望独颦眉。野莲随水无人见，寒鹭窥鱼共影知。"},{"id":42382,"title":"红叶","date":"875年","excerpt":"无处不飘扬，高楼临道旁。素娥前夕月，青女夜来霜。"},{"id":42311,"title":"上巳","date":"875年","excerpt":"上巳接寒食，莺花寥落晨。微微泼火雨，草草踏青人。"},{"id":42352,"title":"离鸾","date":"875年","excerpt":"闻道离鸾思故乡，也知情愿嫁王昌。尘埃一别杨朱路，风月三年宋玉墙。"},{"id":42310,"title":"八月十六日夜月","date":"879年","excerpt":"断肠佳赏固难期，昨夜销魂更不疑。丹桂影空蟾有露，绿槐阴在鹊无枝。"},{"id":42275,"title":"试夜题省廊桂","date":"881年","excerpt":"麻衣穿穴两京尘，十见东堂绿桂春。今日竞飞杨叶箭，魏舒休作画筹人。"},{"id":42414,"title":"送樊琯司业归朝","date":"881年","excerpt":"近者苏司业，文雄道最光。夫君居太学，妙誉继中行。"},{"id":42329,"title":"夜坐","date":"881年","excerpt":"愁鬓丁年白，寒灯丙夜青。不眠惊戍鼓，久客厌邮铃。"}],"notes":["一作陈","一作阴"]},{"place":{"zh":"临汾","modern":"临汾","ancient":"","spot":"","en":"Linfen","enModern":"Linfen","enAncient":"","enSpot":""},"lat":36.0941,"lng":111.5262,"region":"CN141","label":"882年","y0":882,"y1":882,"age":"35","works":0,"events":["秋前，任河中副使，入秋后为晋州刺史。"],"poems":[],"notes":[]},{"place":{"zh":"侯马","modern":"侯马","ancient":"","spot":"","en":"Houma","enModern":"Houma","enAncient":"","enSpot":""},"lat":35.6253,"lng":111.3785,"region":"CN141081","label":"882年","y0":882,"y1":882,"age":"35","works":0,"events":["冬，改为绛州刺史。"],"poems":[],"notes":[]},{"place":{"zh":"永济","modern":"永济","ancient":"","spot":"","en":"Yongji","enModern":"Yongji","enAncient":"","enSpot":""},"lat":34.8729,"lng":110.4543,"region":"CN140881","label":"883年","y0":883,"y1":883,"age":"36","works":5,"events":["河中节度使王重荣聘彦谦为节度从事，有诗《夏日访友》《高平九日》《夏日访友》《高平九日》。"],"poems":[{"id":42333,"title":"奉使岐下闻唐弘夫行军为贼所擒伤而有作","date":"883年","excerpt":"报国捐躯实壮夫，楚囚垂欲复神都。云台画像皆何者，青史书名或不孤。"},{"id":42415,"title":"夏日访友","date":"883年","excerpt":"堤树生昼凉，浓阴扑空翠。孤舟唤野渡，村疃入幽邃。"},{"id":42355,"title":"高平九日","date":"883年","excerpt":"云净南山紫翠浮，凭陵绝顶望悠悠。偶逢佳节牵诗兴，漫把芳尊遣客愁。"}],"notes":[]},{"place":{"zh":"临汾","modern":"临汾","ancient":"","spot":"","en":"Linfen","enModern":"Linfen","enAncient":"","enSpot":""},"lat":36.0941,"lng":111.5262,"region":"CN141","label":"884年 - 885年","y0":884,"y1":885,"age":"37-38","works":2,"events":["任河中节度副使，兼晋州刺史，有诗。"],"poems":[{"id":42264,"title":"克复后登安国寺阁","date":"884年","excerpt":"千门万户鞠蒿藜，断烬遗垣一望迷。惆怅建章鸳瓦尽，夜来空见玉绳低。"},{"id":42327,"title":"乱后经表兄琼华观旧居","date":"884年","excerpt":"一去仙居似转蓬，再经花谢倚春丛。醉中篇什金声在，别后音书锦字空。"}],"notes":[]},{"place":{"zh":"侯马","modern":"侯马","ancient":"","spot":"","en":"Houma","enModern":"Houma","enAncient":"","enSpot":""},"lat":35.6253,"lng":111.3785,"region":"CN141081","label":"885年 - 886年","y0":885,"y1":886,"age":"38-39","works":1,"events":["初冬，调任绛州刺史，有诗。"],"poems":[{"id":42265,"title":"初秋到慈州冬首换绛牧","date":"885年","excerpt":"秋杪方攀玉树枝，隔年无计待春晖。自嫌暂作仙城守，不逐莺来共燕飞。"}],"notes":[]},{"place":{"zh":"汉中","modern":"汉中","ancient":"","spot":"","en":"Hanzhong","enModern":"Hanzhong","enAncient":"","enSpot":""},"lat":33.0738,"lng":107.0302,"region":"CN6107","label":"887年六月","y0":887,"y1":887,"age":"40","works":0,"events":[],"poems":[],"notes":[]},{"place":{"zh":"南京","modern":"南京","ancient":"","spot":"","en":"Nanjing","enModern":"Nanjing","enAncient":"","enSpot":""},"lat":32.0647,"lng":118.8029,"region":"CN3201","label":"887年九月","y0":887,"y1":887,"age":"40","works":3,"events":["秋九月到金陵，有诗《金陵怀古》。"],"poems":[{"id":42335,"title":"金陵九日","date":"887年九月","excerpt":"野菊西风满路香，雨花台上集壶觞。九重天近瞻钟阜，五色云中望建章。"},{"id":42336,"title":"金陵怀古","date":"887年九月","excerpt":"碧树凉生宿雨收，荷花荷叶满汀洲。登高有酒浑忘醉，慨古无言独倚楼。"},{"id":42372,"title":"游清凉寺","date":"887年九月","excerpt":"白云红树路纡萦，古殿长廊次第行。南望水连桃叶渡，北来山枕石头城。"},{"id":42323,"title":"过三山寺","date":"887年","excerpt":"三山江上寺，宫殿望岧峣。石径侵高树，沙滩半种苗。"}],"notes":["据王兆鹏先生所考，《过清凉寺王导墓下》为元人戴表元之作。见其《唐彦谦四十首赝诗证伪》，《中华文史论丛》52辑(1993.12"]},{"place":{"zh":"宣城东溪","modern":"宣城东溪","ancient":"","spot":"","en":"Xuanchengdongxi","enModern":"Xuanchengdongxi","enAncient":"","enSpot":""},"lat":30.9466,"lng":118.7652,"region":"CN3418","label":"887年","y0":887,"y1":887,"age":"40","works":2,"events":["游当涂，有诗。"],"poems":[{"id":42331,"title":"夜泊东溪有怀","date":"887年","excerpt":"水昏天色晚，崖下泊行舟。独客伤归雁，孤眠叹野鸥。"},{"id":42364,"title":"望夫石","date":"887年","excerpt":"江上见危矶，人形立翠微。妾来终日望，夫去几时归。"}],"notes":[]},{"place":{"zh":"九江庐山","modern":"九江庐山","ancient":"","spot":"","en":"Jiujianglushan","enModern":"Jiujianglushan","enAncient":"","enSpot":""},"lat":29.7113,"lng":116.008,"region":"CN3604","label":"887年","y0":887,"y1":887,"age":"40","works":1,"events":["初冬，到庐山，有诗。"],"poems":[{"id":42373,"title":"登庐山","date":"887年","excerpt":"五老峰巅望，天涯在目前。湘潭浮夜雨，巴蜀暝寒烟。"}],"notes":[]},{"place":{"zh":"南京三山","modern":"南京三山","ancient":"","spot":"","en":"Nanjingsanshan","enModern":"Nanjingsanshan","enAncient":"","enSpot":""},"lat":32.0647,"lng":118.8029,"region":"CN3201","label":"887年","y0":887,"y1":887,"age":"40","works":2,"events":["旋回舟东下，过金陵，有诗。"],"poems":[],"notes":[]},{"place":{"zh":"常州","modern":"常州","ancient":"","spot":"","en":"Changzhou","enModern":"Changzhou","enAncient":"","enSpot":""},"lat":31.8168,"lng":119.9801,"region":"CN3204","label":"887年","y0":887,"y1":887,"age":"40","works":2,"events":["经常州，有诗。"],"poems":[{"id":42424,"title":"道中逢故人","date":"887年","excerpt":"兰陵市上忽相逢，叙别殷勤兴倍浓。良会若同鸡黍约，暂时不放酒杯空。"},{"id":42321,"title":"自咏","date":"887年","excerpt":"白发三千丈，青春四十年。两牙摇欲落，双膝痹如挛。"}],"notes":[]},{"place":{"zh":"绍兴","modern":"绍兴","ancient":"","spot":"","en":"Shaoxing","enModern":"Shaoxing","enAncient":"","enSpot":""},"lat":30.0365,"lng":120.5867,"region":"CN3306","label":"887年","y0":887,"y1":887,"age":"40","works":0,"events":["至越州，有诗。"],"poems":[],"notes":[]},{"place":{"zh":"丽水南明山、阳明洞","modern":"丽水南明山、阳明洞","ancient":"","spot":"","en":"Lishuinanmingshan、yangmingdong","enModern":"Lishuinanmingshan、yangmingdong","enAncient":"","enSpot":""},"lat":28.473,"lng":119.9295,"region":"CN3311","label":"887年","y0":887,"y1":887,"age":"40","works":2,"events":["游南明山，有诗，作品：《游南明山》。"],"poems":[{"id":42422,"title":"游南明山","date":"887年","excerpt":"久闻南明山，共慕南明寺。几度欲登临，日逐扰人事。"}],"notes":[]},{"place":{"zh":"南京三山","modern":"南京三山","ancient":"","spot":"","en":"Nanjingsanshan","enModern":"Nanjingsanshan","enAncient":"","enSpot":""},"lat":32.0647,"lng":118.8029,"region":"CN3201","label":"888年","y0":888,"y1":888,"age":"41","works":6,"events":["春，由越州返金陵，有诗。"],"poems":[],"notes":[]},{"place":{"zh":"西安","modern":"西安","ancient":"","spot":"","en":"Xian","enModern":"Xian","enAncient":"","enSpot":""},"lat":34.3474,"lng":108.9463,"region":"CN6101","label":"888年","y0":888,"y1":888,"age":"41","works":4,"events":["到金陵后，旋返长安，有诗。"],"poems":[{"id":42290,"title":"留别四首 其一","date":"888年","excerpt":"鹏程三万里，别酒一千钟。好景当三月，春光上国浓。"}],"notes":[]},{"place":{"zh":"阆中","modern":"阆中","ancient":"","spot":"","en":"Langzhong","enModern":"Langzhong","enAncient":"","enSpot":""},"lat":31.5641,"lng":106.0116,"region":"CN511381","label":"889年","y0":889,"y1":889,"age":"42","works":0,"events":["是年在阆州司马任上。"],"poems":[],"notes":[]},{"place":{"zh":"汉中","modern":"汉中","ancient":"","spot":"","en":"Hanzhong","enModern":"Hanzhong","enAncient"
e":"1049年九月","excerpt":""}],"notes":[]},{"place":{"zh":"南昌","modern":"南昌","ancient":"","spot":"","en":"Nanchang"},"lat":28.6877,"lng":115.8645,"region":"CN3601","label":"1050年 - 1051年","y0":1050,"y1":1051,"age":"29-30","works":0,"events":["见张存，料其科名当为天下第一。"],"poems":[],"notes":[]},{"place":{"zh":"开封","modern":"开封","ancient":"","spot":"","en":"Kaifeng"},"lat":34.8029,"lng":114.3139,"region":"CN4102","label":"1052年 - 1053年三月十三日","y0":1052,"y1":1053,"age":"31-32","works":1,"events":["住京师景德寺白土院，秋赋举国学进士。"],"poems":[{"id":175941,"title":"登第后作","date":"1053年三月十三日","excerpt":"文闱数战夺先锋，变化须知自古同。霹雳一声从地起，到头身是白云翁⑴。"}],"notes":[]},{"place":{"zh":"淮阳（宛丘）","modern":"淮阳","ancient":"宛丘","spot":"","en":"Huaiyang (Wanqiu)"},"lat":33.7372,"lng":114.8927,"region":"CN411626","label":"1053年五月一日 - 1054年","y0":1053,"y1":1054,"age":"32-33","works":0,"events":["为将作监丞通判陈州。"],"poems":[],"notes":[]},{"place":{"zh":"开封","modern":"开封","ancient":"","spot":"","en":"Kaifeng"},"lat":34.8029,"lng":114.3139,"region":"CN4102","label":"1055年一月二十一日 - 1063年七月","y0":1055,"y1":1063,"age":"34-42","works":13,"events":["为著作郎直集贤院。","参加赏花钓鱼宴会，作品：《和御制赏花钓鱼》。","仁宗登遐，獬赋诗悼挽，作品：《挽仁宗皇帝辞五首 其四》。"],"poems":[{"id":176210,"title":"慈乌行","date":"1056年五月","excerpt":"鸦鸦林中雏，日晚犹未栖。口衔山樱来，独向林中啼。"},{"id":176113,"title":"二月雪","date":"1057年二月","excerpt":"戊戌二月二十六，忽见大雪漫空来。长老惊叹共相语，非时有雪诚怪哉。"},{"id":176110,"title":"和御制赏花钓鱼","date":"1061年三月","excerpt":"晓日开阊阖，春风满未央。水摇天仗影，花杂御衣香。"},{"id":1178785,"title":"三司续磨勘司题名记","date":"1062年一月八日","excerpt":""},{"id":1178666,"title":"谢知制诰表","date":"1063年","excerpt":""},{"id":176065,"title":"挽仁宗皇帝辞五首 其一","date":"1063年四月","excerpt":"恭俭同尧舜，忧勤固损年。悲风来万国，白日下中天。"},{"id":1178696,"title":"论减仁宗山陵制度状","date":"1063年四月","excerpt":""},{"id":1178703,"title":"上英宗乞绝缪恩","date":"嘉祐八年七月","excerpt":""}],"notes":["中谢。"]},{"place":{"zh":"江陵（荆南）","modern":"江陵","ancient":"荆南","spot":"","en":"Jiangling (Jingnan)"},"lat":30.0481,"lng":112.4312,"region":"CN421024","label":"1063年 - 1065年八月","y0":1063,"y1":1065,"age":"42-44","works":1,"events":["以右司谏知荆南。","上疏言事，作品：《论臣僚极言得失疏》。"],"poems":[{"id":1178674,"title":"论臣僚极言得失疏","date":"1065年八月","excerpt":""}],"notes":[]},{"place":{"zh":"黄冈","modern":"黄冈","ancient":"","spot":"","en":"Huanggang"},"lat":30.4594,"lng":114.8789,"region":"CN4211","label":"1065年","y0":1065,"y1":1065,"age":"44","works":0,"events":["浮舟跨长江而南，道出黄州，往见刺史陈侯。"],"poems":[],"notes":[]},{"place":{"zh":"江陵（荆南）","modern":"江陵","ancient":"荆南","spot":"","en":"Jiangling (Jingnan)"},"lat":30.0481,"lng":112.4312,"region":"CN421024","label":"1066年 - 1067年","y0":1066,"y1":1067,"age":"45-46","works":1,"events":["还判三班院。"],"poems":[{"id":1178781,"title":"黄州重建门记","date":"1066年十一月十七日","excerpt":""}],"notes":[]},{"place":{"zh":"开封","modern":"开封","ancient":"","spot":"","en":"Kaifeng"},"lat":34.8029,"lng":114.3139,"region":"CN4102","label":"1067年九月二十五日 - 1069年","y0":1067,"y1":1069,"age":"46-48","works":4,"events":["上面授以翰林学士，作品：《谢翰林学士表》。","任翰林学士，作品：《安州重修学记》《论种谔擅入西界疏》。","权发遣开封府，作品：《知开封府劄子》。"],"poems":[{"id":1178665,"title":"谢翰林学士表","date":"1067年九月二十五日","excerpt":""},{"id":1178784,"title":"安州重修学记","date":"1068年","excerpt":""},{"id":1178672,"title":"论种谔擅入西界疏","date":"1068年","excerpt":""},{"id":1178697,"title":"知开封府劄子","date":"1069年","excerpt":""}],"notes":["中谢。"]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou"},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1069年五月 - 1069年","y0":1069,"y1":1069,"age":"48","works":11,"events":["断狱不依新法，安石恶之，出为侍读学士、知杭州。","以侍读学士知杭州，作品：《观涛》《舟行次南都遇雨 其一》《题关彦长孤山四照阁》。"],"poems":[{"id":176197,"title":"湖上遇雨","date":"1069年","excerpt":"老龙怒相搏，快雨忽喷洒。天公白羽箭，竦竦射万瓦。"},{"id":176221,"title":"题杭郡阁","date":"1069年","excerpt":"雨影横残虹，秋容映阴日。寒江带暮流，晓角穿云出。"},{"id":175851,"title":"观涛","date":"1069年","excerpt":"怒涛沃日为之阴，下有蛟龙不测深。若比人间恶风浪，长江风浪本无心。"},{"id":176182,"title":"捕蝗","date":"1069年","excerpt":"翁妪妇子相催行，官遣捕蝗赤日里。蝗满田中不见田，穗头栉栉如排指。"},{"id":175849,"title":"舟行次南都遇雨 其一","date":"1069年","excerpt":"雨声飘断忽南去，云势旋生从北流。料得⑴凉风消息近，萧萧只在柳⑵梢头。"},{"id":176025,"title":"杭州喜雪","date":"1069年","excerpt":"吴儿经年不识雪，忽惊大片遮空来。黑帝不分苦荒拙，六花一夜随风开。"},{"id":176219,"title":"题关彦长孤山四照阁","date":"1069年","excerpt":"湖⑴山天下之绝境，群山绕湖千百重。碧笋四插明镜外，此阁正落明镜中。"},{"id":1178733,"title":"御制狄公祭文序","date":"1069年","excerpt":""}],"notes":["原校：此首从《玉壶清话》补入","《两宋名贤小集》作淡淡趁落日"]},{"place":{"zh":"益都（青州）","modern":"益都","ancient":"青州","spot":"","en":"Yidou (Qingzhou)"},"lat":36.7782,"lng":118.441,"region":"CN370781002","label":"1070年四月 - 1071年","y0":1070,"y1":1071,"age":"49-50","works":1,"events":["徙知青州，张先作词送别。"],"poems":[{"id":1178677,"title":"乞罢青苗法状","date":"1070年","excerpt":""}],"notes":[]},{"place":{"zh":"淮安（楚州）","modern":"淮安","ancient":"楚州","spot":"","en":"Huaian (Chuzhou)"},"lat":33.6163,"lng":119.0224,"region":"CN3208","label":"1071年九月 - 1072年九月","y0":1071,"y1":1072,"age":"50-51","works":0,"events":["闲居楚州。","卒于楚州，家贫子弱，十余年后由滕甫助安葬安州故里。"],"poems":[],"notes":[]}],"stages":[{"from":1,"to":2,"title":{"zh":"应城、绍兴","en":"Yingcheng, Shaoxing"},"main":"应城","y0":1030,"y1":1040,"events":["父郑纾登进士第，任应城县主簿。","父任越州司法参军，随父旅居。"]},{"from":3,"to":17,"title":{"zh":"开封、达州、丰城剑池等地","en":"Kaifeng, Dazhou, Fengchengjianchi"},"main":"开封","y0":1045,"y1":1072,"events":["赴京应试。","寓通州城南文殊院读书。","游剑池。","见张存，料其科名当为天下第一。","住京师景德寺白土院，秋赋举国学进士。","为将作监丞通判陈州。"]}],"curated":false}
{"id":27777,"name":"李觏","en":"Li Gou","birth":1009,"death":1059,"period":"北宋","period_en":"Northern Song","dynasty":"song","refs":"《宋人年谱丛刊》","compilers":"","km":2369,"places":4,"works":12,"stops":[{"place":{"zh":"南城","modern":"南城","ancient":"","spot":"","en":"Nancheng","enModern":"Nancheng","enAncient":"","enSpot":""},"lat":27.5747,"lng":116.6441,"region":"CN361021","label":"1009年 - 1030年","y0":1009,"y1":1030,"age":"1-22","works":1,"events":["是年，生于南城。"],"poems":[],"notes":[]},{"place":{"zh":"开封（东京）","modern":"开封","ancient":"东京","spot":"","en":"Dongjing (Kaifeng)","enModern":"Kaifeng","enAncient":"Dongjing","enSpot":""},"lat":34.8029,"lng":114.3139,"region":"CN4102","label":"1041年 - 1042年","y0":1041,"y1":1042,"age":"33-34","works":5,"events":["有文。"],"poems":[{"id":1164698,"title":"上吴舍人书","date":"1041年","excerpt":""},{"id":1164699,"title":"上王内翰书","date":"1041年","excerpt":""},{"id":1164696,"title":"上富舍人书","date":"1041年","excerpt":""},{"id":1164714,"title":"寄上富相公书","date":"1041年","excerpt":""},{"id":1164702,"title":"上慎殿丞书","date":"1041年","excerpt":""}],"notes":["赵瑞华。"]},{"place":{"zh":"上饶","modern":"上饶","ancient":"","spot":"","en":"Shangrao","enModern":"Shangrao","enAncient":"","enSpot":""},"lat":28.4609,"lng":117.95,"region":"CN3611","label":"1046年","y0":1046,"y1":1046,"age":"38","works":6,"events":["游信州，作诗、文多篇。"],"poems":[{"id":1164941,"title":"弋阳县学铭","date":"1046年","excerpt":"庆历恢儒，首自东都，爰及郡县，筑宫授徒。地不患小，权不在大，系乎其人，乃勤乃懈。"},{"id":124042,"title":"闻女子疟疾偶书二十四韵寄示","date":"1046年","excerpt":"昨日家人来，言汝苦寒热。想由卑湿地，颇失饮食节。"},{"id":123973,"title":"题灵阳宫","date":"1046年","excerpt":"费君投杖处，行客过彷徨。水面风雷散，沙头草木荒。"},{"id":123868,"title":"龟峰精舍","date":"1046年","excerpt":"去县二十里，路平时正春。四山唯有石，一寺更无尘。"},{"id":123808,"title":"葛陂怀古","date":"1046年","excerpt":"长房化去已千年，鬼魅纷纷不畏天。老鳖若来为太守，何人杀向葛陂边。"},{"id":123960,"title":"葛陂逢何道士","date":"1046年","excerpt":"十数年前别我行，相逢犹是旧颜形。琴声渐古听来淡，药味虽凡试最灵。"}],"notes":["赵瑞华。"]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1050年","y0":1050,"y1":1050,"age":"42","works":0,"events":["赴范仲淹招于杭州，范仲淹再荐举于朝。"],"poems":[],"notes":[]},{"place":{"zh":"南城","modern":"南城","ancient":"","spot":"","en":"Nancheng","enModern":"Nancheng","enAncient":"","enSpot":""},"lat":27.5747,"lng":116.6441,"region":"CN361021","label":"1059年八月","y0":1059,"y1":1059,"age":"51","works":0,"events":["八月，卒于家。"],"poems":[],"notes":[]}],"stages":[{"from":1,"to":1,"title":{"zh":"开封","en":"Kaifeng"},"main":"开封","y0":1041,"y1":1042,"events":["有文。"]},{"from":2,"to":2,"title":{"zh":"上饶","en":"Shangrao"},"main":"上饶","y0":1046,"y1":1046,"events":["游信州，作诗、文多篇。"]},{"from":3,"to":3,"title":{"zh":"杭州","en":"Hangzhou"},"main":"杭州","y0":1050,"y1":1050,"events":["赴范仲淹招于杭州，范仲淹再荐举于朝。"]},{"from":4,"to":4,"title":{"zh":"南城","en":"Nancheng"},"main":"南城","y0":1059,"y1":1059,"events":["八月，卒于家。"]}],"curated":false}
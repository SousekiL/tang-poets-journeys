pot":"","en":"Changjiang (Pengxi)","enModern":"Pengxi","enAncient":"Changjiang","enSpot":""},"lat":30.764,"lng":105.714,"region":"CN510921","label":"882年","y0":882,"y1":882,"age":"37","works":1,"events":["下第出蜀，绕道遂州，作品：《经贾岛墓》。"],"poems":[{"id":32538,"title":"经贾岛墓","date":"882年","excerpt":"谪宦自麻衣，衔冤至死时。山根三尺墓，人口数联诗。"}],"notes":[]},{"place":{"zh":"扬州","modern":"扬州","ancient":"","spot":"","en":"Yangzhou","enModern":"Yangzhou","enAncient":"","enSpot":""},"lat":32.3999,"lng":119.4191,"region":"CN321","label":"882年","y0":882,"y1":882,"age":"37","works":5,"events":["宦游至扬州《维扬逢诗友张乔》《维扬冬末寄幕中二从事》。"],"poems":[{"id":32567,"title":"贺顾云侍御府主与子弟奏官","date":"882年","excerpt":"青桂朱袍不贺兄，贺兄荣是见儿荣。孝经始向堂前彻，官诰当从幕下迎。"},{"id":32424,"title":"顾云侍御出二子请诗因遗一绝","date":"882年","excerpt":"二雏毛骨秀仍奇，小小能吟大大诗。想得月中仙桂树，各从生日长新枝。"},{"id":32637,"title":"维扬逢诗友张乔","date":"882年","excerpt":"天下方多事，逢君得话诗。直应吾道在，未觉国风衰。"},{"id":32636,"title":"维扬春日再遇孙侍御","date":"882年","excerpt":"本为荣家不为身，读书谁料转家贫。三年行却千山路，两地思归一主人。"},{"id":32635,"title":"维扬冬末寄幕中二从事","date":"882年","excerpt":"闻道长溪尉，相留一馆闲。已投三寸管，尚隔几重山。"}],"notes":["还有首同名为《维扬冬末寄幕中二从事》（闻道长溪尉）的诗，作于本年。","敕下时，年七岁。"]},{"place":{"zh":"宣城","modern":"宣城","ancient":"","spot":"","en":"Xuancheng","enModern":"Xuancheng","enAncient":"","enSpot":""},"lat":30.9466,"lng":118.7652,"region":"CN3418","label":"882年十二","y0":882,"y1":882,"age":"37","works":1,"events":["遇乱作诗记之。"],"poems":[{"id":32607,"title":"旅泊遇郡中叛乱示同志","date":"882年十二","excerpt":"握手相看谁敢言，军家刀剑在腰边。遍搜宝货无藏处，乱杀平人不怕天。"}],"notes":["一作悲"]},{"place":{"zh":"杭州（钱塘）","modern":"杭州","ancient":"钱塘","spot":"","en":"Qiantang (Hangzhou)","enModern":"Hangzhou","enAncient":"Qiantang","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"888年","y0":888,"y1":888,"age":"43","works":2,"events":["再游越中。"],"poems":[{"id":32658,"title":"献钱塘县罗著作判官","date":"888年","excerpt":"还乡夫子遇贤侯，抚字情知不自由。莫把一名专懊恼，放教双眼绝冤雠。"},{"id":32618,"title":"钱塘别罗隐","date":"888年","excerpt":"故国看看远，前程计在谁。五更听角后，一叶渡江时。"}],"notes":[]},{"place":{"zh":"宁波","modern":"宁波","ancient":"","spot":"","en":"Ningbo","enModern":"Ningbo","enAncient":"","enSpot":""},"lat":29.8802,"lng":121.5567,"region":"CN3302","label":"888年","y0":888,"y1":888,"age":"43","works":1,"events":["再游越中，作品：《别四明钟尚书》。"],"poems":[{"id":32508,"title":"别四明钟尚书","date":"888年","excerpt":"九华天际碧嵯峨，无奈春来入梦何。难与英雄论教化，却思猿鸟共烟萝。"}],"notes":["由于杜荀鹤两次游越，以下三首诗写作时间难以确定：《浙中逢诗友》、《登天台寺》、《经严陵钓台》天台寺在今浙江天台县天台山。"]},{"place":{"zh":"西安（长安）","modern":"西安","ancient":"长安","spot":"","en":"Changan (Xian)","enModern":"Xian","enAncient":"Changan","enSpot":""},"lat":34.3474,"lng":108.9463,"region":"CN6101","label":"890年 - 891年","y0":890,"y1":891,"age":"45-46","works":5,"events":["离山赴举。","与张曙等唱和，作品：《依韵次同年张曙先辈见寄之什》《晚春寄同年张曙先辈》。"],"poems":[{"id":32500,"title":"乱后出山逢高员外","date":"890年","excerpt":"自从乱后别京关，一入烟萝十五年。重出故山生白发，却装新卷谒清贤。"},{"id":32522,"title":"近试投所知","date":"890年","excerpt":"白发随梳落，吟怀说向谁。敢辞成事晚，自是出山迟。"},{"id":32396,"title":"关试后筵上别同人","date":"891年","excerpt":"日午离筵到夕阳，明朝秦地与吴乡。同年多是长安客，不信行人欲断肠。"},{"id":32525,"title":"依韵次同年张曙先辈见寄之什","date":"891年","excerpt":"天上诗名天下传，引来齐列玉皇前。大仙录后头无雪，至药成来灶绝烟。"},{"id":32633,"title":"晚春寄同年张曙先辈","date":"891年","excerpt":"莫将时态破天真，祗合高歌醉过春。易落好花三个月，难留浮世百年身。"}],"notes":["高员外，不详。","一作修"]},{"place":{"zh":"青阳九华山","modern":"青阳九华山","ancient":"","spot":"","en":"Qingyangjiuhuashan","enModern":"Qingyangjiuhuashan","enAncient":"","enSpot":""},"lat":30.6457,"lng":117.8539,"region":"CN341723","label":"891年","y0":891,"y1":891,"age":"46","works":1,"events":["因世乱复还旧山。"],"poems":[{"id":32663,"title":"辞座主侍郎","date":"891年","excerpt":"一饭尚怀感，况攀高桂枝。此恩无报处，故国远归时。"}],"notes":[]},{"place":{"zh":"开封（陈留）","modern":"开封","ancient":"陈留","spot":"","en":"Chenliu (Kaifeng)","enModern":"Kaifeng","enAncient":"Chenliu","enSpot":""},"lat":34.8029,"lng":114.3139,"region":"CN4102","label":"891年 - 901年","y0":891,"y1":901,"age":"46-56","works":1,"events":["过夷门曾见朱温。","为梁王朱温赋“无云雨诗”，作品：《梁王坐上赋无云雨》。"],"poems":[{"id":32429,"title":"梁王坐上赋无云雨","date":"901年","excerpt":"同是乾坤事不同，雨丝飞洒日轮中。若教阴朗长相似，争表梁王造化功。"}],"notes":["一作翳"]},{"place":{"zh":"宣城","modern":"宣城","a
n","enModern":"Hunan","enAncient":"","enSpot":""},"lat":28.1183,"lng":112.99,"region":"CN43","label":"872年","y0":872,"y1":872,"age":"27","works":1,"events":["初游湖湘。"],"poems":[{"id":32544,"title":"将游湘湖有作","date":"872年","excerpt":"一家相别意，不得不潸然。远作南方客，初登上水船。"}],"notes":[]},{"place":{"zh":"长沙","modern":"长沙","ancient":"","spot":"","en":"Changsha","enModern":"Changsha","enAncient":"","enSpot":""},"lat":28.2518,"lng":113.0875,"region":"CN430121","label":"873年","y0":873,"y1":873,"age":"28","works":1,"events":["干谒潭州刺史王凝。"],"poems":[{"id":32655,"title":"献长沙王侍郎","date":"873年","excerpt":"文星渐见射台星，皆仰为霖沃众情。天泽逼来逢圣主，辞林盛去得书生。"}],"notes":[]},{"place":{"zh":"西安（长安）","modern":"西安","ancient":"长安","spot":"","en":"Changan (Xian)","enModern":"Xian","enAncient":"Changan","enSpot":""},"lat":34.3474,"lng":108.9463,"region":"CN6101","label":"875年","y0":875,"y1":875,"age":"30","works":1,"events":["离家赴京应进士试。"],"poems":[{"id":32421,"title":"离家","date":"875年","excerpt":"丈夫三十身如此，疲马离乡懒著鞭。槐柳路长愁杀我，一枝蝉到一枝蝉。"}],"notes":["一作今"]},{"place":{"zh":"九江（浔阳）","modern":"九江","ancient":"浔阳","spot":"","en":"Xunyang (Jiujiang)","enModern":"Jiujiang","enAncient":"Xunyang","enSpot":""},"lat":29.7113,"lng":116.008,"region":"CN3604","label":"875年","y0":875,"y1":875,"age":"30","works":1,"events":["干谒江州刺史。"],"poems":[],"notes":[]},{"place":{"zh":"石台（石埭）","modern":"石台","ancient":"石埭","spot":"","en":"Shidai (Shitai)","enModern":"Shitai","enAncient":"Shidai","enSpot":""},"lat":30.2166,"lng":117.4926,"region":"CN341722","label":"876年","y0":876,"y1":876,"age":"31","works":1,"events":["落第返乡。"],"poems":[],"notes":[]},{"place":{"zh":"长沙","modern":"长沙","ancient":"","spot":"","en":"Changsha","enModern":"Changsha","enAncient":"","enSpot":""},"lat":28.2518,"lng":113.0875,"region":"CN430121","label":"876年","y0":876,"y1":876,"age":"31","works":2,"events":["再游湖湘，干谒裴瓒。"],"poems":[{"id":32474,"title":"冬末投长沙裴侍郎","date":"876年","excerpt":"欲露尘中事，其如不易言。家山一离别，草树匝春暄。"},{"id":32516,"title":"投长沙裴侍郎","date":"876年","excerpt":"此身虽贱道长存，非谒朱门谒孔门。秪望至公将卷读，不求
nModern":"Poyang","enAncient":"","enSpot":""},"lat":29.0113,"lng":116.71,"region":"CN361128","label":"860年","y0":860,"y1":860,"age":"31","works":1,"events":["此年左右至饶州或抚州，三月无所诣。刺史蔡京率官属就见，龟蒙拂衣而去，《马当山铭》或作于此时。"],"poems":[{"id":1376115,"title":"马当山铭","date":"860年","excerpt":""}],"notes":["《甫里集》卷一八。"]},{"place":{"zh":"抚州","modern":"抚州","ancient":"","spot":"","en":"Fuzhou","enModern":"Fuzhou","enAncient":"","enSpot":""},"lat":27.9536,"lng":116.3646,"region":"CN361","label":"860年","y0":860,"y1":860,"age":"31","works":0,"events":["此年左右至饶州或抚州，三月无所诣。"],"poems":[],"notes":[]},{"place":{"zh":"苏州（长洲）","modern":"苏州","ancient":"长洲","spot":"","en":"Zhangzhou (Suzhou)","enModern":"Suzhou","enAncient":"Zhangzhou","enSpot":""},"lat":31.3046,"lng":120.5896,"region":"CN3205","label":"860年","y0":860,"y1":860,"age":"31","works":1,"events":["陆龟蒙居苏州家中，《中酒赋》或作于此时。"],"poems":[],"notes":[]},{"place":{"zh":"建德","modern":"建德","ancient":"","spot":"","en":"Jiande","enModern":"Jiande","enAncient":"","enSpot":""},"lat":29.4811,"lng":119.2876,"region":"CN330182","label":"865年三月 - 865年","y0":865,"y1":865,"age":"36","works":4,"events":["在睦州，与刺史陆墉游，有诗，作品：《引泉诗》。"],"poems":[{"id":34383,"title":"引泉诗","date":"865年三月","excerpt":"上嗣位六载，吾宗刺桐川。余来拜旌戟，诏下之明年。"},{"id":34347,"title":"新定陪太守一百五夜南馆玩月","date":"865年","excerpt":"风雨教春处处伤，一宵云尽见沧浪。全无片烛侵光彩，只有清滩助雪霜。"},{"id":34523,"title":"寄淮南郑宝书记","date":"865年","excerpt":"记室千年翰墨孤，唯君才学似应徐。五丁驱得神功尽，二酉搜来秘检疏。"},{"id":34055,"title":"严光钓台","date":"865年","excerpt":"片帆竿外揖清风，石立云孤万古中。不是狂奴为故态，仲华争得黑头公。"}],"notes":["《甫里集》卷三。","《全唐诗》卷六二六。"]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"866年","y0":866,"y1":866,"age":"37","works":0,"events":["在杭州，与丁翰之游。"],"poems":[],"notes":[]},{"place":{"zh":"苏州（长洲）","modern":"苏州","ancient":"长洲","spot":"","en":"Zhangzhou (Suzhou)","enModern":"Suzhou","enAncient":"Zhangzhou","enSpot":""},"lat":31.3046,"lng":120.5896,"region":"CN3205","label":"868年 - 870年","y0":868,"y1":870,"age":"39-41","works":54,"events":["在苏州，其《幽居赋》或作于是年前后。","在病中，皮日休作诗赠陆龟蒙，以安抚其受伤之心。陆龟蒙和之。作品：《袭美先辈以龟蒙所献五百言既蒙见和复示荣唱至于千字提奖之重蔑有称实再抒鄙怀用伸酬谢》。","吴中淫雨不息。皮日休有《吴中苦雨，因书一百韵寄鲁望》，陆龟蒙和之，作品：《奉酬袭美先辈吴中苦雨一百韵》。"],"poems":[],"notes":[]},{"place":{"zh":"镇江北固山","modern":"镇江北固山","ancient":"","spot":"","en":"Zhenjiangbeigushan","enModern":"Zhenjiangbeigushan","enAncient":"","enSpot":""},"lat":32.1957,"lng":119.4315,"region":"CN3211","label":"870年","y0":870,"y1":870,"age":"41","works":0,"events":["早秋游润州，登北固山。"],"poems":[],"notes":[]},{"place":{"zh":"苏州（长洲）","modern":"苏州","ancient":"长洲","spot":"","en":"Zhangzhou (Suzhou)","enModern":"Suzhou","enAncient":"Zhangzhou","enSpot":""},"lat":31.3046,"lng":120.5896,"region":"CN3205","label":"870年 - 871年","y0":870,"y1":871,"age":"41-42","works":134,"events":["是年，皮陆唱和规模不断扩大。唱和友中除羊昭业、张贲等之外，尚有李縠、颜萱、司马都、郑璧、穰嵩起、崔璞等。与陆龟蒙交游者有李中秀、何道士、杨台文、杨鼎文等，有诗《怀杨台文杨鼎文二秀才》。","皮陆唱和，本年，陆龟蒙有《渔具诗》十五咏，皮日休有《添渔具诗》五首，陆龟蒙和之。陆龟蒙有《樵人十咏》，皮日休和之。皮日休有《酒中十咏》，陆龟蒙和之；陆龟蒙有《添酒中六咏》，皮日休和之。皮日修有《茶中杂咏》十首，陆龟蒙和之，作品：《渔具诗 其十四 舴艋》。"],"poems":[],"notes":[]},{"place":{"zh":"湖州","modern":"湖州","ancient":"","spot":"","en":"Huzhou","enModern":"Huzhou","enAncient":"","enSpot":""},"lat":30.899,"lng":120.0946,"region":"CN3305","label":"872年 - 874年","y0":872,"y1":874,"age":"43-45","works":0,"events":["在湖州，从张搏游，有诗。"],"poems":[],"notes":["《全唐诗》卷六二九。"]},{"place":{"zh":"合肥","modern":"合肥","ancient":"","spot":"","en":"Hefei","enModern":"Hefei","enAncient":"","enSpot":""},"lat":31.8269,"lng":117.2354,"region":"CN3401","label":"875年二月","y0":875,"y1":875,"age":"46","works":0,"events":["二月以后，随张搏在庐州。"],"poems":[],"notes":[]},{"place":{"zh":"苏州","modern":"苏州","ancient":"","spot":"","en":"Suzhou","enModern":"Suzhou","enAncient":"","enSpot":""},"lat":31.3046,"lng":120.5896,"region":"CN3205","label":"876年七月","y0":876,"y1":876,"age":"47","works":1,"events":["陆龟蒙随张搏由庐州转苏州，本年秋，罗隐有诗寄陆龟蒙。"],"poems":[],"notes":[]},{"place":{"zh":"湖州","modern":"湖州","ancient":"","spot":"","en":"Huzhou","enModern":"Huzhou","enAncient":"","enSpot":""},"lat":30.899,"lng":120.0946,"region":"CN3305","label":"877年","y0":877,"y1":877,"age":"48","works":0,"events":["冬，陆龟蒙往湖州拜谒刺史郑仁规，有酬唱之什。"],"poems":[],"notes":[]},{"place":{"zh":"苏州","modern":"苏州","ancient":"","spot":"","en":"Suzhou","enModern":"Suzhou","enAncient":"","enSpot":""},"lat":31.3046,"lng":120.5896,"region":"CN3205","label":"878年 - 880年","y0":878,"y1":880,"age":"49-51","works":92,"events":["春归苏州，修震泽别业。","春，陆龟蒙卧病于苏州太湖湖滨、松江畔之震泽别业，又躬耕于松江南岸之甫里私田中，人或讥之，号为甫里先生，又自为捕鱼松江中，又种药，又勤于校读、写作，作品：《自遣诗三十首 其三》《自遣诗三十首 其十三》。","陆龟蒙本年其他作品，作品：《说凤尾诺》。"],"poems":[],"notes":[]},{"place":{"zh":"镇江","modern":"镇江","ancient":"","spot":"","en":"Zhenjiang","enModern":"Zhenjiang","enAncient":"","enSpot":""},"lat":32.1957,"lng":119.4315,"region":"CN3211","label":"880年","y0":880,"y1":880,"age":"51","works":1,"events":["陆龟蒙隐居震泽别业数年中，某春至润州，参观文宣王庙韩滉《春秋通例》时刻。"],"poems":[{"id":34393,"title":"庆封宅古井行","date":"880年","excerpt":"古甓团团藓花碧，鼎渫寒泉深百尺。江南戴白尽能言，此地曾为庆封宅。"}],"notes":["《甫里集》卷一七。","一作滢"]},{"place":{"zh":"苏州","modern":"苏州","ancient":"","spot":"","en":"Suzhou","enModern":"Suzhou","enAncient":"","enSpot":""},"lat":31.3046,"lng":120.5896,"region":"CN3205","label":"880年五月 - 881年","y0":880,"y1":881,"age":"51-52","works":26,"events":["本年五月或作《杞菊赋》，序中言及在震泽别业数年以读经为事。","本年五月或作《复友生论文书》一文，作品：《复友生论文书》。","本年五月或作《说凤尾诺》一文，作品：《说凤尾诺》。","官府殆以陆龟蒙不合作，讥以“散人”之目，陆龟蒙受之，自号“江湖散人”，有《江湖散人歌》、《江湖散人传》以志之，作品：《江湖散人歌》《江湖散人歌》《甫里先生传》。","陆龟蒙病居甫里，其卒年或亦在本年，传云朝廷以左拾遗征之，诏下之日而卒。罗隐、韦庄、陆希声、吴融、皮日休、颜荛等作诗文以祭之。"],"poems":[],"notes":[]}],"stages":[{"from":1,"to":4,"title":{"zh":"溧阳、苏州、宣城等地","en":"Liyang, Suzhou, Xuancheng"},"main":"溧阳","y0":839,"y1":854,"events":["陆龟蒙大概随父在潥阳，闻孟郊故事于白头书佐。","在故乡长洲家居。","或于是年前后从豆庐瑑游宣城。","本年或自润州取解，第一次赴京应举。"]},{"from":5,"to":8,"title":{"zh":"洛阳、登封嵩山、西安","en":"Luoyang, Dengfengsongshan, Xian"},"main":"洛阳","y0":855,"y1":859,"events":["或参加科举考试不利，流连于两京地区隐居读书。","参加科考，不第。","春二月，落第后由长安东返，先是在洛阳嵩山停留，梦游甘露寺。"]},{"from":9,"to":13,"title":{"zh":"镇江、杭州、鄱阳等地","en":"Zhenjiang, Hangzhou, Poyang"},"main":"镇江","y0":859,"y1":860,"events":["春末夏初，到达润州，游甘露寺，有诗。","本年左右有桐江之行，有诗，又与进士严子重相交。","此年左右至饶州或抚州，三月无所诣。刺史蔡京率官属就见，龟蒙拂衣而去，《马当山铭》或作于此时。","此年左右至饶州或抚州，三月无所诣。","陆龟蒙居苏州家中，《中酒赋》或作于此时。"]},{"from":14,"to":25,"title":{"zh":"建德、杭州、苏州等地","en":"Jiande, Hangzhou, Suzhou"},"main":"苏州","y0":865,"y1":881,"events":["在睦州，与刺史陆墉游，有诗，作品：《引泉诗》。","在杭州，与丁翰之游。","在苏州，其《幽居赋》或作于是年前后。","在病中，皮日休作诗赠陆龟蒙，以安抚其受伤之心。陆龟蒙和之。作品：《袭美先辈以龟蒙所献五百言既蒙见和复示荣唱至于千字提奖之重蔑有称实再抒鄙怀用伸酬谢》。","吴中淫雨不息。皮日休有《吴中苦雨，因书一百韵寄鲁望》，陆龟蒙和之，作品：《奉酬袭美先辈吴中苦雨一百韵》。","早秋游润州，登北固山。"]}],"curated":false}
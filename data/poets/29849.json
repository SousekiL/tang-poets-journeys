{"id":29849,"name":"蔡襄","en":"Cai Xiang","birth":1012,"death":1067,"period":"北宋","period_en":"Northern Song","dynasty":"song","refs":"蒋维锬《蔡襄年谱》","compilers":"陈鑫","km":24785,"places":43,"works":450,"stops":[{"place":{"zh":"仙游","modern":"仙游","ancient":"","spot":"","en":"Xianyou","enModern":"Xianyou","enAncient":"","enSpot":""},"lat":25.3684,"lng":118.6983,"region":"CN350322","label":"1012年二月十二日 - 1029年","y0":1012,"y1":1029,"age":"1-18","works":0,"events":["蔡襄生。"],"poems":[],"notes":[]},{"place":{"zh":"安庆","modern":"安庆","ancient":"","spot":"","en":"Anqing","enModern":"Anqing","enAncient":"","enSpot":""},"lat":30.5486,"lng":117.0701,"region":"CN3408","label":"1029年","y0":1029,"y1":1029,"age":"18","works":1,"events":["蔡襄过舒州桐城得梦兆，有诗。"],"poems":[{"id":249102,"title":"梦中作","date":"1029年","excerpt":"白玉楼台第一天，琪花风静彩鸾眠。谁人得似秦台女，吹彻云箫上紫烟。"}],"notes":[]},{"place":{"zh":"芜湖","modern":"芜湖","ancient":"","spot":"","en":"Wuhu","enModern":"Wuhu","enAncient":"","enSpot":""},"lat":31.3588,"lng":118.4396,"region":"CN3402","label":"1029年","y0":1029,"y1":1029,"age":"18","works":0,"events":["蔡襄到芜湖拜会凌景阳，凌为之引荐参加开封府试。"],"poems":[],"notes":[]},{"place":{"zh":"开封","modern":"开封","ancient":"","spot":"","en":"Kaifeng","enModern":"Kaifeng","enAncient":"","enSpot":""},"lat":34.8029,"lng":114.3139,"region":"CN4102","label":"1029年","y0":1029,"y1":1029,"age":"18","works":0,"events":["开封府试榜发，襄为第一，弟高未得举。"],"poems":[{"id":249059,"title":"和子发","date":"1029年","excerpt":"空梁诗板岁年多，唯有秋虫占作窠。闻道故人时拂拭，此生无奈旧情何。"}],"notes":[]},{"place":{"zh":"江阴悟空院","modern":"江阴悟空院","ancient":"","spot":"","en":"Jiangyinwukongyuan","enModern":"Jiangyinwukongyuan","enAncient":"","enSpot":""},"lat":31.9258,"lng":120.292,"region":"CN320281","label":"1029年","y0":1029,"y1":1029,"age":"18","works":1,"events":["经凌景阳介绍，蔡襄寄寓江阴悟空院读书，以备明年尚书省礼部会试。"],"poems":[],"notes":[]},{"place":{"zh":"开封","modern":"开封","ancient":"","spot":"","en":"Kaifeng","enModern":"Kaifeng","enAncient":"","enSpot":""},"lat":34.8029,"lng":114.3139,"region":"CN4102","label":"1030年","y0":1030,"y1":1030,"age":"19","works":0,"events":["蔡襄赴京参加省试和殿试，登进士甲科第十名。"],"poems":[],"notes":[]},{"place":{"zh":"江阴","modern":"江阴","ancient":"","spot":"","en":"Jiangyin","enModern":"Jiangyin","enAncient":"","enSpot":""},"lat":31.9258,"lng":120.292,"region":"CN320281","label":"1030年","y0":1030,"y1":1030,"age":"19","works":0,"events":["蔡襄还乡时复途次江阴，由凌景阳撮婚于葛惟明之季女。"],"poems":[],"notes":[]},{"place":{"zh":"南平","modern":"南平","ancient":"","spot":"","en":"Nanping","enModern":"Nanping","enAncient":"","enSpot":""},"lat":26.6477,"lng":118.1843,"region":"CN3507","label":"1030年","y0":1030,"y1":1030,"age":"19","works":0,"events":["蔡襄过延平，题诗黯淡院。"],"poems":[],"notes":[]},{"place":{"zh":"莆田","modern":"莆田","ancient":"","spot":"","en":"Putian","enModern":"Putian","enAncient":"","enSpot":""},"lat":25.46,"lng":119.0142,"region":"CN3503","label":"1030年","y0":1030,"y1":1030,"age":"19","works":0,"events":["蔡襄过囊山，入寺叩宏法师。"],"poems":[],"notes":[]},{"place":{"zh":"仙游","modern":"仙游","ancient":"","spot":"","en":"Xianyou","enModern":"Xianyou","enAncient":"","enSpot":""},"lat":25.3684,"lng":118.6983,"region":"CN350322","label":"1030年","y0":1030,"y1":1030,"age":"19","works":0,"events":["蔡襄回乡。"],"poems":[],"notes":[]},{"place":{"zh":"惠安","modern":"惠安","ancient":"","spot":"","en":"Huian","enModern":"Huian","enAncient":"","enSpot":""},"lat":25.037,"lng":118.8034,"region":"CN350521","label":"1030年","y0":1030,"y1":1030,"age":"19","works":0,"events":["蔡襄曾到惠安拜见舅父，撰书《惠安灵光院记》。"],"poems":[],"notes":[]},{"place":{"zh":"开封","modern":"开封","ancient":"","spot":"","en":"Kaifeng","enModern":"Kaifeng","enAncient":"","enSpot":""},"lat":34.8029,"lng":114.3139,"region":"CN4102","label":"1031年春","y0":1031,"y1":1031,"age":"20","works":0,"events":["春，蔡襄赴吏部铨选，受漳州军事判官。"],"poems":[],"notes":[]},{"place":{"zh":"江阴","modern":"江阴","ancient":"","spot":"","en":"Jiangyin","enModern":"Jiangyin","enAncient":"","enSpot":""},"lat":31.9258,"lng":120.292,"region":"CN320281","label":"1031年","y0":1031,"y1":1031,"age":"20","works":0,"events":["蔡襄回程经江阴，迎娶葛氏夫人，葛氏之从兄弟葛密作诗赠蔡襄。"],"poems":[],"notes":[]},{"place":{"zh":"漳州","modern":"漳州","ancient":"","spot":"","en":"Zhangzhou","enModern":"Zhangzhou","enAncient":"","enSpot":""},"lat":24.5192,"lng":117.6538,"region":"CN3506","label":"1031年 - 1034年","y0":1031,"y1":1034,"age":"20-23","works":19,"events":["蔡襄在漳州军事判官任。","蔡襄作《上运使王殿院书》反映福建民情，作品：《上运使王殿院书》。"],"poems":[{"id":1167455,"title":"士伸知己赋","date":"1031年","excerpt":""},{"id":249422,"title":"漳南十咏 其一 龙台","date":"1032年","excerpt":"试看初日照龙台，白玉堂高锦障开。树色一番连雨净，溪光几曲抱山来。"},{"id":249296,"title":"序宾亭","date":"1032年","excerpt":"师律先忧寄，朝家此得人。门庭环剑佩，胸胆贯星辰。"},{"id":249225,"title":"奉酬王知县赏春不与以诗见赠","date":"1032年","excerpt":"仙陬翠观尽繁英，朱白相兼照眼明。池浸岚光生晚碧，鸟惊人语断春声。"},{"id":249058,"title":"净众院尝荔支","date":"1032年","excerpt":"霞树珠林暑后新，直疑天意别留春。京华百世争鲜贵，自是芳根著海滨。"},{"id":1167872,"title":"上运使王殿院书","date":"1032年","excerpt":""},{"id":249254,"title":"耕园驿佛桑花","date":"1033年","excerpt":"溪馆初寒似早春，寒花相倚醉于人。可怜万木彫零尽，独见繁枝烂熳新。"},{"id":249417,"title":"溪行","date":"1033年","excerpt":"秋色已寥落，清溪才此行。船移酒杯侧，鱼得鲙刀鸣。"}],"notes":["蔡本作纷"]},{"place":{"zh":"仙游","modern":"仙游","ancient":"","spot":"","en":"Xianyou","enModern":"Xianyou","enAncient":"","enSpot":""},"lat":25.3684,"lng":118.6983,"region":"CN350322","label":"1034年 - 1036年春","y0":1034,"y1":1036,"age":"23-25","works":0,"events":["蔡襄从漳州秩满罢归，适弟高登第还乡，阖家荣庆。"],"poems":[],"notes":[]},{"place":{"zh":"江阴","modern":"江阴","ancient":"","spot":"","en":"Jiangyin","enModern":"Jiangyin","enAncient":"","enSpot":""},"lat":31.9258,"lng":120.292,"region":"CN320281","label":"1036年","y0":1036,"y1":1036,"age":"25","works":0,"events":["蔡襄至江阴，将葛氏母女暂寄岳母家。"],"poems":[],"notes":[]},{"place":{"zh":"漯河","modern":"漯河","ancient":"","spot":"","en":"Tahe","enModern":"Tahe","enAncient":"","enSpot":""},"lat":33.5877,"lng":114.0232,"region":"CN4111","label":"1036年","y0":1036,"y1":1036,"age":"25","works":1,"events":["蔡襄过武阳，作《新泉记》。"],"poems":[{"id":1168105,"title":"新泉记","date":"1036年","excerpt":""}],"notes":["颍昌府有舞阳而无武阳。"]},{"place":{"zh":"开封","modern":"开封","ancient":"","spot":"","en":"Kaifeng","enModern":"Kaifeng","enAncient":"","enSpot":""},"lat":34.8029,"lng":114.3139,"region":"CN4102","label":"1036年 - 1036年七月","y0":1036,"y1":1036,"age":"25","works":5,"events":["蔡襄抵京都，待选。"],"poems":[{"id":249334,"title":"四贤一不肖诗 范希文","date":"1036年五月","excerpt":"中朝鸾鹤何仪仪，慷慨大体能者谁。之人起家用儒业，驰骋古今无所遗。"},{"id":249332,"title":"四贤一不肖诗 余安道","date":"1036年五月","excerpt":"南方之强君子居，卓然安道襟韵孤。词科判等屡得隽，呀然鼓焰天地垆。"},{"id":249331,"title":"四贤一不肖诗 尹师鲁","date":"1036年五月","excerpt":"君子道合久以成，小人利合久以倾。世道下衰交以利，遂使周雅称嘤鸣。"},{"id":249333,"title":"四贤一不肖诗 欧阳永叔","date":"1036年五月","excerpt":"先民至论推天常，补衮扶世为儒方。圜冠博带不知本，樗栎安可施青黄。"},{"id":249335,"title":"四贤一不肖诗 高若讷","date":"1036年五月","excerpt":"人禀天地中和生，气之正者为诚明。诚明所钟皆贤杰，从容中道无攲倾。"}],"notes":[]},{"place":{"zh":"洛阳","modern":"洛阳","ancient":"","spot":"","en":"Luoyang","enModern":"Luoyang","enAncient":"","enSpot":""},"lat":34.6244,"lng":112.46,"region":"CN4103","label":"1036年七月 - 1036年秋","y0":1036,"y1":1036,"age":"25","works":2,"events":["蔡襄在西京留守推官任上，致书太常博士王洙，作《答王太祝书》。"],"poems":[{"id":1167876,"title":"答王太祝书","date":"1036年七月","excerpt":""},{"id":1167457,"title":"慈竹赋","date":"1036年秋","excerpt":""}],"notes":[]},{"place":{"zh":"江阴","modern":"江阴","ancient":"","spot":"","en":"Jiangyin","enModern":"Jiangyin","enAncient":"","enSpot":""},"lat":31.9258,"lng":120.292,"region":"CN320281","label":"1036年冬","y0":1036,"y1":1036,"age":"25","works":0,"events":["蔡襄赴江阴搬取家眷，途中遇奉诏还台之新授侍御史庞籍，言及仙游老儒茅知至及漳、泉、莆三郡税丁事。"],"poems":[],"notes":[]},{"place":{"zh":"杭州径山","modern":"杭州径山","ancient":"","spot":"","en":"Hangzhoujingshan","enModern":"Hangzhoujingshan","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1036年十二月","y0":1036,"y1":1036,"age":"25","works":1,"events":["蔡襄游浙江径山，作《游径山记》。"],"poems":[{"id":1168106,"title":"游径山记","date":"景祐三年十二月","excerpt":""}],"notes":[]},{"place":{"zh":"洛阳","modern":"洛阳","ancient":"","spot":"","en":"Luoyang","enModern":"Luoyang","enAncient":"","enSpot":""},"lat":34.6244,"lng":112.46,"region":"CN4103","label":"1037年 - 1040年","y0":1037,"y1":1040,"age":"26-29","works":9,"events":["蔡襄在西京留守推官上任，主宾关系融洽。"],"poems":[{"id":1167875,"title":"上庞端公书","date":"1037年闰四月","excerpt":""},{"id":1167873,"title":"答谢景山书","date":"1037年","excerpt":""},{"id":1167874,"title":"再答谢景山书","date":"1038年","excerpt":""},{"id":1168171,"title":"尚书虞部员外郎尹公墓表","date":"1038年十二月","excerpt":""},{"id":1168107,"title":"通远桥记","date":"1039年十二月","excerpt":""},{"id":1168108,"title":"导伊水记","date":"1039年十二月","excerpt":""},{"id":1168109,"title":"白波发运使厅壁记","date":"1039年十二月","excerpt":""},{"id":1168110,"title":"谢公堂记","date":"1039年十二月","excerpt":""}],"notes":["宝元元年十二月","宝元二年十二月二十五日"]},{"place":{"zh":"开封","modern":"开封","ancient":"","spot":"","en":"Kaifeng","enModern":"Kaifeng","enAncient":"","enSpot":""},"lat":34.8029,"lng":114.3139,"region":"CN4102","label":"1040年 - 1041年四月","y0":1040,"y1":1041,"age":"29-30","works":14,"events":["蔡襄次子旬出生。","蔡襄送胡宿出守吴兴，作《送胡武平出守吴兴》，作品：《送胡武平出守吴兴》。"],"poems":[{"id":249377,"title":"城西金明池小饮二首 其一","date":"1040年","excerpt":"晓出都门外，名园连翠屏。融怡春物动，潇洒尘虑醒。"},{"id":249298,"title":"送张太傅还乡","date":"1040年夏","excerpt":"置器功成佚退身，故园南望整车茵。青冥直上无馀事，白首归来有几人。"},{"id":249246,"title":"哭贾少卿","date":"1040年十二月","excerpt":"画旟南度谪长沙，粤海新恩路更赊。子日鵩来知主去，辰年龙会为贤嗟。"},{"id":249176,"title":"司徒侍中宋宣献公挽词五首 其一","date":"1040年十二月","excerpt":"重器推隆栋，驰光逐逝川。人应骑尾宿，岁亦在辰年。"},{"id":249384,"title":"送任山归河东","date":"1040年冬","excerpt":"风俗忧思深，在昔言汾绛。之人隐其间，白首甘陋巷。"},{"id":249338,"title":"永叔示及圣俞酬答因奉和寄圣俞","date":"1040年","excerpt":"吾友多称君，思见寒附火。气温玉开籍，才敏镞加笴。"},{"id":249213,"title":"和陈殿丞南州新咏","date":"1040年","excerpt":"宝坊高阁遍凭栏，曾是芳辰得未閒。日上天容低接海，风轻湖底倒摇山。"},{"id":249299,"title":"哭石曼卿","date":"1041年春","excerpt":"仕宦晚益困，忽惊朝露晞。嗟嗟命不偶，事事志多违。"}],"notes":["蔡本作𠏭","庆历元年"]},{"place":{"zh":"扬州","modern":"扬州","ancient":"","spot":"","en":"Yangzhou","enModern":"Yangzhou","enAncient":"","enSpot":""},"lat":32.3999,"lng":119.4191,"region":"CN321","label":"1041年五月 - 1041年","y0":1041,"y1":1041,"age":"30","works":4,"events":["蔡襄至瓜州渡江，为风潮所阻，留宿扬州津馆，适次子旬周岁，作《宿扬州》、《广陵》、《马奴周晬思之因成》三首寄怀。"],"poems":[{"id":249094,"title":"宿扬州","date":"1041年五月","excerpt":"瓜洲堰埭阻行桡，更等江头后信潮。独背残灯数归路，风传寒柝夜迢迢。"},{"id":249159,"title":"广陵","date":"1041年五月","excerpt":"广陵归客叹飞蓬，怀古伤离向此中。前世翻波那复问，十年弹指已成空。"},{"id":249311,"title":"马奴周晬思之因成","date":"1041年五月","excerpt":"马奴今日方周晬，昨夜迢遥梦到家。盘里应知心所爱，尊前唯祝寿无涯。"},{"id":249183,"title":"江头别杜殿丞","date":"1041年","excerpt":"扬子江头南北路，木兰船上往来人。年华衮衮东流水，世事劳劳薄宦身。"}],"notes":[]},{"place":{"zh":"镇江金山寺","modern":"镇江金山寺","ancient":"","spot":"","en":"Zhenjiangjinshansi","enModern":"Zhenjiangjinshansi","enAncient":"","enSpot":""},"lat":32.1957,"lng":119.4315,"region":"CN3211","label":"1041年","y0":1041,"y1":1041,"age":"30","works":1,"events":["蔡襄游金山寺。"],"poems":[{"id":249138,"title":"题金山寺","date":"1041年","excerpt":"画梁诗板暗流尘，水石鱼龙万句新。谁识高僧最深意，慈航长护过江人。"}],"notes":["以上《蔡忠惠集》卷四"]},{"place":{"zh":"苏州","modern":"苏州","ancient":"","spot":"","en":"Suzhou","enModern":"Suzhou","enAncient":"","enSpot":""},"lat":31.3046,"lng":120.5896,"region":"CN3205","label":"1041年","y0":1041,"y1":1041,"age":"30","works":4,"events":["蔡襄至苏州，游览胥台、虎丘等名胜古迹，作《姑胥行》。"],"poems":[{"id":249370,"title":"姑胥行","date":"1041年","excerpt":"香泾无故流，胥台有馀基。太伯以德启，后王结心师。"},{"id":249291,"title":"题僧希元禅隐堂","date":"1041年","excerpt":"游锡遍他方，归休静默堂。孤吟时有得，诸念若为忘。"},{"id":249371,"title":"泊吴江寄胡武平","date":"1041年","excerpt":"遥夜吴江濒，露坐须成葆。天空不带云，野迥正收潦。"},{"id":1168121,"title":"题吴江如归亭壁","date":"1041年","excerpt":""}],"notes":["院在苏州城中"]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1041年","y0":1041,"y1":1041,"age":"30","works":5,"events":["蔡襄到杭州，游西湖名胜古迹，作《经钱塘故宫》。"],"poems":[],"notes":[]},{"place":{"zh":"延平","modern":"延平","ancient":"","spot":"","en":"Yanping","enModern":"Yanping","enAncient":"","enSpot":""},"lat":26.6442,"lng":118.1885,"region":"CN350702","label":"1041年","y0":1041,"y1":1041,"age":"30","works":0,"events":["蔡襄至南平，乘舟沿闽江顺流南下。"],"poems":[],"notes":[]},{"place":{"zh":"福州乌山","modern":"福州乌山","ancient":"","spot"
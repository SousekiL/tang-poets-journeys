,"label":"1056年 - 1058年四月","y0":1056,"y1":1058,"age":"45-47","works":21,"events":["蔡襄再延聘周希孟等为教授，并亲临郡学执经讲问。"],"poems":[],"notes":[]},{"place":{"zh":"泉州","modern":"泉州","ancient":"","spot":"","en":"Quanzhou","enModern":"Quanzhou","enAncient":"","enSpot":""},"lat":24.8802,"lng":118.6823,"region":"CN3505","label":"1058年六月 - 1060年","y0":1058,"y1":1060,"age":"47-49","works":32,"events":["蔡襄奉诏移知泉州。"],"poems":[],"notes":[]},{"place":{"zh":"莆田","modern":"莆田","ancient":"","spot":"","en":"Putian","enModern":"Putian","enAncient":"","enSpot":""},"lat":25.46,"lng":119.0142,"region":"CN3503","label":"1060年十月 - 1060年","y0":1060,"y1":1060,"age":"49","works":2,"events":["十月中旬，蔡襄自泉州至枫亭会见乡亲，并致书问候友僧宝月广上人。复有书致林郎。"],"poems":[{"id":249068,"title":"将赴京留题山庄西壁","date":"1060年","excerpt":"禁林京尹荷恩光，三上螭头乞郡章。贫薄奉亲须仰禄，此心安敢系轩裳。"},{"id":249051,"title":"过囊山寄宏师","date":"1060年","excerpt":"三十年间登第初，青衫羸马叩禅居。鬓毛白尽犹奔走，惭愧高人得自如。"}],"notes":[]},{"place":{"zh":"福州","modern":"福州","ancient":"","spot":"","en":"Fuzhou","enModern":"Fuzhou","enAncient":"","enSpot":""},"lat":26.0804,"lng":119.3029,"region":"CN3501","label":"1060年 - 1061年一月七日","y0":1060,"y1":1061,"age":"49-50","works":2,"events":["岁末，抵福州，由知州燕度招待过年。"],"poems":[],"notes":[]},{"place":{"zh":"南平","modern":"南平","ancient":"","spot":"","en":"Nanping","enModern":"Nanping","enAncient":"","enSpot":""},"lat":26.6477,"lng":118.1843,"region":"CN3507","label":"1061年一月十五日 - 1061年二月八日","y0":1061,"y1":1061,"age":"50","works":3,"events":["蔡襄抵南平，作《上元至南剑州大雨寄泉州许通判》寄泉州许当。"],"poems":[{"id":249154,"title":"上元至南剑州大雨寄泉州许通判","date":"1061年一月十五日","excerpt":"路绕溪回不计程，行邮今复宿延平。阴云藏月不知处，急雨落天无数声。"},{"id":249158,"title":"大湖驿寄建州同年窦职方","date":"1061年","excerpt":"别驿临溪曲，清寒结晓阴。滩声生乱石，雨意在閒林。"},{"id":249126,"title":"嘉祐辛丑蒙召还京二月八日道过陆氏之门因观小栏花卉","date":"1061年二月八日","excerpt":"风色微和日昼明，小栏花卉新芽生。行人不是爱春物，一见芳丛似有情。"}],"notes":[]},{"place":{"zh":"桐庐","modern":"桐庐","ancient":"","spot":"","en":"Tonglu","enModern":"Tonglu","enAncient":"","enSpot":""},"lat":29.7989,"lng":119.6981,"region":"CN330122","label":"1061年","y0":1061,"y1":1061,"age":"50","works":0,"events":["蔡襄过桐庐，谒严光祠堂。"],"poems":[],"notes":[]},{"place":{"zh":"杭州吉祥院","modern":"杭州吉祥院","ancient":"","spot":"","en":"Hangzhoujixiangyuan","enModern":"Hangzhoujixiangyuan","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1061年","y0":1061,"y1":1061,"age":"50","works":1,"events":["蔡襄过杭州吉祥院，重访璘上人，作《杭州过璘上人花圃》。"],"poems":[],"notes":[]},{"place":{"zh":"苏州","modern":"苏州","ancient":"","spot":"","en":"Suzhou","enModern":"Suzhou","enAncient":"","enSpot":""},"lat":31.3046,"lng":120.5896,"region":"CN3205","label":"1061年","y0":1061,"y1":1061,"age":"50","works":0,"events":["蔡襄行至苏州，作《与伯镇书》致章珉。"],"poems":[],"notes":[]},{"place":{"zh":"常州","modern":"常州","ancient":"","spot":"","en":"Changzhou","enModern":"Changzhou","enAncient":"","enSpot":""},"lat":31.8168,"lng":119.9801,"region":"CN3204","label":"1061年","y0":1061,"y1":1061,"age":"50","works":1,"events":["蔡襄至常州，看望张景山，作《寄题张景山大卿园池》。"],"poems":[{"id":249260,"title":"寄题张景山大卿园池","date":"1061年","excerpt":"人仰公才世吏师，更甘归老旧林池。门阑清似当官处，心力强于少壮时。"}],"notes":["以上《蔡忠惠集》卷六"]},{"place":{"zh":"南京","modern":"南京","ancient":"","spot":"","en":"Nanjing","enModern":"Nanjing","enAncient":"","enSpot":""},"lat":32.0647,"lng":118.8029,"region":"CN3201","label":"1061年","y0":1061,"y1":1061,"age":"50","works":1,"events":["蔡襄抵建康，作《寄题华藏院清轩》。"],"poems":[{"id":249398,"title":"寄题华藏院清轩","date":"1061年","excerpt":"湖边无地有尘埃，况复虚明向此开。山色每随朝气变，水光长共夕阳来。"}],"notes":[]},{"place":{"zh":"商丘","modern":"商丘","ancient":"","spot":"","en":"Shangqiu","enModern":"Shangqiu","enAncient":"","enSpot":""},"lat":34.4204,"lng":115.6628,"region":"CN4114","label":"1061年","y0":1061,"y1":1061,"age":"50","works":1,"events":["蔡襄行抵商丘，再上《辞翰林学士知开封府又状》请“与免开封府，并罢翰林之职，依旧职名，许令在京兼判闲局”。"],"poems":[{"id":1167837,"title":"辞翰林学士知开封府状 其二","date":"1061年","excerpt":""}],"notes":[]},{"place":{"zh":"开封","modern":"开封","ancient":"","spot":"","en":"Kaifeng","enModern":"Kaifeng","enAncient":"","enSpot":""},"lat":34.8029,"lng":114.3139,"region":"CN4102","label":"1061年四月 - 1065年","y0":1061,"y1":1065,"age":"50-54","works":73,"events":["四月中旬，蔡襄将入京畿，忽接诏令改授翰林学士、权三司使。","蔡襄撰书《尚书屯田员外郎通判润州刘君墓碣》完成，作品：《尚书屯田员外郎通判润州刘君墓碣》。","五月下旬，蔡襄撰书《光禄少卿致仕张公墓志铭》，作品：《光禄卿致仕张公墓志铭》。"],"poems":[{"id":1167974,"title":"泉州回交代启","date":"1061年","excerpt":""},{"id":1168174,"title":"尚书屯田员外郎赠光禄卿刘公墓碣","date":"1061年","excerpt":""},{"id":1168175,"title":"尚书屯田员外郎通判润州刘君墓碣","date":"嘉祐六年四月","excerpt":""},{"id":1167814,"title":"辞权三司使表","date":"1061年四月二十八日","excerpt":""},{"id":1167840,"title":"奏乞推恩卢侗状","date":"1061年","excerpt":""},{"id":1167832,"title":"奏为故崇信军节度副使尹洙为泾原路经略时借支官钱回易公用别无玷污已因此死于贬所臣以西事十年在边任事甚久今家贫无依伏乞朝举牵复旧秩与一子官庶使沈冤□圣泽事状","date":"1061年","excerpt":""},{"id":1167838,"title":"乞叙用吕溱状","date":"1061年","excerpt":""},{"id":1167839,"title":"乞叙用孙沔状","date":"1061年","excerpt":""}],"notes":["自注：时被召还都。","自注：重阳锡宴外园。"]},{"place":{"zh":"商丘","modern":"商丘","ancient":"","spot":"","en":"Shangqiu","enModern":"Shangqiu","enAncient":"","enSpot":""},"lat":34.4204,"lng":115.6628,"region":"CN4114","label":"1065年","y0":1065,"y1":1065,"age":"54","works":2,"events":["蔡襄过商丘，作《南都思杜祁公》。","蔡襄舟上遇孙沔，作《会亭遇资政孙公赴阙公致仕已七年时召归将有四鄙之任》古诗，作品：《会亭遇资政孙公赴阙公致仕已七年时召归将有西鄙之任》。"],"poems":[{"id":249376,"title":"南都思杜祁公","date":"1065年","excerpt":"祁公清德老，在昔相先帝。青云吐论高，白璧持身锐。"},{"id":249340,"title":"会亭遇资政孙公赴阙公致仕已七年时召归将有西鄙之任","date":"1065年","excerpt":"志节虽落落，不能无谤毁。壮年自雄豪，末路遽颠委。"}],"notes":["自注：所居名也。"]},{"place":{"zh":"永城","modern":"永城","ancient":"","spot":"","en":"Yongcheng","enModern":"Yongcheng","enAncient":"","enSpot":""},"lat":33.9348,"lng":116.456,"region":"CN411481","label":"1065年","y0":1065,"y1":1065,"age":"54","works":1,"events":["蔡襄过酂阳，目睹灾区惨状，作《酂阳行》二十韵歌哭之。"],"poems":[{"id":249430,"title":"酂阳行","date":"1065年","excerpt":"春秋书大水，灾患古所评。去年积行潦，田亩鱼蛙生。"}],"notes":[]},{"place":{"zh":"盱眙","modern":"盱眙","ancient":"","spot":"","en":"Xuyi","enModern":"Xuyi","enAncient":"","enSpot":""},"lat":33.0171,"lng":118.5514,"region":"CN320830","label":"1065年","y0":1065,"y1":1065,"age":"54","works":1,"events":["蔡襄至泗州，登马子山观漕亭，作《泗州登马子山观漕亭》。"],"poems":[{"id":249372,"title":"泗州登马子山观漕亭","date":"1065年","excerpt":"庙社奠东都，恃德非恃险。聚兵三十万，待哺无容歉。"}],"notes":[]},{"place":{"zh":"宿迁","modern":"宿迁","ancient":"","spot":"","en":"Suqian","enModern":"Suqian","enAncient":"","enSpot":""},"lat":33.9677,"lng":118.2821,"region":"CN3213","label":"1065年","y0":1065,"y1":1065,"age":"54","works":1,"events":["蔡襄将渡洪泽湖，为风所阻，蔡襄作《洪泽阻风》。"],"poems":[{"id":249238,"title":"洪泽阻风","date":"1065年","excerpt":"今日风期恶，迟回一水滨。村旗呈酒圣，庙鼓赛河神。"}],"notes":[]},{"place":{"zh":"镇江金山寺","modern":"镇江金山寺","ancient":"","spot":"","en":"Zhenjiangjinshansi","enModern":"Zhenjiangjinshansi","enAncient":"","enSpot":""},"lat":32.1957,"lng":119.4315,"region":"CN3211","label":"1065年四月","y0":1065,"y1":1065,"age":"54","works":1,"events":["四月末，蔡襄至京口，重游金山寺，作《游金山寺》。"],"poems":[{"id":249270,"title":"游金山寺","date":"1065年四月","excerpt":"平日压尘土，今游兴味长。波涛围四际，台殿起中央。"}],"notes":[]},{"place":{"zh":"苏州","modern":"苏州","ancient":"","spot":"","en":"Suzhou","enModern":"Suzhou","enAncient":"","enSpot":""},"lat":31.3046,"lng":120.5896,"region":"CN3205","label":"1065年五月六日","y0":1065,"y1":1065,"age":"54","works":0,"events":["蔡襄至吴县，参观范仲淹故居，并题跋书画作品。"],"poems":[],"notes":[]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1065年五月二十六日 - 1066年十月","y0":1065,"y1":1066,"age":"54-55","works":83,"events":["蔡襄到杭州任，作《杭州谢上表》。","二月末，蔡襄开州园纵民游乐，作《开州园纵民游乐二首》，作品：《开州园纵民游乐二首 其二》。","三月中旬，蔡襄游吴山及城南诸园林、古刹，并奉卢太夫人往吉祥院看花，作《十三日吉祥院探花》，作品：《十三日吉祥探花》。","蔡襄作《尚书礼部侍郎郑君墓志铭》，作品：《尚书礼部侍郎郑君墓志铭》。"],"poems":[],"notes":[]},{"place":{"zh":"富阳","modern":"富阳","ancient":"","spot":"","en":"Fuyang","enModern":"Fuyang","enAncient":"","enSpot":""},"lat":30.0011,"lng":119.8467,"region":"CN330111","label":"1066年十一月十二日","y0":1066,"y1":1066,"age":"55","works":0,"events":["蔡襄护母柩至富阳，致书葛密谢慰问。"],"poems":[],"notes":[]},{"place":{"zh":"莆田","modern":"莆田","ancient":"","spot":"","en":"Putian","enModern":"Putian","enAncient":"","enSpot":""},"lat":25.46,"lng":119.0142,"region":"CN3503","label":"1066年十二月二十八日 - 1067年八月十六日","y0":1066,"y1":1067,"age":"55-56","works":0,"events":["1066年十二月二十八日，蔡襄归抵莆田，在家举丧。","蔡襄病逝于莆田家中。"],"poems":[],"notes":[]}],"stages":[{"from":1,"to":2,"title":{"zh":"安庆、芜湖","en":"Anqing, Wuhu"},"main":"安庆","y0":1029,"y1":1029,"events":["蔡襄过舒州桐城得梦兆，有诗。","蔡襄到芜湖拜会凌景阳，凌为之引荐参加开封府试。"]},{"from":3,"to":4,"title":{"zh":"开封、江阴悟空院","en":"Kaifeng, Jiangyinwukongyuan"},"main":"开封","y0":1029,"y1":1029,"events":["开封府试榜发，襄为第一，弟高未得举。","经凌景阳介绍，蔡襄寄寓江阴悟空院读书，以备明年尚书省礼部会试。"]},{"from":5,"to":6,"title":{"zh":"开封、江阴","en":"Kaifeng, Jiangyin"},"main":"开封","y0":1030,"y1":1030,"events":["蔡襄赴京参加省试和殿试，登进士甲科第十名。","蔡襄还乡时复途次江阴，由凌景阳撮婚于葛惟明之季女。"]},{"from":7,"to":10,"title":{"zh":"南平、莆田、仙游等地","en":"Nanping, Putian, Xianyou"},"main":"南平","y0":1030,"y1":1030,"events":["蔡襄过延平，题诗黯淡院。","蔡襄过囊山，入寺叩宏法师。","蔡襄回乡。","蔡襄曾到惠安拜见舅父，撰书《惠安灵光院记》。"]},{"from":11,"to":12,"title":{"zh":"开封、江阴","en":"Kaifeng, Jiangyin"},"main":"开封","y0":1031,"y1":1031,"events":["春，蔡襄赴吏部铨选，受漳州军事判官。","蔡襄回程经江阴，迎娶葛氏夫人，葛氏之从兄弟葛密作诗赠蔡襄。"]},{"from":13,"to":14,"title":{"zh":"漳州、仙游","en":"Zhangzhou, Xianyou"},"main":"漳州","y0":1031,"y1":1036,"events":["蔡襄在漳州军事判官任。","蔡襄作《上运使王殿院书》反映福建民情，作品：《上运使王殿院书》。","蔡襄从漳州秩满罢归，适弟高登第还乡，阖家荣庆。"]},{"from":15,"to":18,"title":{"zh":"江阴、漯河、开封等地","en":"Jiangyin, Tahe, Kaifeng"},"main":"江阴","y0":1036,"y1":1036,"events":["蔡襄至江阴，将葛氏母女暂寄岳母家。","蔡襄过武阳，作《新泉记》。","蔡襄抵京都，待选。","蔡襄在西京留守推官任上，致书太常博士王洙，作《答王太祝书》。"]},{"from":19,"to":20,"title":{"zh":"江阴、杭州径山","en":"Jiangyin, Hangzhoujingshan"},"main":"江阴","y0":1036,"y1":1036,"events":["蔡襄赴江阴搬取家眷，途中遇奉诏还台之新授侍御史庞籍，言及仙游老儒茅知至及漳、泉、莆三郡税丁事。","蔡襄游浙江径山，作《游径山记》。"]},{"from":21,"to":22,"title":{"zh":"洛阳、开封","en":"Luoyang, Kaifeng"},"main":"洛阳","y0":1037,"y1":1041,"events":["蔡襄在西京留守推官上任，主宾关系融洽。","蔡襄次子旬出生。","蔡襄送胡宿出守吴兴，作《送胡武平出守吴兴》，作品：《送胡武平出守吴兴》。"]},{"from":23,"to":26,"title":{"zh":"扬州、镇江金山寺、苏州等地","en":"Yangzhou, Zhenjiangjinshansi, Suzhou"},"main":"扬州","y0":1041,"y1":1041,"events":["蔡襄至瓜州渡江，为风潮所阻，留宿扬州津馆，适次子旬周岁，作《宿扬州》、《广陵》、《马奴周晬思之因成》三首寄怀。","蔡襄游金山寺。","蔡襄至苏州，游览胥台、虎丘等名胜古迹，作《姑胥行》。","蔡襄到杭州，游西湖名胜古迹，作《经钱塘故宫》。"]},{"from":27,"to":30,"title":{"zh":"延平、福州乌山、仙游等地","en":"Yanping, Fuzhouwushan, Xianyou"},"main":"延平","y0":1041,"y1":1041,"events":["蔡襄至南平，乘舟沿闽江顺流南下。","蔡襄抵福州，太守沈邈招待品丹荔，游乌山，遂为“幽幽亭”题榜，并书《福州修庙学记》。","蔡襄抵家方五日即闻弟高噩耗，不胜哀痛，作《祭弟文》悼之。","蔡襄离家返京复职，过莆田囊山，应寺僧邀书陈伯孙诗，勒于石。"]},{"from":31,"to":39,"title":{"zh":"开封、衢州、南平等地","en":"Kaifeng, Quzhou, Nanping"},"main":"开封","y0":1041,"y1":1045,"events":["十一月初，蔡襄为林冀作《尚书屯田员外郎林君墓志铭》。","三月，仁宗复亲擢欧阳修、余靖、王素三人为谏官，蔡襄作《喜欧阳永叔余安道王仲仪除谏官》贺之，作品：《喜欧阳永叔余安道王仲仪除谏官》。","蔡襄至衢州，作《论东南事宜疏》，交驿递上朝。","1043年十二月二十八日，蔡襄过蒲城县迁阳镇，作《迁阳道中奉寄杨正臣同年》长篇五古并附信寄同年杨翊。","蔡襄在家乡营葬弟高并安慰父母。","蔡襄应邀游泉州九日山遣怀。"]},{"from":40,"to":67,"title":{"zh":"仙游、福州、长乐等地","en":"Xianyou, Fuzhou, Changle"},"main":"福州","y0":1045,"y1":1055,"events":["蔡襄挈妻孥还乡拜亲。旋复规划在兴化军城南营建新宅。","蔡襄迎奉双亲，赴福州莅任。作《晚上碧蜂亭》诗抒怀。","蔡襄曾至长乐。","蔡襄书欧阳修所撰之《太子太师致仕赠司空兼侍中文惠陈公神道碑》。","夏秋间，蔡襄赴北苑茶园监制贡茶，作《北苑十咏》。","秋，蔡襄自闽北返福州。"]},{"from":68,"to":97,"title":{"zh":"苏州、衢州、南平等地","en":"Suzhou, Quzhou, Nanping"},"main":"莆田","y0":1055,"y1":1067,"events":["八月中旬，蔡襄抵苏州。","蔡襄妻葛氏夫人卒于衢州道中。","蔡襄由浙道闽，作《丙申元日过浦城西阳岭》。","蔡襄宿渔溪驿，见梅花感而作《题渔溪驿》。","蔡襄到泉州任，作《泉州谢上表》。","五月中至下旬，蔡襄自泉州返枫亭故家。"]}],"curated":false}
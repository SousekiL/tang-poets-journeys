":1060,"y1":1062,"age":"54-56","works":9,"events":["夏，到知秦州任，有谢表。","二月，在知秦州任，于秦州后园春宴，有诗赠刘几，作品：《秦州后园春宴赠部署刘几阁使》。"],"poems":[{"id":1163308,"title":"秦州谢上表","date":"1060年","excerpt":""},{"id":1163180,"title":"奏夏州事宜","date":"1060年九月","excerpt":""},{"id":495451,"title":"闻翰林承旨宋子京尚书捐馆","date":"1061年五月","excerpt":"平昔雍容两禁游，共陪帷幄奉咨谋。功名不到麒麟阁，词赋空传鹦鹉洲。"},{"id":1163178,"title":"秦州奏唂厮啰事第一状","date":"1061年八月","excerpt":""},{"id":495481,"title":"秦州后园春宴赠部署刘几阁使","date":"1061年二月","excerpt":"柳暗三眠困，花繁二月香⑴。情怀当酒尽，兴味为春长。"},{"id":495482,"title":"秦州晚宴即席示诸宾僚","date":"1061年二月","excerpt":"秦川节物似西川，二月风光已不寒。犹去清明三候远，忽惊烂漫一春残。"},{"id":495480,"title":"秦州即事","date":"1062年","excerpt":"边清羽书息，事简使君慵。地僻俗客少，日长春睡浓。"},{"id":495483,"title":"陇西郡麦积山有献白鹿者洁如霜雪驯养逾年放归旧山十二韵","date":"1062年","excerpt":"地得金方正，山藏灵物珍。月宫遗玉兔，仙仗失霜麟。"}],"notes":["此文见《乐全集》卷二八。","中谢。"]},{"place":{"zh":"商丘（宋城）","modern":"商丘","ancient":"宋城","spot":"","en":"Songcheng (Shangqiu)","enModern":"Shangqiu","enAncient":"Songcheng","enSpot":""},"lat":34.4204,"lng":115.6628,"region":"CN4114","label":"1063年二月 - 1063年七月","y0":1063,"y1":1063,"age":"57","works":1,"events":["二月，在知应天府任，迁礼部尚书。"],"poems":[{"id":1163625,"title":"朝奉郎守太常少卿权北京留守御史台公事上柱国扶风县开国男食邑三百户赐紫金鱼袋马公墓志铭","date":"1063年七月","excerpt":""}],"notes":["此文见《乐全集》卷四〇。","并序 嘉祐八年七月"]},{"place":{"zh":"开封","modern":"开封","ancient":"","spot":"","en":"Kaifeng","enModern":"Kaifeng","enAncient":"","enSpot":""},"lat":34.8029,"lng":114.3139,"region":"CN4102","label":"1063年十月 - 1064年","y0":1063,"y1":1064,"age":"57-58","works":1,"events":["十月，徙知陈州，过都，留判尚书都省。"],"poems":[{"id":1163202,"title":"请慎用两制资序事奏","date":"治平元年十二月","excerpt":""}],"notes":["此文见《乐全集》卷二四。"]},{"place":{"zh":"东平（须城）","modern":"东平","ancient":"须城","spot":"","en":"Xucheng (Dongping)","enModern":"Dongping","enAncient":"Xucheng","enSpot":""},"lat":35.9428,"lng":116.4768,"region":"CN370923","label":"1064年 - 1065年","y0":1064,"y1":1065,"age":"58-59","works":3,"events":["本年，在知郓州任，识拔马默。"],"poems":[{"id":1163609,"title":"朝奉郎尚书刑部员外郎知制诰同知审官院上骑都尉赐紫金鱼袋昌黎韩君墓志铭","date":"1065年",
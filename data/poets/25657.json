年","excerpt":"一径过萧森，幽提此独寻。俗游殊不意，僧话粗宽心。"},{"id":495409,"title":"读楞伽经","date":"1048年","excerpt":"楞伽三万六千偈，百八句中成自性。法法非法离法尘，心心无心入心病。"}],"notes":["此文见《乐全集》卷二八。","中谢。"]},{"place":{"zh":"南京（上元）","modern":"南京","ancient":"上元","spot":"","en":"Shangyuan (Nanjing)","enModern":"Nanjing","enAncient":"Shangyuan","enSpot":""},"lat":32.0647,"lng":118.8029,"region":"CN3201","label":"1049年四月 - 1050年闰十一月八日","y0":1049,"y1":1050,"age":"43-44","works":14,"events":["四月，到知江宁府任，有谢表。"],"poems":[{"id":1163287,"title":"江宁府谢上表","date":"1049年四月","excerpt":""},{"id":1163435,"title":"江宁府谢上与两地启","date":"1049年四月","excerpt":""},{"id":1163437,"title":"谢杭州范资政启","date":"1049年四月","excerpt":""},{"id":1163650,"title":"江宁府祭蒋山庄武帝神文","date":"1049年六月","excerpt":""},{"id":1163651,"title":"祭真武灵应真君文","date":"1049年六月","excerpt":""},{"id":1163652,"title":"祭谢蒋山庄武帝神文","date":"1049年六月","excerpt":""},{"id":495485,"title":"金陵府署池上草堂","date":"1049年六月","excerpt":"东方千骑忝藩侯，情味都如寓一丘。客气尽将还野马，机心聊自试沙鸥。"},{"id":1163640,"title":"祭杨侍郎文","date":"1049年十一月七日","excerpt":""}],"notes":["此文见《乐全集》卷二八。","中谢。"]},{"place":{"zh":"杭州（钱塘）","modern":"杭州","ancient":"钱塘","spot":"","en":"Qiantang (Hangzhou)","enModern":"Hangzhou","enAncient":"Qiantang","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1051年六月","y0":1051,"y1":1051,"age":"45","works":0,"events":["六月，在知杭州任，母嵇氏卒，护丧还应天府。"],"poems":[],"notes":[]},{"place":{"zh":"商丘（宋城）","modern":"商丘","ancient":"宋城","spot":"","en":"Songcheng (Shangqiu)","enModern":"Shangqiu","enAncient":"Songcheng","enSpot":""},"lat":34.4204,"lng":115.6628,"region":"CN4114","label":"1052年六月一日 - 1052年八月四日","y0":1052,"y1":1052,"age":"46","works":3,"events":["六月一日，在应天府居母丧，作文祭韩综。"],"poems":[{"id":1163639,"title":"祭紫微韩舍人文","date":"1052年六月一日","excerpt":""},{"id":1163636,"title":"祭资政范侍郎文","date":"1052年七月一日","excerpt":""},{"id":1163641,"title":"祭张密学文","date":"1052年八月四日","excerpt":""}],"notes":["此文见《乐全集》卷三五。","此文见《乐全集》卷三五。张密学，名不详。"]},{"place":{"zh":"开封","modern":"开封","ancient":"","spot":"","en":"Kaifeng","enModern":"Kaifeng","enAncient":"","enSpot":""},"lat":34.8029,"lng":114.3139,"region":"CN4102","label":"1053年七月 - 1054年","y0":1053,"y1":1054,"age":"47-48","works":12,"events":["七月，服除，再授端明殿学士、兼龙图阁学士、给事中，举钱明逸自代。"],"poems":[{"id":1163357,"title":"服除再授端明殿学士兼龙图阁学士给事中举官自代状","date":"1053年七月","excerpt":""},{"id":1163288,"title":"服除再授端明殿学士兼龙图阁学士给事中谢恩表","date":"1053年七月","excerpt":""},{"id":1163402,"title":"服除授依前端明殿学士龙图阁学士给事中笏记","date":"1053年七月","excerpt":""},{"id":1163396,"title":"服除再授端明殿学士龙图阁学士给事中谢赐对衣腰带鞍辔马状","date":"1053年七月","excerpt":""},{"id":1163229,"title":"论内臣奏荫子弟奏","date":"1053年九月","excerpt":""},{"id":495349,"title":"大祀礼成","date":"1053年十一月四日","excerpt":"皇心奉先孝，盛德事天明。严配讲隆礼，精禋格至诚。"},{"id":1163400,"title":"兼侍读学士知秦州笏记","date":"1053年十二月","excerpt":""},{"id":1163289,"title":"除尚书礼部侍郎知滑州让迁官表","date":"1054年","excerpt":""}],"notes":["此文见《乐全集》卷三〇。","此文见《乐全集》卷二八。"]},{"place":{"zh":"滑县（白马）","modern":"滑县","ancient":"白马","spot":"","en":"Baima (Huaxian)","enModern":"Huaxian","enAncient":"Baima","enSpot":""},"lat":35.5812,"lng":114.5259,"region":"CN410526","label":"1054年三月 - 1054年七月","y0":1054,"y1":1054,"age":"48","works":3,"events":["三月，赴滑州任。"],"poems":[{"id":1163279,"title":"滑州谢赐新历日表","date":"1054年","excerpt":""},{"id":1163292,"title":"免知益州表","date":"1054年七月","excerpt":""},{"id":1163293,"title":"免知益州劄子","date":"1054年七月","excerpt":""}],"notes":["此文见《乐全集》卷二八。","中谢。"]},{"place":{"zh":"开封","modern":"开封","ancient":"","spot":"","en":"Kaifeng","enModern":"Kaifeng","enAncient":"","enSpot":""},"lat":34.8029,"lng":114.3139,"region":"CN4102","label":"1054年七月","y0":1054,"y1":1054,"age":"48","works":1,"events":["七月，以父老子幼，再上劄子乞免知益州。"],"poems":[],"notes":["此文见《乐全集》卷三〇。","此文见《乐全集》卷二八。"]},{"place":{"zh":"华阴云台观","modern":"华阴云台观","ancient":"","spot":"","en":"Huayinyuntaiguan","enModern":"Huayinyuntaiguan","enAncient":"","enSpot":""},"lat":34.5717,"lng":110.0987,"region":"CN610582","label":"1054年十月","y0":1054,"y1":1054,"age":"48","works":1,"events":["十月，赴益州任，途经华山云台观，有诗题陈抟影堂。"],"poems":[{"id":495528,"title":"华山云台观题希夷先生陈抟影堂","date":"1054年十月","excerpt":"林壑云深接玉泉，松斋闭息辄经年。一无标致惟随俗，别有真机在指玄。"}],"notes":["此诗见《乐全集》卷三。系年据《乐全集》卷三《药水岩诗》序。"]},{"place":{"zh":"华县（郑县）","modern":"华县","ancient":"郑县","spot":"","en":"Zhengxian (Huaxian)","enModern":"Huaxian","enAncient":"Zhengxian","enSpot":""},"lat":34.5186,"lng":109.7784,"region":"CN610521","label":"1054年十月","y0":1054,"y1":1054,"age":"48","works":2,"events":["十月，赴益州任，途经华州西溪，有诗。"],"poems":[{"id":495521,"title":"华州西溪","date":"1054年十月","excerpt":"西溪殊近郭，少华更当轩。竹径通华表，松庭接绀园。"},{"id":495529,"title":"相国杜公旧里钱唐有别野在华下既得谢留寓睢阳因家焉某近赴益部过三峰闻华人之望公舍而不还又顾吾乡之独幸国老处焉因道西人之意成长句四韵奉寄杜公","date":"1054年十月","excerpt":"谋国有劳新史在，挂车无第旧乡遥。睢阳图记光耆彦，华下风烟遂寂寥。"}],"notes":["此诗见《乐全集》卷三。系年据《乐全集》卷三《药水岩诗》序。","季本、陶本、清抄本作旧"]},{"place":{"zh":"西安（长安）灞桥","modern":"西安","ancient":"长安","spot":"灞桥","en":"Changan (Xian) Baqiao","enModern":"Xian","enAncient":"Changan","enSpot":"Baqiao"},"lat":34.3474,"lng":108.9463,"region":"CN6101","label":"1054年十月","y0":1054,"y1":1054,"age":"48","works":1,"events":["十月，赴益州任，途经长安灞桥，有诗。"],"poems":[{"id":495519,"title":"过灞桥长安道上作","date":"1054年十月","excerpt":"汉牒熟当披旧迹，灞桥今忽过征鞍。前朝宫展烟芜远，四望河山古木寒。"}],"notes":["此诗见《乐全集》卷三。系年据《乐全集》卷三《药水岩诗》序。"]},{"place":{"zh":"岐山","modern":"岐山","ancient":"","spot":"","en":"Qishan","enModern":"Qishan","enAncient":"","enSpot":""},"lat":34.4496,"lng":107.6275,"region":"CN610323","label":"1054年十月","y0":1054,"y1":1054,"age":"48","works":2,"events":["十月，赴益州任，途经岐山，有诗。"],"poems":[{"id":495522,"title":"过长安至岐山作","date":"1054年十月","excerpt":"高原极望秦川阔，危栈横空蜀道长。多谢终南山色好，迢迢相送过岐阳。"},{"id":495518,"title":"行次岐山","date":"1054年十月","excerpt":"坤维五十郡，麾节忝师垣。缓辔犹秦甸，前驱已剑门。"}],"notes":["此诗见《乐全集》卷三。系年据《乐全集》卷三《药水岩诗》序。"]},{"place":{"zh":"两当张真人洞","modern":"两当张真人洞","ancient":"","spot":"","en":"Liangdangzhangzhenrendong","enModern":"Liangdangzhangzhenrendong","enAncient":"","enSpot":""},"lat":33.9152,"lng":106.3114,"region":"CN621228","label":"1054年十月","y0":1054,"y1":1054,"age":"48","works":1,"events":["十月，赴益州任，途经两当驿西张果真人隐居处，有诗。"],"poems":[{"id":495523,"title":"过张真人洞","date":"1054年十月","excerpt":"谷口巑岏狮子山，洞门高掩白云閒。自惭末裔无仙骨，名利途中鬓已斑。"}],"notes":["此诗见《乐全集》卷三。系年据《乐全集》卷三《药水岩诗》序。"]},{"place":{"zh":"略阳（长举）","modern":"略阳","ancient":"长举","spot":"","en":"Zhangju (Lveyang)","enModern":"Lveyang","enAncient":"Zhangju","enSpot":""},"lat":33.3331,"lng":106.1631,"region":"CN610727","label":"1054年十月","y0":1054,"y1":1054,"age":"48","works":5,"events":["十月，赴益州任，途经青泥岭，有诗。"],"poems":[{"id":495520,"title":"青泥岭","date":"1054年十月","excerpt":"斗峻凌霄出混茫，东西秦蜀此分疆。萦纡断涧千寻曲，回合危峦万叠苍。"},{"id":495526,"title":"兴州长举县西二十里阁道立表曰飞石阁告往来者急度勿停予赴益部兴州将吏来迎皆至长举因访老吏飞石之状云昔尝有之亦飘风暴雨之时也予望山顶皆已垦耕而行人熟虚名至是皆驰过因成一绝","date":"1054年十月","excerpt":"蜀道循山多险巇，行人独此策征羁。人情多为虚名怯，鹤唳风声走老氐。"},{"id":495539,"title":"药水岩诗","date":"1054年十月二十三日","excerpt":"灵泉一派蜀江通，源出苍崖古洞中。乳滴云根苔臼满，药成仙灶石台空。"},{"id":495535,"title":"飞仙岭阁","date":"1054年十月","excerpt":"苍崖老树云萝合，绝涧惊湍阁路高。羽驾飙轮殊惚恍，依程缓辔未为劳。"},{"id":495536,"title":"乱石溪","date":"1054年十月","excerpt":"乱石峥嵘散粟堆，飞湍奔泻万山开。轰空急若雷车过，振壑倾疑地轴摧。"}],"notes":["此诗见《乐全集》卷三。系年据《乐全集》卷三《药水岩诗》序。","武兴郡西飞仙岭，迸流而下"]},{"place":{"zh":"宁强（三泉）龙门洞","modern":"宁强","ancient":"三泉","spot":"龙门洞","en":"Sanquan (Ningqiang) Longmendong","enModern":"Ningqiang","enAncient":"Sanquan","enSpot":"Longmendong"},"lat":32.8353,"lng":106.2638,"region":"CN610726","label":"1054年十月","y0":1054,"y1":1054,"age":"48","works":1,"events":["十月，赴益州任，途经三泉县西龙门洞，有诗。"],"poems":[{"id":495540,"title":"宿龙门洞","date":"1054年十月","excerpt":"路到葭萌古道边，层崖叠磴入苍烟。忽逢方丈在平地，何意中途过洞天。"}],"notes":["此诗见《乐全集》卷三。系年据《乐全集》卷三《药水岩诗》序。","在三泉县西，即古葭萌"]},{"place":{"zh":"广元（绵谷）筹笔驿","modern":"广元","ancient":"绵谷","spot":"筹笔驿","en":"Miangu (Guangyuan) Choubiyi","enModern":"Guangyuan","enAncient":"Miangu","enSpot":"Choubiyi"},"lat":32.4418,"lng":105.85,"region":"CN5108","label":"1054年十月","y0":1054,"y1":1054,"age":"48","works":2,"events":["十月，赴益州任，途经筹笔驿，有诗。"],"poems":[{"id":495524,"title":"筹笔驿","date":"1054年十月","excerpt":"本规一举定乾坤，遽见长星坠垒门。公在必无生仲达，师昭何业得中原。"},{"id":495525,"title":"雨中登筹笔驿后怀古亭","date":"1054年十月","excerpt":"山寒雨急晓冥冥，更蹑苍崖上驿亭。深秀林峦都不见，白云堆里乱峰青。"},{"id":495532,"title":"泥溪驿","date":"1054年十月","excerpt":"嘉陵江到水菰园，水势东回入阆⑴川。前过剑门山路稳，免寻阁道上云巅。"}],"notes":["此诗见《乐全集》卷三。系年据《乐全集》卷三《药水岩诗》序。"]},{"place":{"zh":"旺苍（嘉川）","modern":"旺苍","ancient":"嘉川","spot":"","en":"Jiachuan (Wangcang)","enModern":"Wangcang","enAncient":"Jiachuan","enSpot":""},"lat":32.2351,"lng":106.2962,"region":"CN510821","label":"1054年十月","y0":1054,"y1":1054,"age":"48","works":2,"events":["十月，赴益州任，途经嘉川驿，有诗。"],"poems":[{"id":495534,"title":"过嘉川驿","date":"1054年十月","excerpt":"嘉陵江上嘉川峡，古木云萝千万峰。阁道缘山已经月，萦回未出画屏中。"},{"id":495531,"title":"散水岩漱玉亭","date":"1054年十月","excerpt":"高从云际落崔嵬，疑决银潢一派来。散漫难收珠网绽，琤瑽不断玉山摧。"}],"notes":["此诗见《乐全集》卷三。系年据《乐全集》卷三《药水岩诗》序。"]},{"place":{"zh":"广元（昭化）泥溪驿","modern":"广元","ancient":"昭化","spot":"泥溪驿","en":"Zhaohua (Guangyuan) Nixiyi","enModern":"Guangyuan","enAncient":"Zhaohua","enSpot":"Nixiyi"},"lat":32.4418,"lng":105.85,"region":"CN5108","label":"1054年十月","y0":1054,"y1":1054,"age":"48","works":1,"events":["十月，赴益州任，途经泥溪驿，有诗。"],"poems":[],"notes":[]},{"place":{"zh":"剑阁（剑门）","modern":"剑阁","ancient":"剑门","spot":"","en":"Jianmen (Jiange)","enModern":"Jiange","enAncient":"Jianmen","enSpot":""},"lat":32.2943,"lng":105.5318,"region":"CN510823","label":"1054年十月","y0":1054,"y1":1054,"age":"48","works":2,"events":["十月，赴益州任，途经剑门关，有诗。"],"poems":[{"id":495527,"title":"剑门关","date":"1054年十月","excerpt":"地维绝脉摧鳌足，天垒横霄壮井舆。谁轧祸萌通鸟道，古为风土感鱼凫。"},{"id":495530,"title":"上亭驿","date":"1054年十月","excerpt":"雨中驻跸此闻铃，当日梨园写此声。忽忽悲心自多感，铃声何事怆人情。"}],"notes":["此诗见《乐全集》卷三。系年据《乐全集》卷三《药水岩诗》序。"]},{"place":{"zh":"成都（成都府）","modern":"成都","ancient":"成都府","spot":"","en":"Chengdufu (Chengdu)","enModern":"Chengdu","enAncient":"Chengdufu","enSpot":""},"lat":30.5763,"lng":104.0712,"region":"CN5101","label":"1054年十一月 - 1056年八月","y0":1054,"y1":1056,"age":"48-50","works":5,"events":["十一月，到益州任，有谢表。"],"poems":[{"id":1163295,"title":"益州谢上表","date":"1054年十一月","excerpt":""},{"id":1163653,"title":"祈雨醮坛词","date":"1055年二月","excerpt":""},{"id":1163296,"title":"益州谢诏书奖谕表","date":"1056年","excerpt":""},{"id":1163297,"title":"谢除三司使表","date":"1056年八月","exc
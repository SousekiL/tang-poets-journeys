芙蓉、小芙蓉。"]},{"place":{"zh":"天台","modern":"天台","ancient":"","spot":"","en":"Tiantai","enModern":"Tiantai","enAncient":"","enSpot":""},"lat":29.1488,"lng":121.0138,"region":"CN331023","label":"1145年","y0":1145,"y1":1145,"age":"34","works":1,"events":["赴补太学，作品：《宿庆善寺》。"],"poems":[{"id":541433,"title":"宿庆善寺","date":"1145年","excerpt":"刚被篙工误，迟留一日装。川涂隔浩渺，灯火乱昏黄。"}],"notes":[]},{"place":{"zh":"绍兴","modern":"绍兴","ancient":"","spot":"","en":"Shaoxing","enModern":"Shaoxing","enAncient":"","enSpot":""},"lat":30.0365,"lng":120.5867,"region":"CN3306","label":"1145年 - 1146年","y0":1145,"y1":1146,"age":"34-35","works":3,"events":["赴补太学。"],"poems":[{"id":541435,"title":"过新昌","date":"1145年","excerpt":"杖屦登关岭，山行无住时。客情浑在眼，乡思苦关眉。"},{"id":541436,"title":"观石佛","date":"1145年","excerpt":"土木涂金巧逼真，总随浮幻化埃尘。何人著意镌山骨，长现金刚不坏身。"},{"id":541438,"title":"曹娥庙","date":"1145年","excerpt":"恸哭无寻处，投江竟得尸。风高烈女传，名重外孙碑。"}],"notes":[]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1146年","y0":1146,"y1":1146,"age":"35","works":1,"events":["以外舍生求学太学。"],"poems":[{"id":541447,"title":"月夜独酌","date":"1146年","excerpt":"月色撩人不忍眠，杖头独挂百青钱。一杯竹叶那能醉，浇起乡心更黯然。"}],"notes":[]},{"place":{"zh":"乐清","modern":"乐清","ancient":"","spot":"","en":"Yueqing","enModern":"Yueqing","enAncient":"","enSpot":""},"lat":28.119,"lng":120.9899,"region":"CN330382","label":"1146年","y0":1146,"y1":1146,"age":"35","works":0,"events":["秋，别太学回乡，次子孟丙出生。"],"poems":[],"notes":[]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1147年","y0":1147,"y1":1147,"age":"36","works":0,"events":["春，赴补太学，秋回乡。"],"poems":[],"notes":[]},{"place":{"zh":"乐清","modern":"乐清","ancient":"","spot":"","en":"Yueqing","enModern":"Yueqing","enAncient":"","enSpot":""},"lat":28.119,"lng":120.9899,"region":"CN330382","label":"1147年","y0":1147,"y1":1147,"age":"36","works":2,"events":["回乡。"],"poems":[],"notes":[]},{"place":{"zh":"温州","modern":"温州","ancient":"","spot":"","en":"Wenzhou","enModern":"Wenzhou","enAncient":"","enSpot":""},"lat":28.0011,"lng":120.7059,"region":"CN3303","label":"1147年","y0":1147,"y1":1147,"age":"36","works":4,"events":["赴太学，再过雁荡山。"],"poems":[{"id":541451,"title":"再过雁山三绝 其一 大龙湫","date":"1147年","excerpt":"龙大那容在此湫，银河得得为飞流。好乘风雨昂头角，直到天池最上头。"}],"notes":[]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1148年三月 - 1148年八月","y0":1148,"y1":1148,"age":"37","works":3,"events":["省试落第。"],"poems":[{"id":541456,"title":"戊辰闰八月归临安观旧题脩竹黄杨丁香慨然有感复书三绝于后 其一","date":"1148年八月","excerpt":"吾家风物富檀栾，最爱青青耐岁寒。千里归来面苍玉，不烦时复报平安。"}],"notes":["以上《梅溪先生文集》卷三"]},{"place":{"zh":"乐清","modern":"乐清","ancient":"","spot":"","en":"Yueqing","enModern":"Yueqing","enAncient":"","enSpot":""},"lat":28.119,"lng":120.9899,"region":"CN330382","label":"1148年 - 1149年七月","y0":1148,"y1":1149,"age":"37-38","works":7,"events":["秋回乡。"],"poems":[],"notes":[]},{"place":{"zh":"温州","modern":"温州","ancient":"","spot":"","en":"Wenzhou","enModern":"Wenzhou","enAncient":"","enSpot":""},"lat":28.0011,"lng":120.7059,"region":"CN3303","label":"1149年八月","y0":1149,"y1":1149,"age":"38","works":1,"events":["赴太学，万先之同行，同游雁荡。"],"poems":[{"id":541498,"title":"次先之过雁山韵","date":"1149年八月","excerpt":"云山缭绕几千重，撩我秋来逸兴浓。欲向灵岩移卓笔，与君同扫万人锋。"}],"notes":[]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1150年","y0":1150,"y1":1150,"age":"39","works":1,"events":["升上舍。"],"poems":[{"id":1249941,"title":"升补上舍谢宰相","date":"1150年","excerpt":""}],"notes":[]},{"place":{"zh":"乐清","modern":"乐清","ancient":"","spot":"","en":"Yueqing","enModern":"Yueqing","enAncient":"","enSpot":""},"lat":28.119,"lng":120.9899,"region":"CN330382","label":"1150年4？ - 1151年","y0":1150,"y1":1151,"age":"39-40","works":3,"events":["母病，归乡。"],"poems":[],"notes":[]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1151年 - 1151年十一月","y0":1151,"y1":1151,"age":"40","works":2,"events":["第五次赴太学，升上舍。","为万中祖母墓前亭作文，作品：《追远亭记》。"],"poems":[{"id":1250250,"title":"追远亭记","date":"1151年十月","excerpt":""},{"id":1250315,"title":"周府君行状","date":"1151年十一月","excerpt":""}],"notes":[]},{"place":{"zh":"乐清","modern":"乐清","ancient":"","spot":"","en":"Yueqing","enModern":"Yueqing","enAncient":"","enSpot":""},"lat":28.119,"lng":120.9899,"region":"CN330382","label":"1152年","y0":1152,"y1":1152,"age":"41","works":8,"events":["居母丧，结庐讲学。"],"poems":[],"notes":[]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1152年","y0":1152,"y1":1152,"age":"41","works":2,"events":["赴太学。"],"poems":[{"id":541574,"title":"与郑时敏登楼把酒书二绝 其一","date":"1152年","excerpt":"十里青山接郡城，危楼四望眼添明。海冥天阔乡心切，更听飞飞鸿雁声。"}],"notes":[]},{"place":{"zh":"乐清","modern":"乐清","ancient":"","spot":"","en":"Yueqing","enModern":"Yueqing","enAncient":"","enSpot":""},"lat":28.119,"lng":120.9899,"region":"CN330382","label":"1152年","y0":1152,"y1":1152,"age":"41","works":1,"events":["从太学返乡，作品：《西征》。"],"poems":[],"notes":[]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1153年","y0":1153,"y1":1153,"age":"42","works":0,"events":["赴临安科试败举。"],"poems":[],"notes":[]},{"place":{"zh":"绍兴","modern":"绍兴","ancient":"","spot":"","en":"Shaoxing","enModern":"Shaoxing","enAncient":"","enSpot":""},"lat":30.0365,"lng":120.5867,"region":"CN3306","label":"1153年三月 - 1153年","y0":1153,"y1":1153,"age":"42","works":5,"events":["应太学同舍周德远要求，前往剡溪书院任教。","告别剡溪诸友，返乡，作品：《别周德远诸友》。"],"poems":[{"id":541579,"title":"癸酉三月二十五日至剡溪旅舍观曹梦良题壁有撩我思家第一篇之句仆离家半月亦未尝作诗因次其韵","date":"1153年三月二十五日","excerpt":"客舍那堪闻杜鹃，梦魂惊断竟无眠。定知此境撩乡思，我亦曾非第二篇。"},{"id":1250251,"title":"渊源堂记","date":"1153年","excerpt":""},{"id":541580,"title":"剡之市人以崇奉东岳为名设盗蹠以戏先圣所不忍观因书一绝","date":"1153年","excerpt":"里巷无端戏大儒，恨无司马为行诛。不知陈蔡当时厄，还似如今嵊县无。"},{"id":541642,"title":"别周德远诸友","date":"1153年七月二十三日","excerpt":"山城过疏雨，客馆生新秋。乡心杂病思，浩荡不可留。"},{"id":541643,"title":"宿石佛","date":"1153年","excerpt":"脩径入幽壑，梵宫摩碧霄。仰头惊突兀，跬步怯岧峣。"}],"notes":[]},{"place":{"zh":"乐清","modern":"乐清","ancient":"","spot":"","en":"Yueqing","enModern":"Yueqing","enAncient":"","enSpot":""},"lat":28.119,"lng":120.9899,"region":"CN330382","label":"1153年八月二日 - 1156年十月一日","y0":1153,"y1":1156,"age":"42-45","works":29,"events":["离开剡溪返乡途中。"],"poems":[],"notes":[]},{"place":{"zh":"温州雁荡山","modern":"温州雁荡山","ancient":"","spot":"","en":"Wenzhouyandangshan","enModern":"Wenzhouyandangshan","enAncient":"","enSpot":""},"lat":28.0011,"lng":120.7059,"region":"CN3303","label":"1156年十月","y0":1156,"y1":1156,"age":"45","works":1,"events":["赴临安,便道游雁荡山。"],"poems":[],"notes":[]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1156年十二月 - 1157年三月","y0":1156,"y1":1157,"age":"45-46","works":3,"events":["太学求学，赏梅于西湖。"],"poems":[{"id":541764,"title":"同舍再约赏梅用前韵","date":"1156年十二月","excerpt":"梅溪野人真野哉，老眼长为寒梅开。朅来西湖探春色，濡毫一洗匈襟埃。"},{"id":541765,"title":"前日探梅李元翁以疾不往和诗有玉华野人多病恼独守寒炉煨芋魁句复用前韵约同赏","date":"1156年十二月","excerpt":"西湖十里真佳哉，百花未放梅先开。吾侪好事颇成癖，探春不惮冲风埃。"},{"id":541906,"title":"丁丑二月二十一日集英殿赐第","date":"1157年二月二十一日","excerpt":"太平天子崇儒术，寒贱书生荷⑴作成。槐市育才叨舍选，枫宸唱第冠时英。"}],"notes":[]},{"place":{"zh":"绍兴","modern":"绍兴","ancient":"","spot":"","en":"Shaoxing","enModern":"Shaoxing","enAncient":"","enSpot":""},"lat":30.0365,"lng":120.5867,"region":"CN3306","label":"1157年九月 - 1159年十二月七日","y0":1157,"y1":1159,"age":"46-48","works":6,"events":["抵达绍兴府就任佥判。","绍兴府就任佥判，考察风土人情作《会稽三赋》，作品：《会稽风俗赋》。"],"poems":[{"id":542023,"title":"蓬莱阁","date":"1158年","excerpt":"祖龙车辙遍尘寰，只道蓬莱在海间。空上望秦山上望，不知此处是神山。"},{"id":542041,"title":"西园","date":"1158年","excerpt":"西园风物冠东州，飞盖纷纷烂熳游。惟有红莲幕中客，倚栏才得片时留。"},{"id":542045,"title":"鉴湖","date":"1158年","excerpt":"胸中万顷元才子，方外孤标贺季真。鉴水萦回三百里，风流何止两唐人。"},{"id":1249833,"title":"会稽风俗赋","date":"1158年","excerpt":""},{"id":1249839,"title":"蓬莱阁赋","date":"1158年","excerpt":""},{"id":542100,"title":"留别民事堂","date":"1159年十二月七日","excerpt":"二年宦东州，民事了无补。俯仰愧斯堂，何以报明主。"}],"notes":["四库本作向","并叙"]},{"place":{"zh":"乐清雁荡山","modern":"乐清雁荡山","ancient":"","spot":"","en":"Yueqingyandangshan","enModern":"Yueqingyandangshan","enAncient":"","enSpot":""},"lat":28.119,"lng":120.9899,"region":"CN330382","label":"1159年十二月","y0":1159,"y1":1159,"age":"48","works":6,"events":["解官归家,游雁荡山，作品：《题双峰资深堂 其三》。"],"poems":[],"notes":[]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1160年一月八日 - 1161年","y0":1160,"y1":1161,"age":"49-50","works":9,"events":["回临安任秘书省校书郎。"],"poems":[{"id":542110,"title":"次韵皇子建王题明远楼","date":"1160年四月","excerpt":"百尺崇珠邸，恩隆地更亲。壮侔巢凤阁，危切饮牛津。"},{"id":542115,"title":"皇子建王生日","date":"1160年十月二日","excerpt":"黄花过后梅花前，云披爱日烘青天。月良阴剥阳欲旋，蓂馀八荚时半千。"},{"id":542117,"title":"送查元章二首 其一","date":"1161年","excerpt":"圣主德宽大，小臣言激昂。虏情殊未测，淮甸可无防。"},{"id":542136,"title":"送王嘉叟编修","date":"1161年","excerpt":"上书请剑人未复⑴，开口荐贤君又行。堂上伊优笑绝倒，纷纷去国皆狂生。"},{"id":542137,"title":"送陈阜卿出守吴兴","date":"1161年","excerpt":"台阁辍名士，符竹分帝忧。搢绅有清议，欲为朝端留。"},{"id":542139,"title":"送胡正字分韵得来字","date":"1161年","excerpt":"武夷之山高崔嵬，武夷先生贤矣哉。山中高卧似孤竹，颜苍节劲清无埃。"},{"id":542146,"title":"张阁学挽词 其一","date":"1161年","excerpt":"南渡已三纪，衣冠今几存。伤心失遗老，回首慨中原。"},{"id":542150,"title":"五月十八日去国明日宿富阳庙山怀馆中同舍","date":"1161年五月","excerpt":"去国怀明主，离群念旧游。翻令到家梦，终夜绕瀛洲。"}],"notes":["自注：楼中藏所肠御书。","十月二十二日"]},{"place":{"zh":"绍兴","modern":"绍兴","ancient":"","spot":"","en":"Shaoxing","enModern":"Shaoxing","enAncient":"","enSpot":""},"lat":30.0365,"lng":120.5867,"region":"CN3306","label":"1161年五月","y0":1161,"y1":1161,"age":"50","works":0,"events":["迁大宗正丞，供职绍兴府，未赴任。累疏乞祠。"],"poems":[],"notes":[]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1161年五月","y0":1161,"y1":1161,"age":"50","works":2,"events":["辞馆离京，过富阳。"],"poems":[],"notes":["自注：楼中藏所肠御书。","十月二十二日"]},{"place":{"zh":"桐庐","modern":"桐庐","ancient":"","spot":"","en":"Tonglu","enModern":"Tonglu","enAncient":"","enSpot":""},"lat":29.7989,"lng":119.6981,"region":"CN330122","label":"1161年","y0":1161,"y1":1161,"age":"50","works":2,"events":["去国回乡，过桐庐，游严陵钓台。"],"poems":[{"id":542152,"title":"钓台","date":"1161年","excerpt":"汉高嫚骂四皓隐，周武干戈伯夷饿。南阳故人幸无失，先生胡为亦高卧。"},{"id":542153,"title":"严州龙门院满散天申节","date":"1161年","excerpt":"棹弭龙门下，诚驰天阙边。平生畎亩意，祝圣更惓惓。"}],"notes":["原作儒，据四库本改"]},{"place":{"zh":"永康","modern":"永康","ancient":"","spot":"","en":"Yongkang","enModern":"Yongkang","enAncient":"","enSpot":""},"lat":28.8942,"lng":120.0539,"region":"CN330784","label":"1161年","y0":1161,"y1":1161,"age":"50","works":1,"events":["去国回乡，过永康。"],"poems":[{"id":542154,"title":"宿永康县黄塘店观稼有感","date":"1161年","excerpt":"路入黄塘喜更疑，地名虽是里闾非⑴。眼中禾稼已如许，薄有田园宜早归。"}],"notes":[]},{"place":{"zh":"丽水石门洞","modern":"丽水石门洞","ancient":"","spot":"","en":"Lishuishimendong","enModern":"Lishuishimendong","enAncient":"","enSpot":""},"lat":28.473,"lng":119.9295,"region":"CN3311","label":"1161年","y0":1161,"y1":1161,"age":"50","works":1,"events":["去国回乡，经婺州、缙云、处州到青田，游石门洞。"],"poems":[{"id":542157,"title":"游石门洞","date":"1161年","excerpt":"雁山饱见两龙湫，洗眼新观石洞流。欲向故乡寻白鹿，先来仙隐访青牛。"}],"notes":["自注：青牛道士隐于石门。"]},{"place":{"zh":"温州","modern":"温州","ancient":"","spot":"","en":"Wenzhou","enModern":"Wenzhou","enAncient":"","enSpot":""},"lat":28.0011,"lng":120.7059,"region":"CN3303","label":"1161年","y0":1161,"y1":1161,"age":"50","works":0,"events":["去国回乡，旧友林明仲迎接十朋至温州城西林明仲别院，留居一个月。"],"poems":[],"notes":[]},{"place":{"zh":"乐清","modern":"乐清","ancient":"","spot":"","en":"Yueqing","enModern":"Yueqing","enAncient":"","enSpot":""},"lat":28.119,"lng":120.9899,"region":"CN330382","label":"1161年八月 - 1162年六月","y0":1161,"y1":1162,"age":"50-51","works":0,"events":["抵家，上书请辞。"],"poems":[],"notes":[]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1162年十月 - 1163年六月十九日","y0":1162,"y1":1163,"age":"51-52","works":4,"events":["九月离家赴临安，十月到达。除任司封员外郎兼国史院编修崇政殿说书。","应诏上书，作品：《应诏陈弊事》。"],"poems":[{"id":1249871,"title":"除知湖州上殿劄子 其二","date":"1162年十月","excerpt":""},{"id":542264,"title":"宿学呈同官","date":"1162年","excerpt":"不听梧桐雨，回头已六年。齑盐谙旧味，灯火结前缘。"},{"id":1249849,"title":"应诏陈弊事","date":"1162年","excerpt":""},{"id":542275,"title":"用登和乐楼韵酬胡邦衡送别兼简刘韶美秘监","date":"1163年六月十九日","excerpt":"未访鄱阳范与颜，雁山深处且投閒。紫泥长记曾同召，丹陛何繇更对班。"}],"notes":["时为司业，宿学私试","自注：颜鲁公范文正公俱守鄱阳。"]},{"place":{"zh":"金华金华双溪楼","modern":"金华金华双溪楼","ancient":"","spot":"","en":"Jinhuajinhuashuangxilou","enModern":"Jinhuajinhuashuangxilou","enAncient":"","enSpot":""},"lat":29.0845,"lng":119.654,"region":"CN3307","label":"1163年","y0":1163,"y1":1163,"age":"52","works":1,"events":["返乡经桐庐重游钓台，与同年及同乡会饮双溪楼。"],"poems":[{"id":542279,"title":"过婺女同年王节推黄教授乡人华主簿会饮双溪楼","date":"1163年","excerpt":"年时尝泛婺溪舟，未上清风八咏楼。天为故人偿夙愿⑴，水知吾辈喜清流。"}],"notes":["夷仲","万顷"]},{"place":{"zh":"丽水","modern":"丽水","ancient":"","spot":"","en":"Lishui","enModern":"Lishui","enAncient":"","enSpot":""},"lat":28.473,"lng":119.9295,"region":"CN3311","label":"1163年","y0":1163,"y1":1163,"age":"52","works":3,"events":["返乡游缙云仙都。","返乡途中，重游石门洞，作品：《重游石门洞 其一》。"],"poems":[],"notes":[]},{"place":{"zh":"乐清","modern":"乐清","ancient":"","spot":"","en":"Yueqing","enModern":"Yueqing","enAncient":"","enSpot":""},"lat":28.119,"lng":120.9899,"region":"CN330382","label":"1163年 - 1164年五月","y0":1163,"y1":1164,"age":"52-53","works":2,"events":["回到乐清左原，遇旱灾。"],"poems":[],"notes":[]},{"place":{"zh":"鄱阳","modern":"鄱阳","ancient":"","spot":"","en":"Poyang","enModern":"Poyang","enAncient":"","enSpot":""},"lat":29.0113,"lng":116.71,"region":"CN361128","label":"1164年七月 - 1165年七月","y0":1164,"y1":1165,"age":"53-54","works":3,"events":["饶州任职。","饶州任职，修建颜鲁公、范文正祠，作品：《追和范文正公鄱阳诗 郡斋即事》。"],"poems":[{"id":1249892,"title":"饶州到任谢表","date":"1164年七月","excerpt":""},{"id":542358,"title":"追和范文正公鄱阳诗 郡斋即事","date":"1164年","excerpt":"理郡端如理乱丝，范公往矣欲谁师。典刑犹有堂中像，光艳长存壁上诗。"},{"id":542490,"title":"同官酌别","date":"1165年七月","excerpt":"无德于民愧寇恂，断桥留我荷鄱人。同僚送别四十里，满酌不辞三数巡。"}],"notes":["中谢。"]},{"place":{"zh":"九江庐山","modern":"九江庐山","ancient":"","spot":"","en":"Jiujianglushan","enModern":"Jiujianglushan","enAncient":"","enSpot":""},"lat":29.7113,"lng":116.008,"region":"CN3604","label":"1165年","y0":1165,"y1":1165,"age":"54","works":1,"events":["自饶州卸任,从间道去往夔州，逗留庐山，乞辞不允，作品：《庐山纪游四十韵》。"],"poems":[{"id":542542,"title":"庐山纪游四十韵","date":"1165年","excerpt":"我性好山水，思向庐山庐。五老招我游，有约芝山初。"}],"notes":["自注：天池最高不及游。","自注：寺有至乐亭。"]},{"place":{"zh":"奉节","modern":"奉节","ancient":"","spot":"","en":"Fengjie","enModern":"Fengjie","enAncient":"","enSpot":""},"lat":31.0246,"lng":109.4705,"region":"CN500236","label":"1165年十一月 - 1167年七月","y0":1165,"y1":1167,"age":"54-56","works":10,"events":["抵达夔州，出任知州。"],"poems":[{"id":1249893,"title":"夔州到任谢表","date":"1165年十一月","excerpt":""},{"id":1249868,"title":"夔州论马纲状","date":"1165年","excerpt":""},{"id":542694,"title":"闻诗得男名之曰夔","date":"1165年十二月十九日","excerpt":"巫邑初传鲤，吾家遂得夔。遥来如马地，却应梦熊诗⑴。"},{"id":542663,"title":"周漕行可和诗复用前韵并简元章","date":"1166年","excerpt":"重闻鸣凤瑞岐阳，不比清斋老太常。帝里别离头并白，夔门邂逅日初长。"},{"id":542666,"title":"又酬元章","date":"1166年","excerpt":"叱驭西来愧子阳，旧交重见白眉常。伤心鬼录人何短，回首蓬山话更长。"},{"id":542664,"title":"又用行可韵","date":"1166年","excerpt":"二公海内姓名闻，我亦追随到蜀门。龙卧庐中叹诸葛，蛙居坎底陋公孙。"},{"id":542721,"title":"次韵韶美失舟闵书","date":"1166年","excerpt":"医师笼参朮，良将枕戈矢。儒生嗜底物，书卷挂口齿。"},{"id":542719,"title":"夜与韶美饮酒瑞白堂秉烛观跳珠，分韵得跳字","date":"1166年","excerpt":"五月峡中天气歊，竹筒引水那能浇。江濆龙老卧未起，崖石不枯珠自跳。"}],"notes":["中谢。","自注：是日巫山送双鲤。"]},{"place":{"zh":"岳阳岳阳楼","modern":"岳阳岳阳楼","ancient":"","spot":"","en":"Yueyangyueyanglou","enModern":"Yueyangyueyanglou","enAncient":"","enSpot":""},"lat":29.3633,"lng":113.1357,"region":"CN4306","label":"1167年七月","y0":1167,"y1":1167,"age":"56","works":1,"events":["从夔州改知湖州,过洞庭湖，登岳阳楼。"],"poems":[{"id":211904,"title":"岳阳楼","date":"1167年七月","excerpt":"后乐先忧记饱观，兹楼今始得凭栏。吐吞五水波涛阔，出纳三光境界宽。"}],"notes":["四库本作宇"]},{"place":{"zh":"武汉黄鹤楼","modern":"武汉黄鹤楼","ancient":"","spot":"","en":"Wuhanhuanghelou","enModern":"Wuhanhuanghelou","enAncient":"","enSpot":""},"lat":30.5984,"lng":114.3118,"region":"CN4201","label":"1167年七月","y0":1167,"y1":1167,"age":"56","works":1,"events":["从夔州改知湖州,过汉口登黄鹤楼。"],"poems":[{"id":543006,"title":"黄鹤楼","date":"1167年七月","excerpt":"云锁吕公洞，月明黄鹤楼。抱关非故卒，谁见羽衣游。"}],"notes":[]},{"place":{"zh":"黄冈东坡","modern":"黄冈东坡","ancient":"","spot":"","en":"Huanggangdongpo","enModern":"Huanggangdongpo","enAncient":"","enSpot":""},"lat":30.4594,"lng":114.8789,"region":"CN4211","label":"1167年","y0":1167,"y1":1167,"age":"56","works":11,"events":["从夔州改知湖州,过黄州游东坡。"],"poems":[{"id":543009,"title":"游东坡十一绝 其一","date":"1167年","excerpt":"道大才高世不容，堪嗟尺水困神龙。空游赤壁英姿发，却向小桥诗思浓。"}],"notes":["自注：忠州东坡以乐天得名。","一作欺"]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1167年九月","y0":1167,"y1":1167,"age":"56","works":3,"events":["抵达临安，孝宗召见，上书。"],"poems":[{"id":1249870,"title":"除知湖州上殿劄子 其一","date":"1167年九月","excerpt":""}],"notes":[]},{"place":{"zh":"湖州","modern":"湖州","ancient":"","spot":"","en":"Huzhou","enModern":"Huzhou","enAncient":"","enSpot":""},"lat":30.899,"lng":120.0946,"region":"CN3305","label":"1167年九月 - 1168年","y0":1167,"y1":1168,"age":"56-57","works":4,"events":["湖州到任，重刊戒石于府署。"],"poems":[{"id":543096,"title":"重刊戒石铭 其一","date":"1167年九月","excerpt":"戒石重刊照眼明，良辰又遇腊嘉平。黄堂坐处天威近，一点欺心事莫萌。"},{"id":543089,"title":"贡院上梁","date":"1167年七月","excerpt":"清绝湖山映白蘋，翚飞梁栋眼中新。雪花先作晓来瑞，桂魄正圆天上轮。"},{"id":543120,"title":"郡僚展饯席上赋诗","date":"1168年","excerpt":"五年三郡厌驱驰，圣主隆恩许奉祠。孤屿众山重对酒⑴，清风明月欠吟诗⑵。"}],"notes":["自注：夔州以腊日修戒石"]},{"place":{"zh":"乐清","modern":"乐清","ancient":"","spot":"","en":"Yueqing","enModern":"Yueqing","enAncient":"","enSpot":""},"lat":28.119,"lng":120.9899,"region":"CN330382","label":"1168年六月 - 1168年八月","y0":1168,"y1":1168,"age":"57","works":1,"events":["回到家乡左原。"],"poems":[],"notes":[]},{"place":{"zh":"瑞安","modern":"瑞安","ancient":"","spot":"","en":"Ruian","enModern":"Ruian","enAncient":"","enSpot":""},"lat":27.784,"lng":120.6618,"region":"CN330381","label":"1168年","y0":1168,"y1":1168,"age":"57","works":1,"events":["赴泉州，途经瑞安，好友相邀，留宿一夜。"],"poems":[{"id":543145,"title":"过瑞安","date":"1168年","excerpt":"我家古乐成，老未识安固。偶把清源麾，首问南塘路。"}],"notes":["自注：子猷。","自注：敦谟。"]},{"place":{"zh":"福州","modern":"福州","ancient":"","spot":"","en":"Fuzhou","enModern":"Fuzhou","enAncient":"","enSpot":""},"lat":26.0804,"lng":119.3029,"region":"CN3501","label":"1168年","y0":1168,"y1":1168,"age":"57","works":0,"events":["何逢源卒于官，前往悼念。"],"poems":[],"notes":[]},{"place":{"zh":"泉州","modern":"泉州","ancient":"","spot":"","en":"Quanzhou","enModern":"Quanzhou","enAncient":"","enSpot":""},"lat":24.8802,"lng":118.6823,"region":"CN3505","label":"1168年十月 - 1170年","y0":1168,"y1":1170,"age":"57-59","works":7,"events":["到任泉州。"],"poems":[{"id":543163,"title":"宴七邑宰","date":"1168年十月","excerpt":"九重宵旰爱民深，令尹宜怀抚字心。今日黄堂一杯酒，殷勤端为庆民斟。"},{"id":543248,"title":"修戒石","date":"1168年","excerpt":"君以民脂膏，禄尔大夫士。脂膏饱其腹，曾不念赤子。"},{"id":543167,"title":"哭令人","date":"1168年十二月","excerpt":"三十年间共苦辛，忽然惊断梦中因。钟情正是我辈事，鼓缶忍同方外人。"},{"id":543270,"title":"韩魏公生于泉南州宅故未有祠于典为阙郡圃有庵名大隐即之以祠八月戊子率同僚祀之","date":"1169年八月","excerpt":"天开我宋太平基，紫府真人下应期。河朔魁梧出真相，泉南葱郁产奇儿。"},{"id":543310,"title":"悼张舍人安国","date":"1169年","excerpt":"天上张才子，少年观国光。高名一枝桂，遗爱六州棠。"},{"id":543326,"title":"十月二十日买菊一株颇佳置于郡斋松竹之间目为岁寒三友","date":"1169年十月","excerpt":"三百青钱一株菊，移置窗前伴松竹。鲜鲜正色傲霜性，不逐重阳上醽醁。"},{"id":543367,"title":"闻胡邦衡改知泉州复用前韵","date":"1170年","excerpt":"上念温陵为择人，知公名节世无邻。犯颜合在论思地，起废聊为岳牧臣。"}],"notes":["雍正本、光绪本作恣"]},{"place":{"zh":"乐清","modern":"乐清","ancient":"","spot":"","en":"Yueqing","enModern":"Yueqing","enAncient":"","enSpot":""},"lat":28.119,"lng":120.9899,"region":"CN330382","label":"1170年","y0":1170,"y1":1170,"age":"59","works":0,"events":["得旨提举太平兴国公。"],"poems":[],"notes":[]},{"place":{"zh":"杭州","modern":"杭州","ancient":"","spot":"","en":"Hangzhou","enModern":"Hangzhou","enAncient":"","enSpot":""},"lat":30.2801,"lng":120.1617,"region":"CN3301","label":"1171年三月 - 1171年","y0":1171,"y1":1171,"age":"60","works":4,"events":["任太子詹事。殿上陛对。"],"poems":[{"id":1249873,"title":"除太子詹事上殿劄子 其一","date":"1171年三月","excerpt":""},{"id":1249934,"title":"与张佐司","date":"1171年","excerpt":""}],"notes":[]},{"place":{"zh":"乐清","modern":"乐清","ancient":"","spot":"","en":"Yueqing","enModern":"Yueqing","enAncient":"","enSpot":""},"lat":28.119,"lng":120.9899,"region":"CN330382","label":"1171年七月 - 1171年十二月","y0":1171,"y1":1171,"age":"60","works":0,"events":["诏以龙图学士致仕,命下而卒。","葬于乐清左原白岩。"],"poems":[],"notes":[]}],"stages":[{"from":1,"to":13,"title":{"zh":"温州、乐清、天台等地","en":"Wenzhou, Yueqing, Tiantai"},"main":"温州","y0":1137,"y1":1149,"events":["在温州江心寺学习，为江心寺钻鞋乐“云潮”名联。","读书于鹿岩书院，从潘翼先生学，作品：《寄僧觉无象》。","居乡，作品：《毛虞卿见过》。","赴补太学。","赴补太学，过黄岩，作品：《宿黄岩妙智院》。","赴补太学，作品：《宿庆善寺》。"]},{"from":14,"to":38,"title":{"zh":"杭州、乐清、绍兴等地","en":"Hangzhou, Yueqing, Shaoxing"},"main":"杭州","y0":1150,"y1":1164,"events":["升上舍。","母病，归乡。","第五次赴太学，升上舍。","为万中祖母墓前亭作文，作品：《追远亭记》。","居母丧，结庐讲学。","赴太学。"]},{"from":39,"to":40,"title":{"zh":"鄱阳、九江庐山","en":"Poyang, Jiujianglushan"},"main":"鄱阳","y0":1164,"y1":1165,"events":["饶州任职。","饶州任职，修建颜鲁公、范文正祠，作品：《追和范文正公鄱阳诗 郡斋即事》。","自饶州卸任,从间道去往夔州，逗留庐山，乞辞不允，作品：《庐山纪游四十韵》。"]},{"from":41,"to":42,"title":{"zh":"奉节、岳阳岳阳楼","en":"Fengjie, Yueyangyueyanglou"},"main":"奉节","y0":1165,"y1":1167,"events":["抵达夔州，出任知州。","从夔州改知湖州,过洞庭湖，登岳阳楼。"]},{"from":43,"to":44,"title":{"zh":"武汉黄鹤楼、黄冈东坡","en":"Wuhanhuanghelou, Huanggangdongpo"},"main":"武汉黄鹤楼","y0":1167,"y1":1167,"events":["从夔州改知湖州,过汉口登黄鹤楼。","从夔州改知湖州,过黄州游东坡。"]},{"from":45,"to
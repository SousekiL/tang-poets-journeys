7022,"region":"CN361127","label":"759年","y0":759,"y1":759,"age":"42","works":2,"events":["春日，贬谪南巴。赴南昌，寓居余干。有诗，作品：《负谪后登干越亭作》《登馀干古县城》。"],"poems":[{"id":16268,"title":"负谪后登干越亭作","date":"759年","excerpt":"天南愁望绝，亭上柳条新。落日独归鸟，孤舟何处人。"},{"id":16225,"title":"登馀干古县城","date":"759年","excerpt":"孤城上与白云齐，万古荒凉楚水西。官舍已空秋草绿，女墙犹在夜乌啼。"}],"notes":["一作南天","一作岭"]},{"place":{"zh":"鄱阳李嘉祐江亭","modern":"鄱阳李嘉祐江亭","ancient":"","spot":"","en":"Poyanglijiayoujiangting","enModern":"Poyanglijiayoujiangting","enAncient":"","enSpot":""},"lat":29.0113,"lng":116.71,"region":"CN361128","label":"759年","y0":759,"y1":759,"age":"42","works":1,"events":["秋日，谪南巴，途至鄱阳，有诗。"],"poems":[{"id":16269,"title":"初贬南巴至鄱阳题李嘉祐江亭","date":"759年","excerpt":"巴峤南行远，长江万里随。不才甘谪去，流水亦何之。"}],"notes":["一作南出巴人峤","一作知"]},{"place":{"zh":"长沙","modern":"长沙","ancient":"","spot":"","en":"Changsha","enModern":"Changsha","enAncient":"","enSpot":""},"lat":28.2518,"lng":113.0875,"region":"CN430121","label":"759年","y0":759,"y1":759,"age":"42","works":1,"events":["谪南巴，至长沙。观贾谊宅，有诗，作品：《长沙过贾谊宅》。"],"poems":[{"id":16018,"title":"长沙过贾谊宅","date":"759年","excerpt":"三年谪宦此栖迟，万古惟留楚客悲。秋草独寻人去后，寒林空见日斜时。"}],"notes":["一作国","一作渐"]},{"place":{"zh":"电白（南巴）","modern":"电白","ancient":"南巴","spot":"","en":"Nanba (Dianbai)","enModern":"Dianbai","enAncient":"Nanba","enSpot":""},"lat":21.685,"lng":111.2406,"region":"CN440904","label":"760年","y0":760,"y1":760,"age":"43","works":0,"events":["在南巴。"],"poems":[],"notes":[]},{"place":{"zh":"余干","modern":"余干","ancient":"","spot":"","en":"Yugan","enModern":"Yugan","enAncient":"","enSpot":""},"lat":28.7078,"lng":116.7022,"region":"CN361127","label":"761年","y0":761,"y1":761,"age":"44","works":1,"events":["春，获赦北归，居余干，夜宴有诗作。"],"poems":[],"notes":[]},{"place":{"zh":"苏州前溪馆","modern":"苏州前溪馆","ancient":"","spot":"","en":"Suzhouqianxiguan","enModern":"Suzhouqianxiguan","enAncient":"","enSpot":""},"lat":31.3046,"lng":120.5896,"region":"CN3205","label":"761年","y0":761,"y1":761,"age":"44","works":1,"events":["秋，赴苏州重推.次前溪馆，有诗。"],"poems":[],"notes"